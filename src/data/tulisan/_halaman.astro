---
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import RelatedContent from "../../components/RelatedContent.astro";

const {
  title,
  description,
  category,
  world,
  edition = "001",
  node,
  archive,
  image = "/images/hero/default.png",
  heroCaption = "",
  slug,
  readingTime = "5 menit membaca"
} = Astro.props;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon-rakan.png" />
  <title>{title} | RAKAN</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | RAKAN`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={`https://rakan.my.id/tulisan/${slug}`} />
</head>
<body>
  <Nav />

  <main class="article">
    <div class="category">{category}</div>

    <h1>{title}</h1>

    <p class="intro">{description}</p>

    <div class="meta">Catatan Rakan · {category} · {readingTime}</div>

    <div class="hero">
      <img src={image} alt={title} />
      <div class="hero-caption">{heroCaption}</div>
    </div>

    <div class="content">
      <slot />

      <section class="personal">
        <div class="personal-label">Catatan RAKAN</div>
        <p>
          Memahami manusia sering kali dimulai dengan melihat hubungan antara tubuh,
          otak, pikiran, dan kehidupan sebagai satu kesatuan.
        </p>
      </section>

      <section class="personal">
        <div class="personal-label">Lanjutkan Perjalanan</div>
        <p>
          Jika tulisan ini membuka pertanyaan baru, Anda dapat melanjutkan perjalanan
          melalui tulisan lain, buku, layanan, atau ruang kolaborasi RAKAN.
        </p>
        <p class="cta-links">
          <a href="/tulisan">Jelajahi Tulisan</a> ·
          <a href="/buku">Lihat Buku</a> ·
          <a href="/kolaborasi">Kolaborasi</a>
        </p>
      </section>

      <section class="closing">
        <p>Memahami adalah langkah awal untuk merawat sesuatu dengan lebih utuh.</p>
        <div class="signature">
          Abdul Rakan · Apoteker & Praktisi Penyembuhan Holistik
          <br />
          Arsip RAKAN · {archive}
        </div>
      </section>
    </div>

    <RelatedContent currentHref={`/tulisan/${slug}`} currentCategory={category} />
  </main>

  <Footer />
</body>
</html>

<style>
:global(*){box-sizing:border-box;}
:global(html){overflow-x:hidden;scroll-behavior:smooth;}
:global(body){margin:0;overflow-x:hidden;background:#F7F4EE;color:#29251F;font-family:Arial,Helvetica,sans-serif;}
.article{max-width:1000px;margin:auto;padding:100px 32px;}
.category{color:#81776A;font-size:12px;letter-spacing:.14em;text-transform:uppercase;}
h1,h2{margin:0;font-family:Georgia,serif;font-weight:400;}
h1{max-width:860px;margin:25px 0;font-size:clamp(46px,7vw,78px);line-height:1;letter-spacing:-.04em;}
.intro{max-width:720px;margin:0 0 35px;color:#625B52;font-family:Georgia,serif;font-size:clamp(20px,3vw,27px);line-height:1.55;}
.meta{color:#81776A;font-size:14px;}
.hero{margin:70px 0 100px;}
.hero img{display:block;width:100%;height:auto;border-radius:2px;}
.hero-caption{margin-top:12px;color:#93897B;font-size:12px;line-height:1.5;}
.content{max-width:720px;margin:auto;}
.content section{margin-bottom:75px;}
h2{margin-bottom:25px;font-size:clamp(30px,4vw,46px);line-height:1.1;}
p{color:#514C45;font-size:18px;line-height:1.9;}
.personal{margin-top:90px;padding-top:55px;border-top:1px solid #DCD5CA;}
.personal-label{margin-bottom:25px;color:#81776A;font-size:12px;letter-spacing:.14em;text-transform:uppercase;}
.closing{margin-top:100px;padding-top:45px;border-top:1px solid #DCD5CA;}
.closing p{font-family:Georgia,serif;font-size:28px;line-height:1.5;}
.signature{margin-top:35px;color:#81776A;font-size:14px;line-height:1.7;}
.cta-links a{color:#7A2635;text-decoration:none;}
.cta-links a:hover{text-decoration:underline;}
@media(max-width:700px){.article{padding:65px 22px 80px}.hero{margin:50px 0 70px}p{font-size:17px;line-height:1.85}}
</style>

