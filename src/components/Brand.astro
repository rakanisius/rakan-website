---
interface Props {
  size?: number;
}

const { size = 120 } = Astro.props;
---

<a href="/" class="brand" style={`font-size:${size}px;`}>
  Rakan
</a>

<style>
.brand{
  display:inline-block;
  text-decoration:none;
  color:#8A1D35;
  font-family:Georgia,"Times New Roman",serif;
  font-weight:400;
  line-height:1;
  letter-spacing:-0.04em;
  transition:opacity .2s;
}

.brand:hover{
  opacity:.85;
}
</style>