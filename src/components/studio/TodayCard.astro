---
import { articles } from "../../data/manifest";

const latest = [...articles].sort((a, b) => b.number - a.number)[0];
---

<box gap=3 padding=3 background=surface radius=xl border=1>
  <box gap=0>
    <title size=md>Terbaru</title>
    <caption>Artikel paling baru di perpustakaan.</caption>
  </box>

  {#if latest}
    <box gap=2 padding=3 background=surface-secondary radius=lg border=1>
      <box gap=1>
        <title size=sm>{latest.title}</title>
        <caption>{latest.world} · Edition {latest.edition}</caption>
      </box>

      <text size=sm>{latest.description}</text>

      <row justify=between align=center>
        <caption>{latest.archive}</caption>
        <text size=sm color=info>Lihat →</text>
      </row>
    </box>
  {/if}
</box>
