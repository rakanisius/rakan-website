---
const {
gap="lg"
}=Astro.props;
---

<div class:list={[
"studio-grid",
`gap-${gap}`
]}>

<slot/>

</div>

<style>

.studio-grid{

display:grid;

grid-template-columns:repeat(12,minmax(0,1fr));

}

.gap-sm{
gap:var(--space-3);
}

.gap-md{
gap:var(--space-4);
}

.gap-lg{
gap:var(--space-5);
}

@media(max-width:900px){

.studio-grid{

grid-template-columns:repeat(6,minmax(0,1fr));

}

}

@media(max-width:640px){

.studio-grid{

grid-template-columns:1fr;

}

}

</style>