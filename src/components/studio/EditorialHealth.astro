---
import { articles } from "../../data/manifest";

const total = articles.length;

const worlds = [...new Set(articles.map((a) => a.world))].length;

const editions = [...new Set(articles.map((a) => a.edition))].length;
---

<box gap=3 padding=3 background=surface radius=xl border=1>
  <box gap=0>
    <title size=md>Editorial Health</title>
    <caption>Kesehatan perpustakaan RAKAN.</caption>
  </box>

  <grid columns=3>
    <grid-item>
      <box gap=1 align=center background=surface-secondary radius=lg padding=3>
        <title size=lg>{total}</title>
        <caption>Artikel</caption>
      </box>
    </grid-item>

    <grid-item>
      <box gap=1 align=center background=surface-secondary radius=lg padding=3>
        <title size=lg>{worlds}</title>
        <caption>World</caption>
      </box>
    </grid-item>

    <grid-item>
      <box gap=1 align=center background=surface-secondary radius=lg padding=3>
        <title size=lg>{editions}</title>
        <caption>Edition</caption>
      </box>
    </grid-item>
  </grid>
</box>
