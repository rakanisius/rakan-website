---
import { getCollection } from "astro:content";

const articles = await getCollection("articles");

const total = articles.length;

const drafts = articles.filter(a => a.data.status === "Draft");

const publishReady = articles.filter(a =>
  a.data.status === "Final" &&
  a.data.excerpt &&
  a.data.readingTime &&
  a.data.kategori
);

const missingExcerpt = articles.filter(a => !a.data.excerpt);

const featured = articles.filter(a => a.data.featured);

const priorities = [
  ...missingExcerpt.map(a => ({
    icon: "✍️",
    text: `Lengkapi excerpt: ${a.data.title}`,
    link: `/studio/writing/${a.id}`
  })),
  ...articles
    .filter(a => !a.data.featured)
    .slice(0,2)
    .map(a => ({
      icon: "⭐",
      text: `Pilih featured: ${a.data.title}`,
      link: `/studio/writing/${a.id}`
    })),
  ...publishReady
    .slice(0,2)
    .map(a => ({
      icon: "🚀",
      text: `Siap publish: ${a.data.title}`,
      link: `/studio/writing/${a.id}`
    }))
].slice(0,5);
---

<section class="health">

<div class="top">

<h2>Editorial Health</h2>

<p>Kondisi ruang redaksi hari ini.</p>

</div>

<div class="stats">

<div class="stat">
<span>Total</span>
<strong>{total}</strong>
</div>

<div class="stat">
<span>Draft</span>
<strong>{drafts.length}</strong>
</div>

<div class="stat">
<span>Siap Publish</span>
<strong>{publishReady.length}</strong>
</div>

<div class="stat">
<span>Perlu Excerpt</span>
<strong>{missingExcerpt.length}</strong>
</div>

<div class="stat">
<span>Featured</span>
<strong>{featured.length}</strong>
</div>

</div>

<div class="divider"></div>

<div class="tasks">

<h3>Prioritas Hari Ini</h3>

{
priorities.length === 0 ? (

<p class="empty">
Semua artikel dalam kondisi sehat.
</p>

) : (

<ul>

{
priorities.map(task => (

<li>

<a href={task.link}>

<span>{task.icon}</span>

{task.text}

</a>

</li>

))
}

</ul>

)
}

</div>

</section>

<style>
.health{
background:white;
border:1px solid #DED6CA;
border-radius:24px;
padding:32px;
margin:32px 0;
}

.top h2{
margin:0;
font-family:Georgia,serif;
font-size:34px;
font-weight:400;
}

.top p{
margin:10px 0 0;
color:#6B645A;
}

.stats{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:14px;
margin-top:28px;
}

.stat{
background:#F7F4EE;
border-radius:16px;
padding:20px;
text-align:center;
}

.stat span{
display:block;
font-size:12px;
letter-spacing:.08em;
text-transform:uppercase;
color:#6B645A;
margin-bottom:8px;
}

.stat strong{
font-size:36px;
font-family:Georgia,serif;
font-weight:400;
}

.divider{
height:1px;
background:#ECE5DA;
margin:30px 0;
}

.tasks h3{
margin:0 0 18px;
font-family:Georgia,serif;
font-size:24px;
font-weight:400;
}

.tasks ul{
list-style:none;
padding:0;
margin:0;
display:flex;
flex-direction:column;
gap:10px;
}

.tasks li a{
display:flex;
gap:12px;
align-items:center;
padding:16px;
border-radius:14px;
background:#F7F4EE;
text-decoration:none;
color:inherit;
transition:.18s;
}

.tasks li a:hover{
background:#EFE8DD;
}

.empty{
color:#6B645A;
}

@media(max-width:860px){

.stats{
grid-template-columns:repeat(2,1fr);
}

}

@media(max-width:520px){

.stats{
grid-template-columns:1fr;
}

}
</style>