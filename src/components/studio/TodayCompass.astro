---import fs from "node:fs";import path from "node:path";const booksRoot = path.join(process.cwd(), "os", "books");let activeBook = "Belum ada proyek buku.";try {  if (fs.existsSync(booksRoot)) {    const folders = fs.readdirSync(booksRoot);    for (const folder of folders) {      const projectPath = path.join(booksRoot, folder, "project.json");      if (fs.existsSync(projectPath)) {        const raw = fs.readFileSync(projectPath, "utf8");        const data = JSON.parse(raw);        activeBook = `${data.title} (${data.progress}%)`;        break;      }    }  }} catch (err) {  console.error(err);}---<div class="compass">  <h3>Kompas Hari Ini</h3>  <ul>    <li>✍️ Lanjutkan draft terbaru.</li>    <li>📚 {activeBook}</li>    <li>🚀 Siapkan satu draft untuk publish.</li>  </ul></div><style>.compass {  background: white;  border: 1px solid #DED6CA;  border-radius: 18px;  padding: 24px;  margin-top: 24px;}.compass h3 {  margin-top: 0;  font-family: Georgia, serif;  font-weight: 400;}.compass ul {  padding-left: 20px;  line-height: 2;  color: #514C45;}</style>