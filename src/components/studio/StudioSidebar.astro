---import { workflow } from "../../data/workflow";const current = Astro.url.pathname;---<aside class="sidebar">  <div class="brand">    <a href="/studio" class="logo">      RAKAN Studio    </a>    <p class="tagline">      Editorial Operating System    </p>  </div>  <nav class="nav">    <div class="group">      <div class="label">        Workspace      </div>      <a        href="/studio"        class:list={{ active: current === "/studio" }}      >        Dashboard      </a>      <a        href="/studio/compose"        class:list={{ active: current === "/studio/compose" }}      >        Compose      </a>      <a        href="/studio/writing"        class:list={{          active:            current === "/studio/writing" ||            current.startsWith("/studio/writing/")        }}      >        Writing      </a>      <a        href="/studio/books"        class:list={{ active: current === "/studio/books" }}      >        Book Studio      </a>      <a        href="/studio/capture"        class:list={{ active: current === "/studio/capture" }}      >        Capture      </a>    </div>    <div class="group">      <div class="label">        Workflow      </div>      {workflow.map((item) => (        <a          href={item.href}          class:list={{            active:              current === item.href ||              (item.id === "draft" && current.startsWith("/studio/writing"))          }}        >          <span class="icon">{item.icon}</span>          <span>{item.title}</span>        </a>      ))}    </div>    <div class="group">      <div class="label">        Publish      </div>      <a        href="/studio/publish"        class:list={{ active: current === "/studio/publish" }}      >        Publish      </a>    </div>  </nav></aside><style>.sidebar{display:flex;flex-direction:column;padding:36px 24px;background:#F1ECE5;border-right:1px solid #E5DFD5;height:100%;position:sticky;top:0;}.brand{margin-bottom:38px;}.logo{display:block;text-decoration:none;color:#201D19;font-family:Georgia,serif;font-size:28px;line-height:1.1;}.tagline{margin:10px 0 0;color:#756653;font-size:14px;line-height:1.6;}.nav{display:flex;flex-direction:column;gap:30px;}.group{display:flex;flex-direction:column;gap:8px;}.label{margin-bottom:6px;color:#7A2635;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;}.group a{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:14px;text-decoration:none;color:#3E3933;transition:.2s;}.group a:hover{background:#E8DFD5;}.group a.active{background:#7A2635;color:white;}.icon{width:20px;text-align:center;}@media(max-width:960px){.sidebar{position:static;height:auto;padding:24px 20px;border-right:none;border-bottom:1px solid #E5DFD5;}.nav{gap:22px;}}</style>
