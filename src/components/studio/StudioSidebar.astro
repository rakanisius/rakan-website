---const current = Astro.url.pathname;const items = [  { href: "/studio", label: "Today", icon: "home" },  { href: "/studio/writing", label: "Menulis", icon: "pen" },  { href: "/studio/capture", label: "Capture", icon: "sparkles" },  { href: "/studio/books", label: "Books", icon: "book" },  { href: "/studio/inbox", label: "Inbox", icon: "inbox" },  { href: "/studio/publish", label: "Publish", icon: "upload" }];---<aside class="sidebar">  <div class="brand">    <p class="eyebrow">RAKAN</p>    <h2>Studio</h2>  </div>  <nav>    {items.map((item) => (      <a        href={item.href}        class={current === item.href ? "active" : ""}      >        <icon name={item.icon} />        <span>{item.label}</span>      </a>    ))}  </nav>  <div class="footer">    <caption>Editorial Workspace</caption>  </div></aside><style>.sidebar{  display:flex;  flex-direction:column;  justify-content:space-between;  padding:28px 22px;  background:#FCFAF6;  border-right:1px solid #E7DFD3;  min-height:100vh;  position:sticky;  top:0;}.brand{  margin-bottom:32px;}.eyebrow{  margin:0;  font-size:12px;  letter-spacing:.12em;  text-transform:uppercase;  color:#7A2635;}h2{  margin:6px 0 0;  font-family:Georgia,serif;  font-weight:400;  font-size:32px;  color:#201D19;}nav{  display:flex;  flex-direction:column;  gap:6px;}nav a{  display:flex;  align-items:center;  gap:12px;  padding:12px 14px;  border-radius:14px;  text-decoration:none;  color:#514C45;  transition:.18s ease;}nav a:hover{  background:#F5F2EC;  color:#201D19;}nav a.active{  background:#7A2635;  color:white;}.footer{  margin-top:32px;}@media(max-width:900px){.sidebar{  position:static;  min-height:auto;  border-right:none;  border-bottom:1px solid #E7DFD3;}nav{  flex-direction:row;  overflow:auto;  gap:8px;}nav a{  white-space:nowrap;}}</style>