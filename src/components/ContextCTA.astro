---
const {
world="kehidupan"
}=Astro.props;

const messages={

kehidupan:"Perjalanan ini belum selesai. Anda bisa melanjutkan melalui tulisan lain, membaca buku yang sedang saya susun, atau membuka ruang kolaborasi bersama RAKAN.",

tubuh:"Memahami tubuh adalah proses. Anda bisa melanjutkan perjalanan melalui tulisan lain atau buku RAKAN.",

otak:"Jika topik ini membuat Anda ingin memahami otak lebih dalam, perjalanan berikutnya sudah menunggu.",

pikiran:"Perubahan sering dimulai dari pemahaman kecil yang dilakukan berulang."
};
---

<section class="context-cta">

<h2>
Jika tulisan ini membantu Anda memahami diri sedikit lebih baik…
</h2>

<p>{messages[world]}</p>

<div class="links">

<a href="/tulisan">Jelajahi Tulisan</a>

<a href="/buku">Lihat Buku</a>

<a href="/kolaborasi">Kolaborasi</a>

</div>

</section>

<style>
.context-cta{
max-width:760px;
margin:110px auto;
padding:42px;
background:#F2EEE6;
border-radius:10px;
}
.context-cta h2{
margin:0 0 18px;
font-family:Georgia,serif;
font-size:36px;
font-weight:400;
}
.context-cta p{
margin:0;
line-height:1.8;
}
.links{
display:flex;
gap:20px;
flex-wrap:wrap;
margin-top:30px;
}
.links a{
color:#7A2635;
text-decoration:none;
}
.links a:hover{
text-decoration:underline;
}
</style>
