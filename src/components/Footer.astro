---
import Brand from "./Brand.astro";
---

<footer class="footer">
  <div class="container">

    <div class="top">

      <div class="brand">
        <Brand variant="text" size={42} />

        <p class="tagline">
          Mendampingi manusia memahami dirinya secara utuh.
        </p>
      </div>

      <nav class="links">
        <a href="/tulisan">Tulisan</a>
        <a href="/buku">Buku</a>
        <a href="/layanan">Layanan</a>
        <a href="/kolaborasi">Kolaborasi</a>
        <a href="/kontak">Kontak</a>
      </nav>

    </div>

    <div class="bottom">
      <p>© 2026 RAKAN. Seluruh hak cipta dilindungi.</p>
    </div>

  </div>
</footer>

<style>

.footer{
  background:#2F2A26;
  color:#ECE6DC;
  padding:72px 0 36px;
}

.container{
  max-width:1180px;
  margin:auto;
  padding:0 32px;
}

.top{
  display:flex;
  justify-content:space-between;
  gap:48px;
  align-items:flex-start;
}

.brand{
  max-width:380px;
}

.tagline{
  margin-top:14px;
  color:#B8AEA2;
  font-size:15px;
  line-height:1.7;
}

.links{
  display:grid;
  gap:14px;
}

.links a{
  color:#ECE6DC;
  text-decoration:none;
  transition:.2s;
}

.links a:hover{
  color:#FFFFFF;
}

.bottom{
  margin-top:48px;
  padding-top:24px;
  border-top:1px solid rgba(255,255,255,.08);
}

.bottom p{
  margin:0;
  color:#9D9387;
  font-size:14px;
}

@media(max-width:800px){

.container{
  padding:0 20px;
}

.top{
  flex-direction:column;
}

}

@media(max-width:390px){

.container{
  padding:0 18px;
}

.footer{
  padding:56px 0 28px;
}

.tagline{
  font-size:14px;
}

}

</style>
