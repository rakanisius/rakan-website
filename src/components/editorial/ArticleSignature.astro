---
interface Props{
  author?:string;
  archive:string;
}

const{
  author="Abdul Rakan",
  archive
}=Astro.props;
---

<section class="signature-card">

  <div class="signature-divider"></div>

  <div class="signature-body">

    <h3>{author}</h3>

    <p class="role">
      Apoteker & Praktisi Penyembuhan Holistik
    </p>

    <p class="editorial-text">
      Di RAKAN.MY.ID, saya percaya perjalanan memahami diri sering dimulai dari
      peristiwa yang tampak biasa.
    </p>

    <p class="archive">
      Arsip RAKAN · {archive}
    </p>

  </div>

  <nav class="signature-nav">

    <a href="/tulisan">Perpustakaan</a>

    <a href="/buku">Buku</a>

    <a href="/layanan">Layanan</a>

  </nav>

</section>

<style>

.signature-card{

margin:6rem auto 0;

padding:2.6rem;

background:#F2ECE3;

border:1px solid #DDD3C7;

border-radius:26px;

box-shadow:0 10px 30px rgba(32,29,25,.04);

}

.signature-divider{

width:48px;

height:2px;

margin:0 auto 2rem;

background:#7A2635;

}

.signature-body{

text-align:center;

}

.signature-body h3{

margin:0 0 .35rem;

font-family:Georgia,serif;

font-size:2rem;

font-weight:400;

color:#201D19;

}

.role{

margin:0 0 1.4rem;

font-family:Arial,Helvetica,sans-serif;

font-size:.88rem;

letter-spacing:.05em;

text-transform:uppercase;

color:#756653;

}

.editorial-text{

max-width:480px;

margin:0 auto;

font-family:Georgia,serif;

font-size:1rem;

font-style:italic;

line-height:1.8;

color:#5C534B;

}

.archive{

margin-top:1.5rem;

font-family:Arial,Helvetica,sans-serif;

font-size:.72rem;

letter-spacing:.14em;

text-transform:uppercase;

color:#9A8D81;

}

.signature-nav{

display:flex;

justify-content:center;

gap:2rem;

margin-top:2rem;

padding-top:1.4rem;

border-top:1px solid #DDD3C7;

}

.signature-nav a{

position:relative;

font-family:Georgia,serif;

font-size:1rem;

text-decoration:none;

color:#201D19;

transition:.25s;

}

.signature-nav a::after{

content:"";

position:absolute;

left:0;

bottom:-4px;

width:0;

height:1px;

background:#7A2635;

transition:.25s;

}

.signature-nav a:hover{

color:#7A2635;

}

.signature-nav a:hover::after{

width:100%;

}

@media(max-width:640px){

.signature-card{

padding:2rem 1.5rem;

border-radius:20px;

}

.signature-nav{

flex-direction:column;

gap:1rem;

align-items:center;

}

.signature-body h3{

font-size:1.7rem;

}

}

</style>
