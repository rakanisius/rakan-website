---
import { worldStats } from "../data/knowledge";

const icons: Record<string,string> = {
  tubuh:"◉",
  otak:"◎",
  pikiran:"◌",
  kehidupan:"◇"
};
---

<section id="peta" class="peta">

<div class="header">

<p class="eyebrow">PETA RAKAN</p>

<h2>Perpustakaan yang saling terhubung.</h2>

<p class="lead">
Tulisan di RAKAN tidak berdiri sendiri. Setiap artikel menjadi bagian dari
Node, World, dan Edition yang saling terhubung menjadi satu peta pengetahuan.
</p>

</div>

<div class="preview">

<AsyncImage query="minimalist editorial four connected circles body brain mind life cream background maroon accent paper texture" aspectRatio="16:9"/>

</div>

<div class="grid">

{
worldStats.map((world)=>(

<a
href={`/tulisan/kategori/${world.slug}`}
class="card"
>

<div class="icon">{icons[world.slug]}</div>

<div class="meta">
{world.nodeCount} Node · {world.articleCount} tulisan
</div>

<h3>{world.title}</h3>

<p>{world.description}</p>

</a>

))
}

</div>

<div class="footer">

<a href="/tulisan/edition" class="button">
Jelajahi Edition →
</a>

</div>

</section>

<style>

.peta{
display:flex;
flex-direction:column;
gap:40px;
}

.header{
max-width:760px;
}

.eyebrow{
color:#7A2635;
font-size:12px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
margin:0 0 18px;
}

.header h2{
margin:0;
font-family:Georgia,serif;
font-weight:400;
font-size:clamp(36px,5vw,50px);
line-height:1.15;
color:#201D19;
}

.lead{
margin-top:20px;
color:#514C45;
line-height:1.8;
font-size:17px;
}

.preview{
overflow:hidden;
border-radius:24px;
border:1px solid #E5DFD5;
}

.grid{
display:grid;
grid-template-columns:repeat(2,minmax(0,1fr));
gap:24px;
}

.card{
display:flex;
flex-direction:column;
gap:14px;
padding:26px;
background:#F1ECE5;
border:1px solid #E5DFD5;
border-radius:24px;
text-decoration:none;
transition:.2s;
}

.card:hover{
transform:translateY(-2px);
border-color:#D8D0C5;
}

.icon{
font-size:28px;
color:#7A2635;
}

.meta{
font-size:13px;
letter-spacing:.04em;
text-transform:uppercase;
color:#7A2635;
}

.card h3{
margin:0;
font-family:Georgia,serif;
font-weight:400;
font-size:28px;
color:#201D19;
}

.card p{
margin:0;
color:#514C45;
line-height:1.8;
}

.footer{
display:flex;
justify-content:flex-start;
}

.button{
display:inline-flex;
align-items:center;
gap:8px;
padding:14px 22px;
border-radius:999px;
background:#7A2635;
color:white;
text-decoration:none;
}

@media(max-width:800px){

.grid{
grid-template-columns:1fr;
}

.card{
padding:22px;
}

}

</style>