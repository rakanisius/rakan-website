---
interface Props{
  node:string;
  archive:string;
}

const { node, archive } = Astro.props;
---

<section class="author">

  <div class="head">

    <div class="avatar">
      <img
        src="/images/abdul-rakan.jpg"
        alt="Abdul Rakan"
      />
    </div>

    <div class="info">
      <h3>Abdul Rakan</h3>
      <p>Apoteker & Praktisi Penyembuhan Holistik</p>
    </div>

  </div>

  <hr/>

  <p class="note">
    Sebagian tulisan di situs ini lahir dari pertanyaan-pertanyaan sederhana yang pelan-pelan mengubah cara saya memahami tubuh, pikiran, dan kehidupan.
  </p>

  <div class="archive">
    NODE {node} · ARSIP {archive}
  </div>

</section>

<style>

.author{
  max-width:750px;
  margin:100px auto 80px;
  padding:38px;
  border:1px solid #DDD3C5;
  border-radius:28px;
  background:#F7F4EE;
}

.head{
  display:flex;
  align-items:center;
  gap:22px;
}

.avatar{
  width:84px;
  height:84px;
  border-radius:50%;
  overflow:hidden;
  flex:none;
  background:#7A2635;
}

.avatar img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center 22%;
  display:block;
}

.info h3{
  margin:0;
  font-family:"Source Serif 4",serif;
  font-size:30px;
  font-weight:600;
  color:#29251F;
}

.info p{
  margin:6px 0 0;
  font-family:"Inter",sans-serif;
  font-size:18px;
  color:#5B544C;
}

hr{
  margin:28px 0;
  border:none;
  border-top:1px solid #DDD3C5;
}

.note{
  margin:0;
  font-family:"Source Serif 4",serif;
  font-size:21px;
  line-height:1.8;
  color:#433F38;
}

.archive{
  margin-top:22px;
  font-family:"Inter",sans-serif;
  font-size:14px;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:#8B6B2E;
}

@media(max-width:700px){

  .author{
    padding:26px;
  }

  .head{
    gap:18px;
  }

  .avatar{
    width:68px;
    height:68px;
  }

  .info h3{
    font-size:24px;
  }

  .info p{
    font-size:16px;
  }

  .note{
    font-size:19px;
    line-height:1.75;
  }

}

</style>
