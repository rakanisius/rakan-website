---
import { getRelated } from "../config/knowledge";

interface Props{
id:string;
}

const {id}=Astro.props;

const items=getRelated(id);
---

{items.length>0 && (

<section class="related">

<div class="eyebrow">
LANJUTKAN MEMBACA
</div>

<h2>
Masih ada percakapan yang berhubungan.
</h2>

<div class="cards">

{items.map(item=>(

<a href={item.url} class="card">

<div class="type">
{item.type.toUpperCase()}
</div>

<h3>{item.title}</h3>

<p>{item.description}</p>

</a>

))}

</div>

</section>

)}

<style>

.related{
margin:90px 0;
padding-top:70px;
border-top:1px solid #E5DFD5;
}

.eyebrow{
margin-bottom:18px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

.related h2{
margin:0 0 36px;
font-family:Georgia,serif;
font-size:clamp(34px,5vw,46px);
font-weight:400;
line-height:1.15;
}

.cards{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:1px;
background:#E5DFD5;
border:1px solid #E5DFD5;
}

.card{
background:#F7F4EE;
padding:30px;
text-decoration:none;
color:#201D19;
transition:.2s;
}

.card:hover{
background:#F1ECE5;
}

.type{
margin-bottom:14px;
font-size:10px;
letter-spacing:.14em;
color:#756D62;
}

.card h3{
margin:0;
font-family:Georgia,serif;
font-size:26px;
font-weight:400;
line-height:1.2;
}

.card p{
margin-top:16px;
color:#514C45;
font-size:15px;
line-height:1.75;
}

@media(max-width:800px){

.cards{
grid-template-columns:1fr;
}

.related{
margin:70px 0;
padding-top:50px;
}

.related h2{
font-size:32px;
}

}

</style>