---
import { articles } from "../data/articles";

const { currentHref, currentCategory } = Astro.props;

const related = articles
  .filter(
    (a) => a.category === currentCategory && a.href !== currentHref
  )
  .sort((a, b) => b.number - a.number)
  .slice(0, 3);
---

{related.length > 0 && (
<section class="related">

  <div class="label">
    Lanjutkan Membaca
  </div>

  <div class="list">

    {related.map((item)=>(

    <a href={item.href} class="card">

      <div class="category">
        {item.category}
      </div>

      <h3>{item.title}</h3>

      <p>{item.description}</p>

      <span>Baca tulisan →</span>

    </a>

    ))}

  </div>

</section>
)}

<style>
.related{
margin-top:110px;
padding-top:60px;
border-top:1px solid #DCD5CA;
}

.label{
margin-bottom:28px;
color:#81776A;
font-size:12px;
letter-spacing:.14em;
text-transform:uppercase;
}

.list{
display:grid;
grid-template-columns:repeat(3,minmax(0,1fr));
gap:22px;
}

.card{
display:block;
padding:24px;
border:1px solid #E5DFD5;
background:#F7F4EE;
text-decoration:none;
color:inherit;
transition:.2s;
}

.card:hover{
transform:translateY(-2px);
border-color:#7A2635;
}

.category{
margin-bottom:12px;
color:#81776A;
font-size:10px;
letter-spacing:.12em;
text-transform:uppercase;
}

.card h3{
margin:0 0 12px;
font-family:Georgia,serif;
font-weight:400;
font-size:24px;
line-height:1.2;
}

.card p{
margin:0 0 18px;
color:#514C45;
font-size:15px;
line-height:1.7;
}

.card span{
color:#7A2635;
font-size:14px;
}

@media(max-width:900px){
.list{grid-template-columns:1fr;}
}
</style>