---
import { articles } from "../data/manifest";

const {
  currentHref,
} = Astro.props;

const related = articles
.filter(a => a.href !== currentHref)
.slice(0,3);
---

<section class="related">

<div class="label">
Lanjutkan Perjalanan
</div>

<div class="grid">

{related.map(article => (

<a
href={article.href}
class="card"
>

<div class="pill">
{article.category}
</div>

<h3>
{article.title}
</h3>

<p>
{article.description}
</p>

<div class="more">
Baca tulisan →
</div>

</a>

))}

</div>

</section>

<style>

.related{
max-width:1200px;
margin:100px auto 0;
}

.label{
margin-bottom:30px;
color:#7A5A2A;
font-size:13px;
letter-spacing:.18em;
text-transform:uppercase;
}

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:28px;
}

.card{
display:flex;
flex-direction:column;
padding:30px;
min-height:320px;
border:1px solid #DDD2C5;
border-radius:26px;
background:#FBF8F2;
text-decoration:none;
transition:.25s ease;
}

.card:hover{
transform:translateY(-3px);
border-color:#7A2635;
}

.pill{
align-self:flex-start;
padding:8px 14px;
border:1px solid #D7CABC;
border-radius:999px;
color:#7A2635;
font-size:12px;
letter-spacing:.12em;
text-transform:uppercase;
}

.card h3{
margin:24px 0 18px;
color:#1F1A17;
font-family:Georgia,serif;
font-size:clamp(28px,3vw,40px);
font-weight:400;
line-height:1.15;
}

.card p{
flex:1;
margin:0;
color:#4F4942;
font-size:18px;
line-height:1.8;
}

.more{
margin-top:28px;
color:#7A2635;
font-size:17px;
font-weight:500;
}

@media(max-width:900px){

.grid{
grid-template-columns:1fr;
}

.card{
min-height:auto;
}

}

</style>
