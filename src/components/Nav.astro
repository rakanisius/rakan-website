---
import Brand from "./Brand.astro";
---

<header class="nav">
  <div class="inner">

    <Brand size={42}/>

    <nav>
      <a href="/about">Tentang</a>
      <a href="/holistik">Penyembuhan Holistik</a>
      <a href="/tulisan">Tulisan</a>
      <a href="/buku">Buku</a>
      <a href="/layanan">Layanan</a>
      <a href="/kolaborasi">Kolaborasi</a>
      <a href="/kontak">Kontak</a>
    </nav>

  </div>
</header>

<style>
.nav{
  position:sticky;
  top:0;
  z-index:100;
  background:#161311;
  border-bottom:1px solid #2A221E;
}

.inner{
  max-width:1180px;
  margin:auto;
  padding:18px 32px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

nav{
  display:flex;
  gap:34px;
}

nav a{
  color:#F7F4EE;
  text-decoration:none;
  font-size:16px;
}

nav a:hover{
  color:#C9B79A;
}

@media(max-width:900px){
  .inner{
    padding:16px 20px;
  }

  nav{
    gap:18px;
    overflow:auto;
  }

  nav a{
    white-space:nowrap;
  }
}
</style>