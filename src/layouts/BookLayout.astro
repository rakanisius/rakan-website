---
export interface Props{
title:string;
subtitle:string;
cover:string;
quote:string;
description:string;
ebook?:boolean;
physical?:"preorder"|"available";
}

const{
title,
subtitle,
cover,
quote,
description,
ebook=false,
physical="preorder"
}=Astro.props;
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>{title} | RAKAN</title>

<meta name="description" content={description}/>

<link rel="canonical" href={`https://rakan.my.id${Astro.url.pathname}`}/>

<meta property="og:title" content={`${title} | RAKAN`}/>
<meta property="og:description" content={description}/>
<meta property="og:type" content="book"/>
<meta property="og:image" content={cover}/>

<meta name="twitter:card" content="summary_large_image"/>

<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/>
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/>

</head>

<body>

<slot name="nav"/>

<main>

<section class="hero">

<div class="container hero-grid">

<div class="cover-wrap">

<img
src={cover}
alt={title}
fetchpriority="high"
/>

</div>

<div class="content">

<div class="eyebrow">
BUKU
</div>

<h1>{title}</h1>

<p class="subtitle">{subtitle}</p>

<div class="badges">

{ebook&&(
<span class="badge">
Ebook
</span>
)}

{physical==="available"&&(
<span class="badge solid">
Buku Fisik
</span>
)}

{physical==="preorder"&&(
<span class="badge">
Preorder
</span>
)}

</div>

<blockquote>
â€œ{quote}â€
</blockquote>

<p class="description">{description}</p>

<div class="actions">

<a
href="https://wa.me/62819821945"
target="_blank"
rel="noopener noreferrer"
class="button primary"
>
Pesan Buku
</a>

<a href="/buku" class="button secondary">
Kembali ke Rak Buku
</a>

</div>

</div>

</div>

</section>

<slot name="extra"/>

<section class="cta">

<div class="container narrow">

<div class="eyebrow">
LANJUTKAN PERJALANAN
</div>

<h2>
Satu buku sering menjadi awal percakapan yang lebih panjang.
</h2>

<p>
Kalau satu buku membuka pertanyaan baru,
Anda bisa melanjutkan perjalanan melalui Perpustakaan RAKAN,
Layanan,
atau Kolaborasi.
</p>

<div class="actions">

<a href="/tulisan" class="button secondary">
Perpustakaan
</a>

<a href="/layanan" class="button primary">
Lihat Layanan
</a>

</div>

</div>

</section>

</main>

<slot name="footer"/>

</body>

</html>

<style>

:global(*){box-sizing:border-box}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

.narrow{
max-width:760px;
}

.hero{
padding:90px 0;
border-bottom:1px solid #E5DFD5;
}

.hero-grid{
display:grid;
grid-template-columns:320px 1fr;
gap:64px;
align-items:center;
}

.cover-wrap{
background:#F1ECE5;
border:1px solid #E5DFD5;
overflow:hidden;
}

.cover-wrap img{
display:block;
width:100%;
aspect-ratio:2/3;
object-fit:cover;
}

.eyebrow{
margin-bottom:20px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1,h2{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
font-size:clamp(44px,6vw,72px);
line-height:1.05;
letter-spacing:-.03em;
}

h2{
margin-bottom:22px;
font-size:clamp(34px,5vw,48px);
line-height:1.15;
}

.subtitle{
margin:22px 0;
color:#756653;
font-size:18px;
line-height:1.7;
}

.badges{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-bottom:28px;
}

.badge{
padding:8px 12px;
border:1px solid #D8D0C5;
font-size:11px;
letter-spacing:.08em;
text-transform:uppercase;
}

.badge.solid{
background:#7A2635;
border-color:#7A2635;
color:white;
}

blockquote{
margin:0 0 28px;
padding-left:20px;
border-left:2px solid #7A2635;
color:#514C45;
font-family:Georgia,serif;
font-size:24px;
font-style:italic;
line-height:1.6;
}

.description{
color:#514C45;
font-size:17px;
line-height:1.85;
}

.actions{
display:flex;
gap:14px;
flex-wrap:wrap;
margin-top:34px;
}

.button{
display:inline-block;
padding:15px 24px;
text-decoration:none;
transition:.2s;
}

.button.primary{
background:#7A2635;
color:white;
}

.button.primary:hover{
background:#201D19;
}

.button.secondary{
background:transparent;
border:1px solid #D8D0C5;
color:#201D19;
}

.button.secondary:hover{
background:#F1ECE5;
}

.cta{
padding:95px 0;
background:#EBE5DC;
border-top:1px solid #E5DFD5;
}

@media(max-width:900px){

.container{
padding:0 20px;
}

.hero,
.cta{
padding:70px 0;
}

.hero-grid{
grid-template-columns:1fr;
}

.cover-wrap{
max-width:320px;
}

.actions{
flex-direction:column;
}

.button{
text-align:center;
}

}

@media(max-width:390px){

.container{
padding:0 18px;
}

.hero,
.cta{
padding:58px 0;
}

h1{
font-size:36px;
}

blockquote{
font-size:20px;
}

.description,
.subtitle{
font-size:15px;
}

}

</style>
