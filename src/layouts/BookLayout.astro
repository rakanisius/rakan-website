---
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const {
  title,
  subtitle,
  cover,
  status = "Ebook tersedia",
  buyLink = "https://wa.me/62819821945",
} = Astro.props;
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<link rel="icon" type="image/png" href="/favicon-rakan.png"/>
<link rel="shortcut icon" type="image/png" href="/favicon-rakan.png"/>
<link rel="apple-touch-icon" href="/favicon-rakan.png"/>

<title>{title} | RAKAN</title>

<meta name="description" content={subtitle}/>

</head>

<body>

<ClientRouter/>

<Nav/>

<main>

<!-- HERO -->

<section class="book">

<div class="container">

<a href="/buku" class="back">
← Kembali ke Rak Buku
</a>

<div class="grid">

<!-- COVER -->

<div class="cover-wrap">

<img
src={cover}
alt={title}
class="cover"
loading="eager"
/>

</div>

<!-- CONTENT -->

<div class="content">

<div class="eyebrow">
BUKU
</div>

<h1>{title}</h1>

<p class="subtitle">
{subtitle}
</p>

<div class="meta">

<div class="meta-item">
<span>Penulis</span>
<strong>Abdul Rakan</strong>
</div>

<div class="meta-item">
<span>Status</span>
<strong>{status}</strong>
</div>

<div class="meta-item">
<span>Format</span>
<strong>Ebook & Buku Fisik</strong>
</div>

<div class="meta-item">
<span>Kategori</span>
<strong>Pengembangan Diri</strong>
</div>

</div>

<a
href={buyLink}
class="button"
target="_blank"
rel="noopener noreferrer"
>
Pesan via WhatsApp
</a>

</div>

</div>

</div>

</section>

<!-- PEMISAH EDITORIAL -->

<div class="editorial-divider">
✦
</div>

<!-- KONTEN TAMBAHAN DARI HALAMAN BUKU -->

<slot name="extra"/>

</main>

<Footer/>

</body>
</html>

<style>

:global(*){box-sizing:border-box;}

:global(html){
overflow-x:hidden;
scroll-behavior:smooth;
}

:global(body){
margin:0;
overflow-x:hidden;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

/* ACCESSIBILITY */

:global(a:focus-visible),
:global(button:focus-visible){
outline:2px solid #7A2635;
outline-offset:4px;
}

/* CONTAINER */

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

/* HERO */

.book{
padding:60px 0 90px;
border-bottom:1px solid #E5DFD5;
}

.back{
display:inline-block;
margin-bottom:34px;
color:#514C45;
text-decoration:none;
font-size:14px;
transition:.2s;
}

.back:hover{
color:#201D19;
}

.grid{
display:grid;
grid-template-columns:380px minmax(0,1fr);
gap:70px;
align-items:start;
}

/* FLOATING COVER */

.cover-wrap{
background:#F1ECE5;
border:1px solid #E5DFD5;
overflow:hidden;

box-shadow:
0 16px 42px rgba(32,29,25,.10),
0 5px 14px rgba(32,29,25,.06);

transform:translateY(-6px);

transition:
transform .28s ease,
box-shadow .28s ease;
}

.cover-wrap:hover{

transform:translateY(-10px);

box-shadow:
0 26px 60px rgba(32,29,25,.15),
0 10px 22px rgba(32,29,25,.08);

}

.cover{
display:block;
width:100%;
aspect-ratio:2/3;
object-fit:cover;
}

/* TYPOGRAPHY */

.eyebrow{
margin-bottom:18px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1{
margin:0;
font-family:Georgia,serif;
font-size:clamp(42px,5vw,68px);
font-weight:400;
line-height:1.05;
letter-spacing:-.03em;
}

.subtitle{
max-width:560px;
margin-top:24px;
color:#514C45;
font-size:18px;
line-height:1.85;
}

/* META */

.meta{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:18px;
margin-top:34px;
padding-top:26px;
border-top:1px solid #E5DFD5;
}

.meta-item{
padding-bottom:12px;
border-bottom:1px solid #E5DFD5;
}

.meta-item span{
display:block;
margin-bottom:8px;
color:#7A2635;
font-size:11px;
letter-spacing:.12em;
text-transform:uppercase;
}

.meta-item strong{
font-weight:500;
line-height:1.5;
}

/* BUTTON */

.button{
display:inline-block;
margin-top:34px;
padding:15px 24px;
background:#7A2635;
color:white;
text-decoration:none;
transition:.2s;
}

.button:hover{
background:#201D19;
}

/* EDITORIAL DIVIDER */

.editorial-divider{
text-align:center;
padding:26px 0;
color:#9B8C79;
font-size:18px;
letter-spacing:.22em;
}

/* TABLET */

@media(max-width:900px){

.container{
padding:0 20px;
}

.grid{
grid-template-columns:1fr;
gap:42px;
}

.cover-wrap{
max-width:380px;
}

}

/* MOBILE */

@media(max-width:390px){

.container{
padding:0 18px;
}

.book{
padding:44px 0 70px;
}

h1{
font-size:34px;
}

.subtitle{
font-size:16px;
}

.meta{
grid-template-columns:1fr;
}

.button{
display:block;
width:100%;
text-align:center;
}

.editorial-divider{
padding:22px 0;
}

}

</style>