---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

import WorldBadge from "../components/editorial/WorldBadge.astro";
import KnowledgeNavigator from "../components/KnowledgeNavigator.astro";
import ContextCTA from "../components/ContextCTA.astro";
import AuthorCard from "../components/editorial/AuthorCard.astro";

import "../styles/article.css";

const {
  title,
  description,
  world,
  node,
  edition,
  archive,
  author = "Abdul Rakan",
  readingTime = "8 menit membaca",
  benangMerah,
  heroQuote,
  heroImage
} = Astro.props;
---

<!doctype html>
<html lang="id">

<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>{title} | RAKAN</title>
<meta name="description" content={description}/>

<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/>
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/>

<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>

{heroImage && <meta property="og:image" content={heroImage}/>}

</head>

<body>

<Nav/>

<main class="article-shell">

<header class="hero">

<div class="hero-top">

{world && <WorldBadge world={world}/>}

<div class="meta">

{node && <span>{node}</span>}

{node && readingTime && <span>•</span>}

<span>{readingTime}</span>

{edition && (
<>
<span>•</span>
<span>{edition}</span>
</>
)}

</div>

</div>

<h1>{title}</h1>

{benangMerah && (
<p class="benang">
<strong>Benang Merah.</strong> {benangMerah}
</p>
)}

{heroQuote && (
<blockquote class="hero-quote">
{heroQuote}
</blockquote>
)}

{heroImage && (
<img
src={heroImage}
alt={title}
class="hero-image"
loading="eager"
/>
)}

</header>

<article class="article-prose">
<slot/>
</article>

<KnowledgeNavigator node={node}/>

<ContextCTA/>

<AuthorCard author={author} archive={archive}/>

</main>

<Footer/>

</body>
</html>

<style>

:root{
--cream:#F7F4EE;
--maroon:#7A2635;
--text:#201D19;
--muted:#756653;
}

html{
scroll-behavior:smooth;
}

body{
margin:0;
background:var(--cream);
color:var(--text);
}

.article-shell{
max-width:760px;
margin:auto;
padding:64px 24px 96px;
}

.hero{
margin-bottom:48px;
}

.hero-top{
display:flex;
flex-direction:column;
gap:16px;
margin-bottom:20px;
}

.meta{
display:flex;
gap:10px;
flex-wrap:wrap;
font-size:13px;
letter-spacing:.08em;
text-transform:uppercase;
color:var(--muted);
}

h1{
font-family:Georgia,serif;
font-weight:400;
font-size:clamp(42px,6vw,68px);
line-height:1.05;
letter-spacing:-.03em;
margin:0 0 22px;
color:var(--text);
}

.benang{
font-size:18px;
line-height:1.8;
color:#4F4A44;
margin:0 0 28px;
}

.hero-quote{
margin:0 0 36px;
padding-left:22px;
border-left:3px solid var(--maroon);
font-family:Georgia,serif;
font-style:italic;
font-size:24px;
line-height:1.6;
color:#3F3A34;
}

.hero-image{
width:100%;
aspect-ratio:16/9;
object-fit:cover;
border-radius:22px;
display:block;
}

@media(max-width:800px){

.article-shell{
padding:48px 20px 80px;
}

h1{
font-size:40px;
}

.hero-quote{
font-size:21px;
}

}

</style>