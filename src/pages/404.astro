---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<link rel="icon" type="image/png" href="/favicon-rakan.png"/>
<link rel="shortcut icon" type="image/png" href="/favicon-rakan.png"/>
<link rel="apple-touch-icon" href="/favicon-rakan.png"/>

<title>Halaman Tidak Ditemukan | RAKAN</title>

<meta
name="description"
content="Halaman yang kamu cari tidak ditemukan."
/>

</head>

<body>

<Nav/>

<main>

<section class="hero">

<div class="container">

<div class="eyebrow">
404
</div>

<h1>
Halaman tidak ditemukan.
</h1>

<p class="intro">
Mungkin alamatnya berubah.
Mungkin salah ketik.
Tetapi percakapannya belum selesai.
</p>

<div class="buttons">

<a href="/" class="button">
Kembali ke Beranda
</a>

<a href="/tulisan" class="button secondary">
Baca Tulisan
</a>

<a href="/buku" class="button secondary">
Jelajahi Buku
</a>

</div>

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>

:global(*){box-sizing:border-box;}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:760px;
margin:auto;
padding:0 32px;
}

.hero{
padding:140px 0;
text-align:center;
}

.eyebrow{
margin-bottom:20px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1{
margin:0;
font-family:Georgia,serif;
font-weight:400;
font-size:clamp(46px,6vw,70px);
line-height:1.05;
}

.intro{
margin:30px auto 0;
max-width:520px;
color:#514C45;
font-size:18px;
line-height:1.85;
}

.buttons{
display:flex;
justify-content:center;
gap:16px;
flex-wrap:wrap;
margin-top:42px;
}

.button{
padding:15px 24px;
background:#7A2635;
color:white;
text-decoration:none;
}

.secondary{
background:transparent;
border:1px solid #D8D0C5;
color:#201D19;
}

.secondary:hover{
background:#F1ECE5;
}

@media(max-width:600px){

.container{
padding:0 20px;
}

.hero{
padding:100px 0;
}

.button{
width:100%;
text-align:center;
}

}

</style>