---
import Nav from "../components/Nav.astro";

const title = "Buku | RAKAN";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href="/favicon-rakan.png" />
<link rel="shortcut icon" type="image/png" href="/favicon-rakan.png" />
<link rel="apple-touch-icon" href="/favicon-rakan.png" />
    <title>{title}</title>

    <meta
      name="description"
      content="Buku-buku Rakan tentang kesehatan, manusia, pikiran, kehidupan, dan perjalanan memahami diri."
    />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        background: #f7f4ee;
        color: #29251f;
        font-family: Arial, sans-serif;
      }

      .page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 90px 32px 120px;
      }

      .eyebrow {
        margin-bottom: 25px;
        color: #756d62;
        font-size: 13px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 900px;
        margin: 0;
        font-family: Georgia, serif;
        font-size: clamp(48px, 7vw, 86px);
        font-weight: 400;
        line-height: 0.98;
        letter-spacing: -0.04em;
      }

      h1 em {
        font-weight: 400;
      }

      .intro {
        max-width: 650px;
        margin-top: 35px;
        color: #655f56;
        font-size: 18px;
        line-height: 1.8;
      }

      .books {
        margin-top: 100px;
      }

      .book {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 60px;
        padding: 55px 0;
        border-top: 1px solid #dcd5ca;
      }

      .cover {
        min-height: 380px;
        padding: 35px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #e9e2d6;
        border: 1px solid #d6cdbf;
      }

      .cover-label {
        color: #756d62;
        font-size: 11px;
        letter-spacing: 0.15em;
      }

      .cover-title {
        font-family: Georgia, serif;
        font-size: 34px;
        line-height: 1.05;
      }

      .cover-author {
        color: #655f56;
        font-size: 13px;
      }

      .book-number {
        margin-bottom: 18px;
        color: #81776a;
        font-size: 12px;
        letter-spacing: 0.13em;
      }

      h2 {
        max-width: 700px;
        margin: 0;
        font-family: Georgia, serif;
        font-size: clamp(34px, 5vw, 58px);
        font-weight: 400;
        line-height: 1.05;
      }

      .book-text {
        max-width: 650px;
        margin-top: 25px;
        color: #655f56;
        font-size: 17px;
        line-height: 1.8;
      }

      .note {
        max-width: 650px;
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid #dcd5ca;
        color: #81776a;
        font-size: 14px;
        line-height: 1.7;
      }

      @media (max-width: 750px) {
        .page {
          padding: 65px 22px 90px;
        }

        .book {
          grid-template-columns: 1fr;
          gap: 35px;
        }

        .cover {
          max-width: 280px;
        }
      }
    </style>
  </head>

  <body>
    <Nav />

    <main class="page">
      <div class="eyebrow">Ruang Buku RAKAN</div>

      <h1>
        Membaca manusia<br />
        <em>melalui cerita.</em>
      </h1>

      <p class="intro">
        Buku adalah ruang untuk memperlambat langkah, melihat kembali
        pengalaman, dan memahami manusia dari sisi yang lebih dalam.
      </p>

      <section class="books">
        <article class="book">
          <div class="cover">
            <div class="cover-label">BUKU · 01</div>

            <div class="cover-title">
              Tuhan, wafatkan aku di usia 63 Tahun!
            </div>

            <div class="cover-author">
              Abdul Rakan
            </div>
          </div>

          <div>
            <div class="book-number">01 · CATATAN KEHIDUPAN</div>

            <h2>
              Tuhan, wafatkan aku<br />
              di usia <em>63 Tahun!</em>
            </h2>

            <p class="book-text">
              Sebuah perjalanan untuk melihat kembali waktu, kematian,
              kehilangan, pekerjaan, keluarga, dan pertanyaan tentang
              bagaimana seharusnya manusia menggunakan hidup yang diberikan
              kepadanya.
            </p>

            <p class="note">
              63 tahun bukan sekadar angka. Ia menjadi pengingat bahwa hidup
              memiliki batas, dan karena itu setiap bagian darinya layak
              dijalani dengan kesadaran.
            </p>
          </div>
        </article>

        <article class="book">
          <div class="cover">
            <div class="cover-label">BUKU · 02</div>

            <div class="cover-title">
              Pikiran Jangan Berisik
            </div>

            <div class="cover-author">
              Abdul Rakan
            </div>
          </div>

          <div>
            <div class="book-number">02 · PIKIRAN & KEHIDUPAN</div>

            <h2>
              Pikiran<br />
              <em>Jangan Berisik.</em>
            </h2>

            <p class="book-text">
              Catatan tentang pikiran manusia, suara di dalam kepala,
              kecemasan, kebiasaan berpikir, dan cara kita berhubungan dengan
              diri sendiri.
            </p>

            <p class="note">
              Bukan tentang mematikan pikiran, melainkan belajar mendengarnya
              tanpa selalu harus mempercayai semua yang dikatakannya.
            </p>
          </div>
        </article>
      </section>
    </main>
  </body>
</html>