---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { books } from "../data/books";

const featured = books.find((b) => b.featured) ?? books[0];
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>Perpustakaan Buku | RAKAN</title>

<meta
name="description"
content="Buku-buku karya Abdul Rakan tentang tubuh, otak, pikiran, kehidupan, dan penyembuhan holistik."
/>

<link rel="canonical" href="https://rakan.my.id/buku"/>

<meta property="og:title" content="Perpustakaan Buku | RAKAN"/>
<meta property="og:description" content="Buku-buku karya Abdul Rakan sebagai ruang percakapan yang lebih panjang."/>
<meta property="og:type" content="website"/>
<meta property="og:image" content={featured.cover}/>

<meta name="twitter:card" content="summary_large_image"/>

<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/>
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/>

</head>

<body>

<Nav/>

<main>

<section class="hero">

<div class="container narrow">

<div class="eyebrow">
PERPUSTAKAAN BUKU
</div>

<h1>
Gagasan yang
<em>tumbuh menjadi buku.</em>
</h1>

<p class="intro">
Sebagian percakapan selesai dalam satu artikel.
Sebagian membutuhkan ruang yang lebih panjang.
Buku-buku ini lahir agar gagasan tetap menemani seseorang,
bahkan ketika percakapannya sudah selesai.
</p>

</div>

</section>

<section class="featured">

<div class="container featured-grid">

<div class="featured-cover">

<img
src={featured.cover}
alt={featured.title}
fetchpriority="high"
/>

</div>

<div class="featured-content">

<div class="eyebrow">
BUKU UTAMA
</div>

<h2>{featured.title}</h2>

<p class="author">
Abdul Rakan Â· Apoteker & Praktisi Penyembuhan Holistik
</p>

<p>{featured.description}</p>

<p>
Buku ini menjadi salah satu pintu masuk menuju cara pandang
yang melahirkan RAKAN sebagai ruang untuk memahami manusia secara lebih utuh.
</p>

<a
href={`/buku-${featured.slug}`}
class="button"
>
Lihat Buku
</a>

</div>

</div>

</section>

<section class="books-section">

<div class="container">

<div class="eyebrow">
SEMUA BUKU
</div>

<h2>
Setiap buku memulai perjalanan yang berbeda.
</h2>

<div class="books-grid">

{books.map((book)=>(

<a
href={`/buku-${book.slug}`}
class="book-card"
>

<div class="cover-wrap">

<img
src={book.cover}
alt={book.title}
class="cover"
loading="lazy"
/>

</div>

<div class="book-content">

<h3>{book.title}</h3>

<p>{book.description}</p>

<div class="badges">

{book.ebook&&(
<span class="badge">
Ebook
</span>
)}

{book.physical==="available"&&(
<span class="badge solid">
Buku Fisik
</span>
)}

{book.physical==="preorder"&&(
<span class="badge">
Preorder
</span>
)}

</div>

<div class="link">
Lihat buku â†’
</div>

</div>

</a>

))}

</div>

</div>

</section>

<section class="philosophy">

<div class="container narrow">

<div class="eyebrow">
DI BALIK SETIAP BUKU
</div>

<h2>
Menulis adalah cara memperpanjang percakapan.
</h2>

<p>
Buku bukan pengganti percakapan.
Ia menjadi ruang yang lebih panjang ketika satu artikel
tidak lagi cukup untuk membawa sebuah gagasan.
</p>

<p>
Sebagian tulisan lahir dari pengalaman sebagai apoteker.
Sebagian lahir dari pendampingan manusia.
Sebagian lagi lahir dari pertanyaan yang terus kembali datang.
</p>

<p class="closing-line">
Setiap buku membawa satu pertanyaan.
Semuanya kembali pada satu perjalanan: memahami manusia.
</p>

</div>

</section>

<section class="cta">

<div class="container narrow">

<div class="eyebrow">
LANJUTKAN PERJALANAN
</div>

<h2>
Jika satu buku membuka pertanyaan baru.
</h2>

<p>
Anda bisa melanjutkan perjalanan melalui Perpustakaan RAKAN,
konsultasi,
pendampingan,
atau kolaborasi.
</p>

<div class="cta-actions">

<a href="/tulisan" class="button secondary">
Perpustakaan
</a>

<a href="/layanan" class="button">
Lihat Layanan
</a>

</div>

</div>

</section>

</main>

<Footer/>

</body>

</html>

<style>

:global(*){box-sizing:border-box}

:global(html){
scroll-behavior:smooth;
}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

.narrow{
max-width:760px;
}

.hero,
.featured,
.books-section{
padding:90px 0;
border-bottom:1px solid #E5DFD5;
}

.philosophy{
padding:90px 0;
background:#F1ECE5;
}

.cta{
padding:95px 0;
background:#EBE5DC;
}

.eyebrow{
margin-bottom:24px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1,h2,h3{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
font-size:clamp(50px,7vw,82px);
line-height:1.04;
letter-spacing:-.03em;
}

h1 em{
display:block;
font-style:italic;
color:#756653;
}

h2{
margin-bottom:26px;
font-size:clamp(34px,5vw,48px);
line-height:1.12;
}

h3{
font-size:28px;
line-height:1.18;
margin-bottom:14px;
}

.intro,
p{
color:#514C45;
font-size:17px;
line-height:1.8;
}

.featured-grid{
display:grid;
grid-template-columns:320px 1fr;
gap:64px;
align-items:center;
}

.featured-cover img{
width:100%;
aspect-ratio:2/3;
object-fit:cover;
border:1px solid #E5DFD5;
}

.author{
margin-bottom:22px;
color:#756653;
font-size:14px;
letter-spacing:.08em;
}

.books-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:32px;
margin-top:42px;
}

.book-card{
display:flex;
flex-direction:column;
text-decoration:none;
color:inherit;
transition:.25s;
}

.book-card:hover{
transform:translateY(-4px);
}

.cover-wrap{
overflow:hidden;
background:#F1ECE5;
border:1px solid #E5DFD5;
}

.cover{
display:block;
width:100%;
aspect-ratio:2/3;
object-fit:cover;
transition:.35s;
}

.book-card:hover .cover{
transform:scale(1.03);
}

.book-content{
padding-top:22px;
}

.badges{
display:flex;
gap:10px;
flex-wrap:wrap;
margin:20px 0;
}

.badge{
padding:8px 12px;
border:1px solid #D8D0C5;
font-size:11px;
text-transform:uppercase;
}

.badge.solid{
background:#7A2635;
border-color:#7A2635;
color:white;
}

.link{
color:#201D19;
font-size:15px;
}

.closing-line{
margin-top:34px;
font-family:Georgia,serif;
font-size:24px;
font-style:italic;
color:#756653;
}

.cta-actions{
display:flex;
gap:14px;
flex-wrap:wrap;
margin-top:30px;
}

.button{
display:inline-block;
padding:15px 24px;
background:#7A2635;
color:white;
text-decoration:none;
transition:.2s;
}

.button:hover{
background:#201D19;
}

.button.secondary{
background:transparent;
border:1px solid #D8D0C5;
color:#201D19;
}

.button.secondary:hover{
background:#F1ECE5;
}

@media(max-width:900px){

.container{
padding:0 20px;
}

.hero,
.featured,
.books-section,
.philosophy,
.cta{
padding:70px 0;
}

.featured-grid,
.books-grid{
grid-template-columns:1fr;
}

.featured-cover{
max-width:320px;
}

}

@media(max-width:390px){

.container{
padding:0 18px;
}

.hero,
.featured,
.books-section,
.philosophy,
.cta{
padding:58px 0;
}

h1{
font-size:34px;
}

h3{
font-size:22px;
}

.intro,
p{
font-size:15px;
}

.closing-line{
font-size:20px;
}

}

</style>
