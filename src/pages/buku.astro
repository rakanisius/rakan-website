---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const books = [
  {
    title: "Pikiran, Jangan Berisik!",
    description:
      "Percakapan tentang pikiran, emosi, dan cara kita berdamai dengan suara-suara di dalam kepala.",
    cover: "/images/books/pikiran-jangan-berisik.jpg",
    href: "/buku-pikiran-jangan-berisik",
    ebook: true,
    physical: true,
  },
  {
    title: "Ditemenin Sendiri",
    description:
      "Tentang belajar menemani diri sendiri ketika kehidupan tidak selalu berjalan sesuai harapan.",
    cover: "/images/books/ditemenin-sendiri.jpg",
    href: "/buku-ditemenin-sendiri",
    ebook: true,
    physical: "preorder",
  },
  {
    title: "Tuhan, Wafatkan Aku di Usia 63 Tahun!",
    description:
      "Refleksi tentang waktu, kehidupan, dan keberanian menggunakan usia sebagai kompas, bukan sekadar angka.",
    cover: "/images/books/63-tahun.jpg",
    href: "/buku-tuhan-wafatkan-aku-di-usia-63-tahun",
    ebook: true,
    physical: "preorder",
  },
];
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<link rel="icon" href="/favicon-rakan.png"/>

<title>Buku | RAKAN</title>

<meta
name="description"
content="Buku-buku karya Abdul Rakan tentang tubuh, pikiran, dan kehidupan."
/>

</head>

<body>

<Nav/>

<main>

<!-- HERO -->

<section class="hero">

<div class="container narrow">

<div class="eyebrow">
BUKU
</div>

<h1>
Gagasan yang
<em>tumbuh menjadi buku.</em>
</h1>

<p class="intro">
  Sebagian percakapan selesai dalam satu pertemuan. Sebagian percakapan membutuhkan lebih dari satu halaman. Buku-buku ini lahir agar gagasan tetap bisa menemani seseorang, bahkan ketika percakapannya sudah selesai.
</p>

</div>

</section>

<!-- FEATURED -->

<section class="featured">

<div class="container featured-grid">

<div class="featured-cover">

<img
src="/images/books/63-tahun.jpg"
alt="Tuhan, Wafatkan Aku di Usia 63 Tahun!"
loading="lazy"
/>

</div>

<div class="featured-content">

<div class="eyebrow">
BUKU UTAMA
</div>

<h2>
Tuhan, Wafatkan Aku di Usia 63 Tahun!
</h2>

<p class="author">
Abdul Rakan
</p>

<p>
Refleksi tentang waktu, kematian, kehidupan,
dan keberanian menggunakan usia sebagai kompas,
bukan sekadar angka.
</p>

<p>
Buku ini menjadi pintu masuk menuju cara pandang
yang melahirkan RAKAN.
</p>

<a
href="/buku-tuhan-wafatkan-aku-di-usia-63-tahun"
class="button"
>
Lihat Buku
</a>

</div>

</div>

</section>

<!-- RAK BUKU -->

<section class="books-section">

<div class="container">

<div class="eyebrow">
SEMUA BUKU
</div>

<div class="books-grid">

{books.map((book)=>(

<a href={book.href} class="book-card">

<div class="cover-wrap">

<img
src={book.cover}
alt={book.title}
class="cover"
loading="lazy"
/>

</div>

<div class="book-content">

<h2>{book.title}</h2>

<p>{book.description}</p>

<div class="badges">

{book.ebook && (
<span class="badge">
Ebook tersedia
</span>
)}

{book.physical===true && (
<span class="badge solid">
Buku fisik tersedia
</span>
)}

{book.physical==="preorder" && (
<span class="badge">
Preorder buku fisik
</span>
)}

</div>

<div class="link">
Lihat buku →
</div>

</div>

</a>

))}

</div>

</div>

</section>

<!-- FILOSOFI -->

<section class="philosophy">

<div class="container narrow">

<div class="eyebrow">
DI BALIK SETIAP BUKU
</div>

<h2>
Menulis adalah cara memperpanjang percakapan.
</h2>

<p>
Buku bukan pengganti percakapan.
Ia menjadi ruang yang lebih panjang ketika satu artikel
tidak lagi cukup untuk membawa sebuah gagasan.
</p>

<p class="closing-line">
Tiga buku. Tiga pertanyaan. Satu perjalanan memahami manusia.
</p>

</div>

</section>

<!-- CTA -->

<section class="cta">

<div class="container narrow">

<div class="eyebrow">
LANJUTKAN PERJALANAN
</div>

<h2>
Jika buku membuka pertanyaan baru.
</h2>

<p>
Sebagian orang cukup melanjutkan perjalanan lewat tulisan.
Sebagian lain memilih memulai percakapan melalui konsultasi.
</p>

<div class="cta-actions">

<a href="/buku" class="button secondary">
Baca Tulisan
</a>

<a href="/layanan" class="button">
Lihat Layanan
</a>

</div>

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>

:global(*){box-sizing:border-box;}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

.narrow{
max-width:760px;
}

/* HERO */

.hero{
padding:100px 0 90px;
border-bottom:1px solid #E5DFD5;
}

.eyebrow{
margin-bottom:24px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1,h2,h3{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
font-size:clamp(50px,7vw,82px);
line-height:1.04;
letter-spacing:-.03em;
}

h1 em{
display:block;
font-style:italic;
color:#756653;
}

.intro{
margin-top:30px;
color:#514C45;
font-size:17px;
line-height:1.8;
}

/* FEATURED */

.featured{
padding:90px 0;
border-bottom:1px solid #E5DFD5;
}

.featured-grid{
display:grid;
grid-template-columns:320px 1fr;
gap:64px;
align-items:center;
}

.featured-cover img{
width:100%;
aspect-ratio:2/3;
object-fit:cover;
border:1px solid #E5DFD5;
}

.featured-content h2{
font-size:clamp(40px,5vw,56px);
line-height:1.08;
margin-bottom:14px;
}

.author{
margin:0 0 22px;
color:#756653;
font-size:14px;
letter-spacing:.08em;
}

/* GRID */

.books-section{
padding:90px 0;
}

.books-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:32px;
margin-top:36px;
}

.book-card{
display:flex;
flex-direction:column;
text-decoration:none;
color:inherit;
transition:transform .25s ease;
}

.book-card:hover{
transform:translateY(-3px);
}

.cover-wrap{
overflow:hidden;
background:#F1ECE5;
border:1px solid #E5DFD5;
}

.cover{
width:100%;
aspect-ratio:2/3;
object-fit:cover;
display:block;
transition:transform .35s ease;
}

.book-card:hover .cover{
transform:scale(1.03);
}

.book-content{
padding-top:22px;
}

.book-content h2{
font-size:28px;
line-height:1.15;
margin-bottom:14px;
}

.book-content p{
color:#514C45;
line-height:1.8;
margin-bottom:20px;
}

.badges{
display:flex;
flex-wrap:wrap;
gap:10px;
margin-bottom:20px;
}

.badge{
padding:8px 12px;
border:1px solid #D8D0C5;
font-size:11px;
}

.badge.solid{
background:#7A2635;
border-color:#7A2635;
color:white;
}

.link{
color:#201D19;
font-size:15px;
}

/* FILOSOFI */

.philosophy{
background:#F1ECE5;
padding:90px 0;
}

.philosophy h2{
font-size:clamp(34px,5vw,48px);
margin-bottom:24px;
}

.philosophy p{
color:#514C45;
line-height:1.85;
}

.closing-line{
margin-top:34px;
font-family:Georgia,serif;
font-size:24px;
font-style:italic;
color:#756653;
}

/* CTA */

.cta{
padding:90px 0 110px;
background:#EBE5DC;
}

.cta h2{
font-size:clamp(34px,5vw,48px);
margin-bottom:22px;
}

.cta p{
color:#514C45;
line-height:1.8;
}

.cta-actions{
display:flex;
gap:14px;
flex-wrap:wrap;
margin-top:30px;
}

.button{
display:inline-block;
padding:15px 24px;
background:#7A2635;
color:white;
text-decoration:none;
transition:.2s;
}

.button:hover{
background:#201D19;
}

.button.secondary{
background:transparent;
border:1px solid #D8D0C5;
color:#201D19;
}

@media(max-width:900px){

.container{
padding:0 20px;
}

.featured-grid,
.books-grid{
grid-template-columns:1fr;
}

.featured-cover{
max-width:320px;
}

.hero,
.featured,
.books-section,
.philosophy,
.cta{
padding:70px 0;
}

}

@media(max-width:390px){

.container{
padding:0 18px;
}

.hero{
padding:58px 0;
}

h1{
font-size:34px;
}

.book-content h2{
font-size:22px;
}

.intro,
.philosophy p{
font-size:15px;
}

.closing-line{
font-size:20px;
}

}
</style>