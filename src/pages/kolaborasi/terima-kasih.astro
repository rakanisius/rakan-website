---
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const title = "Terima Kasih | RAKAN";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/favicon-rakan.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon-rakan.png" />
    <link rel="apple-touch-icon" href="/favicon-rakan.png" />

    <title>{title}</title>

    <meta
      name="description"
      content="Terima kasih. Pengajuan kolaborasi Anda telah diterima."
    />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        background: #f7f4ee;
        color: #201d19;
        font-family: Arial, sans-serif;
      }

      .page {
        max-width: 760px;
        margin: 0 auto;
        padding: 100px 28px 120px;
      }

      .eyebrow {
        margin-bottom: 24px;
        color: #7a2635;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0 0 28px;
        font-family: Georgia, serif;
        font-size: clamp(44px, 7vw, 68px);
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -0.03em;
      }

      .lead {
        color: #514c45;
        font-size: 18px;
        line-height: 1.8;
        margin-bottom: 46px;
      }

      .info {
        padding: 30px 0;
        border-top: 1px solid #dcd5ca;
        border-bottom: 1px solid #dcd5ca;
        margin-bottom: 50px;
      }

      .info p {
        margin: 0 0 16px;
        color: #514c45;
        line-height: 1.8;
      }

      .info p:last-child {
        margin-bottom: 0;
      }

      .actions {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
      }

      .button-primary,
      .button-secondary {
        display: inline-block;
        padding: 15px 24px;
        text-decoration: none;
        font-size: 15px;
        transition: 0.2s ease;
      }

      .button-primary {
        background: #7a2635;
        color: white;
      }

      .button-primary:hover {
        background: #201d19;
      }

      .button-secondary {
        border: 1px solid #d6cdc0;
        color: #201d19;
      }

      .button-secondary:hover {
        background: #ebe5dc;
      }

      @media (max-width: 640px) {
        .page {
          padding: 70px 22px 90px;
        }

        .actions {
          flex-direction: column;
        }

        .button-primary,
        .button-secondary {
          text-align: center;
        }
      }
    </style>
  </head>

  <body>
    <Nav />

    <main class="page">
      <div class="eyebrow">Kolaborasi</div>

      <h1>Terima kasih.</h1>

      <p class="lead">
        Pengajuan kolaborasi Anda telah diterima. Terima kasih telah
        meluangkan waktu untuk menjelaskan kebutuhan kegiatan Anda.
      </p>

      <div class="info">
        <p>
          Saya akan mempelajari informasi yang Anda kirim terlebih dahulu agar
          percakapan berikutnya dapat dimulai dengan konteks yang lebih jelas.
        </p>

        <p>
          Untuk kebutuhan yang bersifat mendesak, Anda tetap dapat menghubungi
          melalui halaman Kontak.
        </p>
      </div>

      <div class="actions">
        <a href="/" class="button-primary">Kembali ke Beranda</a>

        <a href="/kontak" class="button-secondary">Lihat Kontak</a>
      </div>
    </main>

    <Footer />
  </body>
</html>