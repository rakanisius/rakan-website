---
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const title = "Form Kolaborasi | RAKAN";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta
      name="description"
      content="Ajukan kolaborasi bersama RAKAN untuk seminar, workshop, kelas, talkshow, dan program khusus."
    />

    <link rel="icon" type="image/png" href="/favicon-rakan.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon-rakan.png" />
    <link rel="apple-touch-icon" href="/favicon-rakan.png" />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        background: #f7f4ee;
        color: #201d19;
        font-family: Arial, sans-serif;
      }

      .container {
        max-width: 760px;
        margin: 0 auto;
        padding: 90px 24px 120px;
      }

      .eyebrow {
        margin-bottom: 24px;
        color: #7a2635;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0 0 24px;
        font-family: Georgia, serif;
        font-size: clamp(42px, 6vw, 64px);
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.03em;
      }

      .lead {
        margin-bottom: 42px;
        color: #514c45;
        font-size: 18px;
        line-height: 1.8;
      }

      .info {
        margin-bottom: 46px;
        padding: 28px 0;
        border-top: 1px solid #d8d0c4;
        border-bottom: 1px solid #d8d0c4;
      }

      .info h2 {
        margin: 0 0 14px;
        font-family: Georgia, serif;
        font-size: 24px;
        font-weight: 400;
      }

      .info ul {
        margin: 0;
        padding-left: 18px;
        color: #514c45;
        line-height: 1.9;
      }

      .guide {
        margin-bottom: 42px;
        padding: 28px;
        background: #ebe5dc;
      }

      .guide h2 {
        margin: 0 0 14px;
        font-family: Georgia, serif;
        font-size: 24px;
        font-weight: 400;
      }

      .guide p {
        margin: 0 0 14px;
        color: #514c45;
        line-height: 1.8;
      }

      .guide ul {
        margin: 0;
        padding-left: 18px;
        color: #514c45;
        line-height: 1.9;
      }

      form {
        display: grid;
        gap: 28px;
      }

      label {
        display: block;
        margin-bottom: 10px;
        color: #514c45;
        font-size: 14px;
      }

      input,
      textarea,
      select {
        width: 100%;
        padding: 16px;
        border: 1px solid #d8d0c4;
        background: white;
        color: #201d19;
        font-size: 16px;
        font-family: inherit;
      }

      input:focus,
      textarea:focus,
      select:focus {
        outline: none;
        border-color: #7a2635;
      }

      textarea {
        min-height: 170px;
        resize: vertical;
      }

      button {
        padding: 16px 26px;
        border: none;
        background: #7a2635;
        color: white;
        font-size: 15px;
        cursor: pointer;
        transition: background 0.2s ease;
      }

      button:hover {
        background: #201d19;
      }

      @media (max-width: 640px) {
        .container {
          padding: 70px 20px 90px;
        }

        .guide {
          padding: 24px;
        }
      }
    </style>
  </head>

  <body>
    <Nav />

    <main class="container">
      <div class="eyebrow">Kolaborasi</div>

      <h1>Mari mulai sebuah kolaborasi.</h1>

      <p class="lead">
        Ceritakan kebutuhan kegiatan Anda. Saya akan mempelajari konteks,
        peserta, tujuan, dan bentuk kolaborasi yang paling sesuai sebelum
        melanjutkan percakapan berikutnya.
      </p>

      <section class="info">
        <h2>Sebelum mengirim</h2>

        <ul>
          <li>Proposal akan dipelajari terlebih dahulu.</li>
          <li>Balasan akan dikirim melalui email.</li>
          <li>Untuk kebutuhan mendesak, gunakan WhatsApp di halaman Kontak.</li>
        </ul>
      </section>

      <section class="guide">
        <h2>Apa yang biasanya saya butuhkan?</h2>

        <p>
          Tidak perlu menyiapkan proposal yang rumit. Tiga informasi berikut
          sudah cukup untuk memulai.
        </p>

        <ul>
          <li>Tujuan kegiatan.</li>
          <li>Siapa pesertanya.</li>
          <li>Kapan rencananya.</li>
        </ul>
      </section>

      <form
        name="kolaborasi"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        action="/kolaborasi/terima-kasih/"
      >
        <input type="hidden" name="form-name" value="kolaborasi" />

        <p hidden>
          <label>
            Jangan isi kolom ini
            <input name="bot-field" />
          </label>
        </p>

        <div>
          <label for="nama">Nama *</label>
          <input id="nama" name="nama" required />
        </div>

        <div>
          <label for="email">Email *</label>
          <input id="email" type="email" name="email" required />
        </div>

        <div>
          <label for="institusi">Institusi / Organisasi</label>
          <input id="institusi" name="institusi" />
        </div>

        <div>
          <label for="jenis">Jenis Kolaborasi *</label>
          <select id="jenis" name="jenis" required>
            <option value="">Pilih jenis kolaborasi</option>
            <option>Seminar</option>
            <option>Talkshow</option>
            <option>Workshop</option>
            <option>Kelas</option>
            <option>Program Khusus</option>
            <option>Media & Wawancara</option>
            <option>Lainnya</option>
          </select>
        </div>

        <div>
          <label for="lokasi">Lokasi</label>
          <input
            id="lokasi"
            name="lokasi"
            placeholder="Contoh: Jakarta atau Online"
          />
        </div>

        <div>
          <label for="peserta">Perkiraan Jumlah Peserta</label>
          <input
            id="peserta"
            name="peserta"
            placeholder="Contoh: 80 peserta"
          />
        </div>

        <div>
          <label for="waktu">Perkiraan Waktu</label>
          <input
            id="waktu"
            name="waktu"
            placeholder="Contoh: Oktober 2026"
          />
        </div>

        <div>
          <label for="pesan">Ceritakan kebutuhan Anda *</label>
          <textarea
            id="pesan"
            name="pesan"
            placeholder="Misalnya tujuan kegiatan, siapa pesertanya, durasi yang diharapkan, dan informasi lain yang menurut Anda penting."
            required
          ></textarea>
        </div>

        <button type="submit">Kirim Pengajuan</button>
      </form>
    </main>

    <Footer />
  </body>
</html>