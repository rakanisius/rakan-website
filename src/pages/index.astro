
---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { articles } from "../data/articles";

const title = "RAKAN | Apoteker & Praktisi Penyembuhan Holistik";
const description =
  "Mendampingi manusia memahami tubuh, otak, pikiran, dan kehidupan melalui tulisan, buku, konsultasi, pendampingan, dan kolaborasi.";

const latestArticles = [...articles]
  .sort((a,b)=>b.number-a.number)
  .slice(0,3);
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>{title}</title>

<meta name="description" content={description}/>

<link rel="canonical" href="https://rakan.my.id/"/>

<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:type" content="website"/>
<meta property="og:image" content="/images/profile/rakan-portrait.jpg"/>

<meta name="twitter:card" content="summary_large_image"/>

<link rel="icon" href="/favicon-rakan.png"/>

</head>

<body>

<Nav/>

<main>

<!-- HERO -->

<section class="hero">

<div class="container">

<div class="eyebrow">
RAKAN
</div>

<div class="role">
Apoteker & Praktisi Penyembuhan Holistik
</div>

<h1>
Mendampingi manusia memahami
<em>proses penyembuhan secara utuh.</em>
</h1>

<p class="lead">
Tubuh, otak, pikiran, dan kehidupan saling memengaruhi.
RAKAN menjadi ruang untuk memahami hubungan itu melalui tulisan,
buku,
konsultasi,
pendampingan,
dan kolaborasi.
</p>

<div class="actions">

<a href="/tulisan" class="button primary">
Jelajahi Tulisan
</a>

<a href="/layanan" class="button secondary">
Lihat Layanan
</a>

<a href="/about" class="button secondary">
Tentang Rakan
</a>

</div>

</div>

</section>

<!-- EMPAT DUNIA -->

<section class="section">

<div class="container">

<div class="eyebrow">
EMPAT DUNIA RAKAN
</div>

<h2>
Empat pintu masuk menuju perpustakaan.
</h2>

<p class="section-intro">
Seluruh artikel di RAKAN dibangun di atas empat dunia yang saling terhubung.
Inilah fondasi Peta RAKAN.
</p>

<div class="grid4">

<a href="/tulisan/kategori/tubuh" class="card">

<h3>Tubuh</h3>

<p>
Farmasi, obat, nutrisi, aktivitas, tidur, dan pemulihan.
</p>

</a>

<a href="/tulisan/kategori/otak" class="card">

<h3>Otak</h3>

<p>
Tidur, memori, perhatian, dan neurosains.
</p>

</a>

<a href="/tulisan/kategori/pikiran" class="card">

<h3>Pikiran</h3>

<p>
Emosi, stres, kebiasaan, dan perubahan.
</p>

</a>

<a href="/tulisan/kategori/kehidupan" class="card">

<h3>Kehidupan</h3>

<p>
Relasi, keluarga, pekerjaan, dan makna.
</p>

</a>

</div>

</div>

</section>

<!-- PENYEMBUHAN HOLISTIK -->

<section class="section alt">

<div class="container">

<div class="eyebrow">
PENDEKATAN
</div>

<h2>
Penyembuhan holistik tidak menggantikan pengobatan.
</h2>

<p class="section-intro">
Sebagai apoteker, saya memandang obat, diagnosis, dan bukti ilmiah tetap memiliki tempat yang penting.
Pendekatan holistik hadir untuk membantu memahami manusia secara lebih utuh,
bukan menggantikan pelayanan medis yang diperlukan.
</p>

<a href="/holistik" class="text-link">
Memahami penyembuhan holistik →
</a>

</div>

</section>

<!-- TULISAN TERBARU -->

<section class="section">

<div class="container">

<div class="eyebrow">
TULISAN TERBARU
</div>

<h2>
Mulai dari satu pertanyaan.
</h2>

<div class="article-list">

{latestArticles.map((article) => (

<a href={article.href} class="article">

<div class="article-category">
{article.category}
</div>

<h3>{article.title}</h3>

<p>{article.description}</p>

<div class="more">
Baca →
</div>

</a>

))}

</div>

<a href="/tulisan" class="text-link">
Lihat seluruh perpustakaan →
</a>

</div>

</section>

<!-- BUKU -->

<section class="section">

<div class="container">

<div class="eyebrow">
BUKU
</div>

<h2>
Sebagian percakapan membutuhkan lebih dari satu halaman.
</h2>

<p class="section-intro">
Buku menjadi ruang yang lebih panjang ketika satu artikel tidak lagi cukup.
</p>

<a href="/buku" class="text-link">
Lihat Buku →
</a>

</div>

</section>

<!-- LAYANAN -->

<section class="section">

<div class="container">

<div class="eyebrow">
LAYANAN
</div>

<h2>
Kalau ingin berjalan lebih jauh.
</h2>

<div class="grid3">

<div class="service">

<h3>Konsultasi</h3>

<p>
Awal percakapan untuk memahami persoalan.
</p>

</div>

<div class="service">

<h3>Pendampingan</h3>

<p>
Lanjutan ketika satu percakapan belum cukup.
</p>

</div>

<div class="service">

<h3>Kolaborasi</h3>

<p>
Seminar, workshop, training, dan kelas.
</p>

</div>

</div>

<a href="/layanan" class="text-link">
Lihat Layanan →
</a>

</div>

</section>

<!-- CTA -->

<section class="cta">

<div class="container">

<div class="eyebrow">
MULAI DARI SATU PERCAKAPAN
</div>

<h2>
Setiap langkah dimulai dari memahami konteks.
</h2>

<p class="section-intro">
Kadang satu konsultasi sudah cukup.
Kadang perjalanan memang membutuhkan waktu lebih panjang.
</p>

<div class="actions">

<a href="/layanan" class="button primary">
Konsultasi
</a>

<a href="/kolaborasi" class="button secondary">
Kolaborasi
</a>

</div>

</div>

</section>

</main>

<Footer/>

</body>

</html>

<style>

:global(*){box-sizing:border-box;}

:global(html){
scroll-behavior:smooth;
}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

.hero{
padding:100px 0;
border-bottom:1px solid #E5DFD5;
}

.section{
padding:90px 0;
border-bottom:1px solid #E5DFD5;
}

.alt{
background:#F1ECE5;
}

.cta{
padding:95px 0;
background:#EBE5DC;
}

.eyebrow{
margin-bottom:22px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

.role{
margin-bottom:18px;
color:#514C45;
font-size:14px;
font-weight:600;
letter-spacing:.08em;
text-transform:uppercase;
}

h1,h2,h3{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
font-size:clamp(52px,7vw,82px);
line-height:1.05;
letter-spacing:-.03em;
}

h1 em{
display:block;
font-style:italic;
color:#756653;
}

h2{
margin-bottom:24px;
font-size:clamp(36px,5vw,52px);
line-height:1.15;
}

h3{
margin-bottom:14px;
font-size:28px;
}

.lead,
.section-intro,
p{
color:#514C45;
line-height:1.8;
font-size:17px;
}

.grid4{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:24px;
margin-top:42px;
}

.grid3{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:24px;
margin-top:42px;
}

.card,
.service{
display:block;
padding:30px;
background:#F7F4EE;
border:1px solid #E5DFD5;
text-decoration:none;
color:inherit;
transition:.25s;
}

.card:hover{
transform:translateY(-3px);
border-color:#7A2635;
}

.article-list{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:28px;
margin-top:42px;
}

.article{
display:block;
padding:26px;
border:1px solid #E5DFD5;
text-decoration:none;
color:inherit;
transition:.25s;
}

.article:hover{
transform:translateY(-3px);
border-color:#7A2635;
}

.article-category{
margin-bottom:12px;
color:#81776A;
font-size:10px;
font-weight:600;
letter-spacing:.13em;
text-transform:uppercase;
}

.more{
margin-top:18px;
color:#7A2635;
}

.text-link{
display:inline-block;
margin-top:28px;
color:#201D19;
text-decoration:none;
border-bottom:1px solid #C8BBAA;
padding-bottom:4px;
}

.actions{
display:flex;
gap:14px;
flex-wrap:wrap;
margin-top:34px;
}

.button{
display:inline-block;
padding:15px 24px;
text-decoration:none;
transition:.2s;
}

.button.primary{
background:#7A2635;
color:white;
}

.button.primary:hover{
background:#201D19;
}

.button.secondary{
background:transparent;
border:1px solid #D8D0C5;
color:#201D19;
}

.button.secondary:hover{
background:#F1ECE5;
}

@media(max-width:900px){

.container{
padding:0 20px;
}

.hero,
.section,
.cta{
padding:70px 0;
}

h1{
font-size:42px;
}

.grid4,
.grid3,
.article-list{
grid-template-columns:1fr;
}

.actions{
flex-direction:column;
}

.button{
text-align:center;
}

}

@media(max-width:390px){

.container{
padding:0 18px;
}

.hero,
.section,
.cta{
padding:58px 0;
}

h1{
font-size:34px;
}

h2{
font-size:28px;
}

.lead,
.section-intro,
p{
font-size:15px;
}

.card,
.service,
.article{
padding:22px;
}

}

</style>