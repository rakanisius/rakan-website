---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const title = "Rakan | Praktisi Kesehatan Holistik";
---

<!doctype html>
<html lang="id">
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="icon" type="image/png" href="/favicon-rakan.png" />
  <link rel="shortcut icon" type="image/png" href="/favicon-rakan.png" />
  <link rel="apple-touch-icon" href="/favicon-rakan.png" />

  <title>{title}</title>
    <meta
      name="description"
      content="Rakan adalah praktisi kesehatan holistik yang mendampingi manusia memahami dirinya secara utuh."
    />
  </head>

  <body>
    <Nav />

    <main>

      <!-- =========================
           HERO
           ========================= -->

      <section class="hero">
        <div class="hero-inner">

          <p class="eyebrow">
            RAKAN · PRAKTISI KESEHATAN HOLISTIK
          </p>

          <h1>
            <span>Memahami manusia</span>
            <em>secara utuh.</em>
          </h1>

          <p class="hero-text">
            Mendampingi manusia memahami tubuh, pikiran, dan kehidupan
            dengan pendekatan yang utuh, manusiawi, dan tetap berpijak
            pada pengetahuan.
          </p>

          <a href="/about" class="hero-link">
            Mengenal Rakan →
          </a>

        </div>
      </section>


      <!-- =========================
           TENTANG
           ========================= -->

      <section class="section about">

        <div class="section-label">
          01 · TENTANG
        </div>

        <div class="section-content">

          <h2>
            <span>Mengenal manusia sebelum</span>
            <em>sekadar melihat masalahnya.</em>
          </h2>

          <p>
            Kesehatan bukan hanya tentang ada atau tidak adanya penyakit.
            Di balik setiap keluhan ada tubuh, pikiran, kebiasaan,
            lingkungan, hubungan, dan kehidupan seseorang.
          </p>

          <p>
            Rakan hadir untuk melihat manusia dalam keseluruhan konteks
            tersebut.
          </p>

          <a href="/about" class="text-link">
            Tentang Rakan →
          </a>

        </div>

      </section>


      <!-- =========================
           TIGA RUANG
           ========================= -->

      <section class="section worlds">

        <div class="section-label">
          02 · PENDEKATAN
        </div>

        <div class="section-content">

          <h2>
            <span>Tiga ruang untuk</span>
            <em>memahami manusia.</em>
          </h2>

          <div class="world-grid">

            <article class="world-card">

              <span class="card-number">01</span>

              <h3>Tubuh</h3>

              <p>
                Memahami tubuh, gejala, obat, kebiasaan, tidur,
                nutrisi, aktivitas, dan proses pemulihan.
              </p>

            </article>


            <article class="world-card">

              <span class="card-number">02</span>

              <h3>Pikiran</h3>

              <p>
                Memahami cara pikiran, emosi, persepsi, dan pengalaman
                memengaruhi cara manusia menjalani hidup.
              </p>

            </article>


            <article class="world-card">

              <span class="card-number">03</span>

              <h3>Kehidupan</h3>

              <p>
                Memahami manusia dalam relasi, pekerjaan, lingkungan,
                nilai, tujuan, dan makna kehidupan.
              </p>

            </article>

          </div>

        </div>

      </section>


      <!-- =========================
           HOLISTIK
           ========================= -->

      <section class="section philosophy">

        <div class="section-label">
          03 · FILOSOFI
        </div>

        <div class="section-content">

          <h2>
            <span>Holistik bukan berarti</span>
            <em>meninggalkan sains.</em>
          </h2>

          <div class="philosophy-grid">

            <div>

              <p class="large-text">
                Pendekatan holistik berusaha melihat manusia secara
                lebih lengkap, bukan menggantikan ilmu kedokteran.
              </p>

            </div>


            <div>

              <p>
                Obat tetap memiliki tempat. Diagnosis tetap penting.
                Bukti ilmiah tetap menjadi dasar untuk memahami apa
                yang dapat dan tidak dapat kita katakan tentang
                kesehatan.
              </p>

              <p>
                Pendekatan holistik menambahkan satu hal:
                <strong>manusia di balik masalahnya.</strong>
              </p>

              <a href="/holistik" class="text-link">
                Memahami kesehatan holistik →
              </a>

            </div>

          </div>

        </div>

      </section>


      <!-- =========================
           TULISAN
           ========================= -->

      <section class="section writing">

        <div class="section-label">
          04 · TULISAN
        </div>

        <div class="section-content">

          <h2>
            <span>Ruang untuk</span>
            <em>berpikir.</em>
          </h2>

          <div class="article-list">

            <a
              href="/tulisan/tubuh-tidak-pernah-bekerja-sendirian"
              class="article-item"
            >

              <div class="article-number">
                01
              </div>

              <div class="article-main">

                <div class="article-category">
                  TUBUH & KESEHATAN
                </div>

                <h3>
                  Tubuh tidak pernah bekerja sendirian.
                </h3>

                <p>
                  Tubuh manusia bukan kumpulan organ yang bekerja
                  sendiri-sendiri. Ada hubungan yang jauh lebih
                  kompleks di antara semuanya.
                </p>

              </div>

              <div class="article-arrow">
                ↗
              </div>

            </a>

          </div>

          <a href="/tulisan" class="text-link">
            Semua tulisan →
          </a>

        </div>

      </section>


      <!-- =========================
           BUKU
           ========================= -->

      <section class="section books">

        <div class="section-label">
          05 · BUKU
        </div>

        <div class="section-content">

          <h2>
            <span>Buku untuk</span>
            <em>berhenti sejenak.</em>
          </h2>

          <div class="book-feature">

            <div class="book-number">
              01
            </div>

            <div class="book-info">

              <div class="book-category">
                BUKU
              </div>

              <h3>
                Tuhan, wafatkan aku di usia 63 Tahun!
              </h3>

              <p class="book-author">
                Abdul Rakan
              </p>

              <p>
                Sebuah perjalanan tentang waktu, kematian,
                kehidupan, dan bagaimana manusia memilih untuk
                menggunakan sisa hidupnya.
              </p>

              <a href="/buku" class="text-link">
                Lihat buku →
              </a>

            </div>

          </div>

        </div>

      </section>


      <!-- =========================
           LAYANAN
           ========================= -->

      <section class="section services">

        <div class="section-label">
          06 · LAYANAN
        </div>

        <div class="section-content">

          <h2>
            <span>Jika ingin berjalan</span>
            <em>lebih jauh.</em>
          </h2>

          <div class="service-grid">

            <article>

              <span class="card-number">
                01
              </span>

              <h3>
                Konsultasi
              </h3>

              <p>
                Ruang percakapan untuk memahami persoalan kesehatan
                secara lebih menyeluruh.
              </p>

            </article>


            <article>

              <span class="card-number">
                02
              </span>

              <h3>
                Coaching
              </h3>

              <p>
                Pendampingan untuk membantu seseorang bergerak dari
                pemahaman menuju perubahan.
              </p>

            </article>


            <article>

              <span class="card-number">
                03
              </span>

              <h3>
                Mentoring
              </h3>

              <p>
                Proses pendampingan yang lebih panjang untuk
                pertumbuhan pribadi dan kesehatan.
              </p>

            </article>

          </div>

          <a href="/layanan" class="text-link">
            Lihat layanan →
          </a>

        </div>

      </section>


      <!-- =========================
           KONTAK
           ========================= -->

      <section class="contact">

        <div class="contact-inner">

          <p class="eyebrow">
            MULAI DARI SEBUAH PERCAKAPAN
          </p>

          <h2>
            <span>Mari mulai sebuah</span>
            <em>percakapan.</em>
          </h2>

          <p>
            Jika ada hal yang ingin dibicarakan tentang kesehatan,
            kehidupan, atau perjalanan memahami diri sendiri,
            Rakan menyediakan ruang untuk itu.
          </p>

          <a href="/kontak" class="contact-button">
            Hubungi Rakan →
          </a>

        </div>

      </section>

    </main>

    <Footer />

  </body>
</html>


<style>

  /* =========================
     RESET
     ========================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  :global(body) {
    margin: 0;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    background: #f7f4ee;
    color: #201d19;
    font-family: Arial, Helvetica, sans-serif;
  }

  :global(img) {
    max-width: 100%;
    height: auto;
  }

  :global(a) {
    transition: all 0.2s ease;
  }


  /* =========================
     TYPOGRAPHY
     ========================= */

  h1,
  h2,
  h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  h1 span,
  h2 span {
    display: block;
  }

  h1 em,
  h2 em {
    display: block;
    color: #766653;
    font-style: italic;
  }


  /* =========================
     HERO
     ========================= */

  .hero {
    width: 100%;
    min-height: 78vh;
    display: flex;
    align-items: center;
    padding: 110px 32px;
    border-bottom: 1px solid #e1dbd0;
  }

  .hero-inner {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 30px;
    color: #81776a;
    font-size: 12px;
    letter-spacing: 0.16em;
    line-height: 1.6;
  }

  .hero h1 {
    max-width: 950px;
    margin: 0;
    font-size: clamp(60px, 8vw, 112px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero-text {
    max-width: 650px;
    margin: 42px 0 0;
    color: #655f56;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-link,
  .text-link {
    display: inline-block;
    margin-top: 30px;
    color: #201d19;
    font-size: 14px;
    text-decoration: none;
    border-bottom: 1px solid #aaa092;
    padding-bottom: 4px;
  }

  .hero-link:hover,
  .text-link:hover {
    border-color: #201d19;
  }


  /* =========================
     GENERAL SECTION
     ========================= */

  .section {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 110px 32px;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 70px;
    border-bottom: 1px solid #e1dbd0;
  }

  .section-label {
    padding-top: 10px;
    color: #918678;
    font-size: 11px;
    letter-spacing: 0.15em;
  }

  .section-content {
    min-width: 0;
    width: 100%;
  }

  h2 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(48px, 6vw, 82px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }


  /* =========================
     ABOUT
     ========================= */

  .about .section-content > p {
    max-width: 700px;
    margin: 38px 0 0;
    color: #655f56;
    font-size: 18px;
    line-height: 1.85;
  }


  /* =========================
     THREE WORLDS
     ========================= */

  .world-grid {
    width: 100%;
    margin-top: 65px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .world-card {
    min-width: 0;
    min-height: 260px;
    padding: 30px;
    background: #eee9df;
  }

  .card-number {
    color: #918678;
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .world-card h3 {
    margin: 60px 0 18px;
    font-size: 32px;
  }

  .world-card p,
  .service-grid p {
    margin: 0;
    color: #655f56;
    font-size: 14px;
    line-height: 1.75;
  }


  /* =========================
     PHILOSOPHY
     ========================= */

  .philosophy-grid {
    width: 100%;
    margin-top: 65px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 80px;
  }

  .large-text {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    line-height: 1.45;
  }

  .philosophy-grid > div:last-child p {
    margin: 0 0 25px;
    color: #655f56;
    font-size: 16px;
    line-height: 1.8;
  }


  /* =========================
     ARTICLES
     ========================= */

  .article-list {
    width: 100%;
    margin-top: 65px;
    margin-bottom: 15px;
  }

  .article-item {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) 40px;
    gap: 25px;
    padding: 35px 0;
    border-top: 1px solid #d9d1c5;
    text-decoration: none;
    color: inherit;
  }

  .article-number {
    color: #918678;
    font-size: 12px;
  }

  .article-category,
  .book-category {
    margin-bottom: 12px;
    color: #918678;
    font-size: 11px;
    letter-spacing: 0.13em;
  }

  .article-main {
    min-width: 0;
  }

  .article-main h3 {
    margin: 0;
    font-size: 34px;
    line-height: 1.2;
  }

  .article-main p {
    max-width: 650px;
    margin: 15px 0 0;
    color: #655f56;
    line-height: 1.7;
  }

  .article-arrow {
    font-size: 22px;
    text-align: right;
  }


  /* =========================
     BOOK
     ========================= */

  .book-feature {
    width: 100%;
    min-width: 0;
    margin-top: 65px;
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 25px;
    padding: 45px;
    background: #eee9df;
  }

  .book-number {
    color: #918678;
    font-size: 12px;
  }

  .book-info {
    min-width: 0;
    max-width: 700px;
  }

  .book-info h3 {
    margin: 0;
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1.05;
  }

  .book-author {
    margin: 18px 0 25px;
    color: #81776a;
    font-size: 14px;
  }

  .book-info > p:not(.book-author) {
    max-width: 600px;
    color: #655f56;
    line-height: 1.8;
  }


  /* =========================
     SERVICES
     ========================= */

  .service-grid {
    width: 100%;
    margin-top: 65px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .service-grid article {
    min-width: 0;
    padding: 30px 0;
    border-top: 1px solid #d9d1c5;
  }

  .service-grid h3 {
    margin: 40px 0 15px;
    font-size: 30px;
  }


  /* =========================
     CONTACT
     ========================= */

  .contact {
    width: 100%;
    padding: 120px 32px;
    background: #e8e2d7;
  }

  .contact-inner {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
  }

  .contact h2 {
    max-width: 850px;
  }

  .contact-inner > p:not(.eyebrow) {
    max-width: 600px;
    margin: 35px 0 0;
    color: #655f56;
    font-size: 17px;
    line-height: 1.8;
  }

  .contact-button {
    display: inline-block;
    margin-top: 35px;
    padding: 15px 24px;
    background: #201d19;
    color: #f7f4ee;
    text-decoration: none;
    font-size: 14px;
  }

  .contact-button:hover {
    opacity: 0.85;
  }


  /* =========================
     TABLET
     ========================= */

  @media (max-width: 800px) {

    .hero {
      min-height: auto;
      padding: 70px 20px 75px;
    }

    .eyebrow {
      margin-bottom: 22px;
      font-size: 9px;
      letter-spacing: 0.11em;
    }

    .hero h1 {
      max-width: 100%;
      font-size: 46px;
      line-height: 1.04;
      letter-spacing: -0.035em;
    }

    .hero-text {
      max-width: 100%;
      margin-top: 28px;
      font-size: 15px;
      line-height: 1.75;
    }

    .section {
      width: 100%;
      padding: 70px 20px;
      display: block;
    }

    .section-label {
      margin-bottom: 25px;
      padding-top: 0;
    }

    h2 {
      max-width: 100%;
      font-size: 36px;
      line-height: 1.12;
      letter-spacing: -0.025em;
    }

    .about .section-content > p {
      max-width: 100%;
      margin-top: 25px;
      font-size: 15px;
      line-height: 1.75;
    }


    /* THREE WORLDS */

    .world-grid {
      margin-top: 40px;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .world-card {
      width: 100%;
      min-height: auto;
      padding: 25px;
    }

    .world-card h3 {
      margin: 34px 0 13px;
      font-size: 27px;
    }

    .world-card p {
      font-size: 14px;
    }


    /* PHILOSOPHY */

    .philosophy-grid {
      margin-top: 40px;
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .large-text {
      font-size: 24px;
      line-height: 1.5;
    }

    .philosophy-grid > div:last-child p {
      font-size: 15px;
      line-height: 1.75;
    }


    /* ARTICLES */

    .article-list {
      margin-top: 40px;
    }

    .article-item {
      grid-template-columns: 28px minmax(0, 1fr) 20px;
      gap: 10px;
      padding: 25px 0;
    }

    .article-main h3 {
      font-size: 23px;
      line-height: 1.25;
    }

    .article-main p {
      font-size: 14px;
      line-height: 1.7;
    }

    .article-arrow {
      font-size: 17px;
    }


    /* BOOK */

    .book-feature {
      margin-top: 40px;
      padding: 25px;
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .book-info h3 {
      font-size: 30px;
      line-height: 1.12;
    }

    .book-info > p:not(.book-author) {
      font-size: 14px;
      line-height: 1.75;
    }


    /* SERVICES */

    .service-grid {
      margin-top: 40px;
      grid-template-columns: 1fr;
      gap: 0;
    }

    .service-grid article {
      padding: 24px 0;
    }

    .service-grid h3 {
      margin: 25px 0 12px;
      font-size: 25px;
    }


    /* CONTACT */

    .contact {
      padding: 75px 20px;
    }

    .contact h2 {
      max-width: 100%;
      font-size: 36px;
    }

    .contact-inner > p:not(.eyebrow) {
      max-width: 100%;
      margin-top: 28px;
      font-size: 15px;
      line-height: 1.75;
    }

    .contact-button {
      margin-top: 30px;
    }

  }


  /* =========================
     IPHONE 12 MINI
     375px
     ========================= */

  @media (max-width: 390px) {

    .hero {
      padding: 58px 18px 65px;
    }

    .hero-inner {
      width: 100%;
      max-width: 100%;
    }

    .eyebrow {
      margin-bottom: 20px;
      font-size: 8px;
      letter-spacing: 0.09em;
    }

    .hero h1 {
      width: 100%;
      max-width: 100%;
      font-size: 38px;
      line-height: 1.07;
      letter-spacing: -0.025em;
    }

    .hero-text {
      margin-top: 25px;
      font-size: 14px;
      line-height: 1.7;
    }

    .hero-link {
      margin-top: 25px;
      font-size: 13px;
    }


    .section {
      width: 100%;
      padding: 58px 18px;
    }

    .section-label {
      margin-bottom: 22px;
      font-size: 9px;
      letter-spacing: 0.11em;
    }

    h2 {
      width: 100%;
      max-width: 100%;
      font-size: 31px;
      line-height: 1.14;
      letter-spacing: -0.02em;
    }


    /* ABOUT */

    .about .section-content > p {
      margin-top: 22px;
      font-size: 14px;
      line-height: 1.72;
    }


    /* WORLDS */

    .world-grid {
      margin-top: 35px;
      gap: 12px;
    }

    .world-card {
      padding: 22px;
    }

    .world-card h3 {
      margin: 30px 0 12px;
      font-size: 24px;
    }

    .world-card p {
      font-size: 13px;
      line-height: 1.7;
    }


    /* PHILOSOPHY */

    .philosophy-grid {
      margin-top: 35px;
      gap: 30px;
    }

    .large-text {
      font-size: 21px;
      line-height: 1.5;
    }

    .philosophy-grid > div:last-child p {
      font-size: 14px;
    }


    /* ARTICLES */

    .article-list {
      margin-top: 35px;
    }

    .article-item {
      grid-template-columns: 24px minmax(0, 1fr) 16px;
      gap: 8px;
      padding: 22px 0;
    }

    .article-number {
      font-size: 10px;
    }

    .article-category {
      margin-bottom: 9px;
      font-size: 9px;
      letter-spacing: 0.09em;
    }

    .article-main h3 {
      font-size: 21px;
      line-height: 1.28;
    }

    .article-main p {
      margin-top: 12px;
      font-size: 13px;
      line-height: 1.7;
    }

    .article-arrow {
      font-size: 15px;
    }


    /* BOOK */

    .book-feature {
      margin-top: 35px;
      padding: 22px;
    }

    .book-category {
      font-size: 9px;
    }

    .book-info h3 {
      font-size: 27px;
      line-height: 1.14;
    }

