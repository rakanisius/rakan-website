const description =
  "Sebuah benturan di jalan berubah menjadi pelajaran tentang harga diri, keberanian, dan cara memahami diri secara lebih utuh.";
const image = "/images/memilih-pergi-tidak-selalu-takut.png";
---

<!doctype html>
<html lang="id">
  <head>
