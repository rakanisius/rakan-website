---
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const articles = [
  {
    number: "01",
    category: "TUBUH & KESEHATAN",
    title: "Tubuh tidak pernah bekerja sendirian.",
    description:
      "Tubuh bukan sekadar kumpulan organ yang bekerja sendiri-sendiri. Ia adalah sebuah sistem yang terus berkomunikasi dengan pikiran, kebiasaan, lingkungan, dan kehidupan kita.",
    href: "/tulisan/tubuh-tidak-pernah-bekerja-sendirian",
  },
  {
    number: "02",
    category: "KEHIDUPAN",
    title: "Ketika Kita Merasa Lebih Tinggi dari Orang Lain",
    description:
      "Tentang jabatan, status, kekuasaan, dan bagaimana kita memperlakukan manusia lain ketika merasa berada di posisi yang lebih tinggi.",
    href: "/tulisan/ketika-kita-merasa-lebih-tinggi-dari-orang-lain",
  },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href="/favicon-rakan.png" />
<link rel="shortcut icon" type="image/png" href="/favicon-rakan.png" />
<link rel="apple-touch-icon" href="/favicon-rakan.png" />
    <title>Tulisan | RAKAN</title>

    <meta
      name="description"
      content="Catatan Rakan tentang tubuh, pikiran, kesehatan, obat, kebiasaan, dan kehidupan."
    />
  </head>

  <body>

    <Nav />

    <main>

      <!-- HERO -->
      <section class="hero">

        <div class="hero-inner">

          <div class="eyebrow">
            RUANG TULISAN RAKAN
          </div>

          <h1>
            <span>Memahami kesehatan,</span>
            <span><em>manusia,</em></span>
            <em>dan kehidupan.</em>
          </h1>

          <p class="intro">
            Catatan tentang tubuh, pikiran, kesehatan, obat, kebiasaan,
            dan perjalanan manusia memahami dirinya sendiri.
          </p>

        </div>

      </section>


      <!-- ARTICLES -->
      <section class="articles-section">

        <div class="articles">

          {articles.map((article) => (
            <article class="article">

              <div class="number">
                {article.number}
              </div>

              <div class="article-content">

                <div class="category">
                  {article.category}
                </div>

                <h2>
                  {article.title}
                </h2>

                <p class="description">
                  {article.description}
                </p>

              </div>

              <a class="read" href={article.href}>
                Baca tulisan →
              </a>

            </article>
          ))}

        </div>

      </section>

    </main>

    <Footer />

  </body>
</html>


<style>

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    overflow-x: hidden;
  }

  :global(body) {
    margin: 0;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    background: #f7f4ee;
    color: #29251f;
    font-family: Arial, Helvetica, sans-serif;
  }


  /* HERO */

  .hero {
    width: 100%;
    padding: 100px 32px 90px;
    border-bottom: 1px solid #dcd5ca;
  }

  .hero-inner {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
  }

  .eyebrow {
    margin-bottom: 25px;
    color: #756d62;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  h1 span,
  h1 em {
    display: block;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(50px, 7vw, 86px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  h1 em {
    color: #756653;
    font-style: italic;
  }

  .intro {
    max-width: 650px;
    margin: 32px 0 0;
    color: #655f56;
    font-size: 17px;
    line-height: 1.8;
  }


  /* ARTICLES */

  .articles-section {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 85px 32px 110px;
  }

  .articles {
    width: 100%;
    border-top: 1px solid #dcd5ca;
  }

  .article {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) 110px;
    gap: 25px;
    padding: 38px 0;
    border-bottom: 1px solid #dcd5ca;
  }

  .number {
    color: #8b8174;
    font-family: Georgia, serif;
    font-size: 17px;
  }

  .article-content {
    min-width: 0;
  }

  .category {
    margin-bottom: 13px;
    color: #81776a;
    font-size: 10px;
    letter-spacing: 0.13em;
  }

  h2 {
    font-size: clamp(27px, 4vw, 43px);
    line-height: 1.12;
  }

  .description {
    max-width: 650px;
    margin: 16px 0 0;
    color: #655f56;
    font-size: 15px;
    line-height: 1.75;
  }

  .read {
    align-self: center;
    color: #29251f;
    text-decoration: none;
    font-size: 13px;
    white-space: nowrap;
  }

  .read:hover {
    text-decoration: underline;
  }


  /* MOBILE */

  @media (max-width: 800px) {

    .hero {
      padding: 70px 20px 65px;
    }

    .eyebrow {
      margin-bottom: 21px;
      font-size: 9px;
      letter-spacing: 0.11em;
    }

    h1 {
      font-size: 42px;
      line-height: 1.08;
    }

    .intro {
      margin-top: 27px;
      font-size: 15px;
      line-height: 1.75;
    }

    .articles-section {
      padding: 60px 20px 80px;
    }

    .article {
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 10px;
      padding: 28px 0;
    }

    .number {
      font-size: 11px;
    }

    .read {
      grid-column: 2;
      margin-top: 5px;
      font-size: 13px;
    }

    h2 {
      font-size: 24px;
      line-height: 1.25;
    }

    .description {
      font-size: 14px;
      line-height: 1.7;
    }

  }


  /* IPHONE 12 MINI */

  @media (max-width: 390px) {

    .hero {
      padding: 58px 18px 60px;
    }

    .eyebrow {
      font-size: 8px;
      letter-spacing: 0.09em;
    }

    h1 {
      font-size: 34px;
      line-height: 1.1;
    }

    .intro {
      font-size: 14px;
    }

    .articles-section {
      padding: 52px 18px 70px;
    }

    .article {
      grid-template-columns: 22px minmax(0, 1fr);
      gap: 8px;
      padding: 24px 0;
    }

    .category {
      margin-bottom: 9px;
      font-size: 8px;
      letter-spacing: 0.09em;
    }

    h2 {
      font-size: 21px;
      line-height: 1.28;
    }

    .description {
      margin-top: 12px;
      font-size: 13px;
      line-height: 1.7;
    }

    .read {
      font-size: 12px;
    }

  }

</style>