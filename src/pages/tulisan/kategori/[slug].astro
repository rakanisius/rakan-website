---
export const prerender = true;

import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { articles, categories } from "../../../data/articles";

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
  }));
}

const { slug } = Astro.params;

const category = categories.find((c) => c.slug === slug);

if (!category) {
  return Astro.redirect("/tulisan");
}

const categoryArticles = articles
  .filter((a) => a.slug === slug)
  .sort((a, b) => b.number - a.number);

const worldLinks = categories.filter((c)=>c.slug!==slug);
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>{category.title} | Perpustakaan RAKAN</title>

<meta name="description" content={category.description}/>

<link rel="canonical" href={`https://rakan.my.id/tulisan/kategori/${slug}`}/>

<meta property="og:title" content={`${category.title} | Perpustakaan RAKAN`}/>
<meta property="og:description" content={category.description}/>
<meta property="og:type" content="website"/>
<meta property="og:image" content="/images/og-library.jpg"/>

<meta name="twitter:card" content="summary_large_image"/>

<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/>
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/>

</head>

<body>

<Nav/>

<main>

<!-- HERO -->

<section class="hero">

<div class="container">

<a href="/tulisan" class="back">
← Kembali ke Perpustakaan
</a>

<div class="eyebrow">
DUNIA RAKAN
</div>

<h1>{category.title}</h1>

<p class="intro">
{category.description}
</p>

<p class="count">
{String(categoryArticles.length).padStart(2,"0")} tulisan
</p>

</div>

</section>

<!-- NAVIGASI EMPAT DUNIA -->

<section class="world-nav">

<div class="container">

<div class="eyebrow">
DUNIA LAIN
</div>

<div class="world-grid">

{worldLinks.map((item)=>(

<a
href={`/tulisan/kategori/${item.slug}`}
class="world-card"
>

<h3>{item.title}</h3>

<p>{item.description}</p>

</a>

))}

</div>

</div>

</section>

<!-- DAFTAR ARTIKEL -->

<section class="list">

<div class="container">

<div class="eyebrow">
JELAJAHI TULISAN
</div>

{categoryArticles.length>0 ? (

<div class="articles">

{categoryArticles.map((item)=>(

<a href={item.href} class="article">

<div class="number">
{String(item.number).padStart(2,"0")}
</div>

<div class="article-content">

<h2>{item.title}</h2>

<p class="description">
{item.description}
</p>

<div class="more">
Baca →
</div>

</div>

</a>

))}

</div>

) : (

<div class="empty">

<h2>Dunia ini sedang dibangun.</h2>

<p>
Kategori ini sudah menjadi bagian dari Peta RAKAN.
Tulisan pertama akan hadir di sini.
</p>

</div>

)}

</div>

</section>

<!-- CTA -->

<section class="cta">

<div class="container narrow">

<div class="eyebrow">
LANJUTKAN PERJALANAN
</div>

<h2>
Satu dunia selesai.
Masih ada dunia lain untuk dijelajahi.
</h2>

<p>
Setiap kategori adalah bagian dari perpustakaan yang saling terhubung.
Anda bisa kembali ke Peta RAKAN,
melanjutkan membaca artikel,
atau menemukan perjalanan berikutnya melalui buku dan layanan.
</p>

<div class="actions">

<a href="/tulisan" class="button primary">
Kembali ke Perpustakaan
</a>

<a href="/buku" class="button secondary">
Lihat Buku
</a>

<a href="/layanan" class="button secondary">
Lihat Layanan
</a>

</div>

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>

:global(*){box-sizing:border-box;}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

.narrow{
max-width:760px;
}

/* HERO */

.hero{
padding:90px 0;
border-bottom:1px solid #E5DFD5;
}

.back{
display:inline-block;
margin-bottom:28px;
text-decoration:none;
color:#514C45;
font-size:14px;
}

.back:hover{
color:#201D19;
}

/* SECTION */

.world-nav,
.list{
padding:70px 0;
border-bottom:1px solid #E5DFD5;
}

.cta{
padding:90px 0;
background:#EBE5DC;
}

/* TYPOGRAPHY */

.eyebrow{
margin-bottom:24px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1,h2,h3{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
font-size:clamp(46px,6vw,72px);
line-height:1.05;
letter-spacing:-.03em;
}

h2{
font-size:clamp(34px,5vw,48px);
line-height:1.15;
margin-bottom:22px;
}

h3{
font-size:28px;
line-height:1.2;
margin-bottom:10px;
}

.intro,
p{
color:#514C45;
font-size:17px;
line-height:1.85;
}

.count{
margin-top:26px;
color:#7A2635;
font-size:12px;
letter-spacing:.12em;
text-transform:uppercase;
font-weight:600;
}

/* WORLD */

.world-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:24px;
}

.world-card{
display:block;
padding:26px;
border:1px solid #E5DFD5;
background:#F7F4EE;
text-decoration:none;
color:inherit;
transition:.25s;
}

.world-card:hover{
transform:translateY(-3px);
border-color:#7A2635;
}

/* ARTICLE */

.articles{
border-top:1px solid #E5DFD5;
margin-top:30px;
}

.article{
display:grid;
grid-template-columns:60px minmax(0,1fr);
gap:24px;
padding:30px 0;
border-bottom:1px solid #E5DFD5;
text-decoration:none;
color:inherit;
transition:.2s;
}

.article:hover{
transform:translateY(-2px);
}

.article:hover h2{
color:#7A2635;
}

.number{
font-family:Georgia,serif;
color:#8B8174;
}

.description{
margin-top:14px;
font-size:15px;
line-height:1.8;
}

.more{
margin-top:14px;
color:#7A2635;
font-size:14px;
}

.empty{
padding:40px 0;
max-width:640px;
}

/* CTA */

.actions{
display:flex;
gap:14px;
flex-wrap:wrap;
margin-top:30px;
}

.button{
display:inline-block;
padding:15px 24px;
text-decoration:none;
transition:.2s;
}

.button.primary{
background:#7A2635;
color:white;
}

.button.primary:hover{
background:#201D19;
}

.button.secondary{
background:transparent;
border:1px solid #D8D0C5;
color:#201D19;
}

.button.secondary:hover{
background:#F1ECE5;
}

/* RESPONSIVE */

@media(max-width:800px){

.container{
padding:0 20px;
}

.hero,
.world-nav,
.list,
.cta{
padding:70px 0;
}

h1{
font-size:42px;
}

.world-grid{
grid-template-columns:1fr;
}

.article{
grid-template-columns:36px minmax(0,1fr);
}

.actions{
flex-direction:column;
}

.button{
text-align:center;
}

}

@media(max-width:390px){

.container{
padding:0 18px;
}

.hero,
.world-nav,
.list,
.cta{
padding:58px 0;
}

h1{
font-size:34px;
}

h2{
font-size:28px;
}

.intro,
p{
font-size:15px;
}

.world-card{
padding:22px;
}

.article{
grid-template-columns:26px minmax(0,1fr);
}

}

</style>