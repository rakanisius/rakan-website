---
export const prerender = true;

import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { articles, categories } from "../../../data/articles";

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
  }));
}

const { slug } = Astro.params;

const category = categories.find((c) => c.slug === slug);

if (!category) {
  return Astro.redirect("/tulisan");
}

const categoryArticles = articles
  .filter((a) => a.slug === slug)
  .sort((a, b) => b.number - a.number);
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<link rel="icon" href="/favicon-rakan.png"/>

<title>{category.title} | RAKAN</title>

<meta name="description" content={category.description}/>

</head>

<body>

<Nav/>

<main>

<section class="hero">

<div class="container">

<a href="/tulisan" class="back">
← Semua tulisan
</a>

<div class="eyebrow">
KATEGORI
</div>

<h1>{category.title}</h1>

<p class="intro">
{category.description}
</p>

<p class="count">
{String(categoryArticles.length).padStart(2,"0")} tulisan
</p>

</div>

</section>

<section class="list">

<div class="container">

{categoryArticles.length > 0 ? (

categoryArticles.map((item)=>(

<a href={item.href} class="article">

<div class="number">
{String(item.number).padStart(2,"0")}
</div>

<div class="article-content">

<h2>{item.title}</h2>

<p class="description">
{item.description}
</p>

<div class="more">
Baca tulisan →
</div>

</div>

</a>

))

) : (

<div class="empty">

<h2>Tulisan akan segera hadir.</h2>

<p>
Kategori ini sudah disiapkan sebagai bagian dari peta pengetahuan RAKAN.
Tulisan pertama akan hadir di sini.
</p>

</div>

)}

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>

:global(*){box-sizing:border-box;}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

.hero{
padding:90px 0;
border-bottom:1px solid #E5DFD5;
}

.back{
display:inline-block;
margin-bottom:24px;
text-decoration:none;
color:#514C45;
font-size:14px;
}

.back:hover{
color:#201D19;
}

.eyebrow{
margin-bottom:20px;
color:#7A2635;
font-size:11px;
letter-spacing:.16em;
text-transform:uppercase;
font-weight:600;
}

h1,h2{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
font-size:clamp(44px,6vw,72px);
line-height:1.05;
letter-spacing:-.03em;
}

.intro{
margin-top:28px;
max-width:640px;
line-height:1.8;
color:#514C45;
font-size:17px;
}

.count{
margin-top:24px;
color:#7A2635;
font-size:12px;
letter-spacing:.12em;
text-transform:uppercase;
font-weight:600;
}

.list{
padding:60px 0 100px;
}

.article{
display:grid;
grid-template-columns:60px minmax(0,1fr);
gap:28px;
padding:28px 0;
border-bottom:1px solid #E5DFD5;
text-decoration:none;
color:inherit;
transition:.2s;
}

.article:hover{
transform:translateY(-2px);
}

.article:hover h2{
color:#7A2635;
}

.number{
font-family:Georgia,serif;
font-size:16px;
color:#8B8174;
}

.article h2{
font-size:34px;
line-height:1.18;
}

.description{
margin-top:12px;
color:#514C45;
line-height:1.8;
font-size:15px;
}

.more{
margin-top:14px;
font-size:14px;
color:#514C45;
}

.empty{
padding:40px 0;
max-width:640px;
}

.empty h2{
font-size:34px;
margin-bottom:18px;
}

.empty p{
color:#514C45;
line-height:1.8;
}

@media(max-width:800px){

.container{
padding:0 20px;
}

.article{
grid-template-columns:36px minmax(0,1fr);
gap:16px;
}

.article h2,
.empty h2{
font-size:24px;
}

}

@media(max-width:390px){

.container{
padding:0 18px;
}

h1{
font-size:34px;
}

.article{
grid-template-columns:26px minmax(0,1fr);
gap:12px;
}

.article h2,
.empty h2{
font-size:22px;
}

.intro,
.empty p,
.description{
font-size:15px;
}

}

</style>