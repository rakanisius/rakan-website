---
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { articles, categories } from "../../../data/manifest";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const categoryArticles = articles
  .filter(
    (article) =>
      article.categorySlug === category.slug
  )
  .sort((a, b) => b.number - a.number);
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/>
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/>

<title>{category.title} | RAKAN</title>

<meta name="description" content={category.description}/>

<link rel="canonical" href={`https://rakan.my.id/tulisan/kategori/${category.slug}`}/>

<meta property="og:title" content={`${category.title} | RAKAN`}/>
<meta property="og:description" content={category.description}/>
<meta property="og:type" content="website"/>
<meta property="og:image" content="/images/og-library.jpg"/>

<meta name="twitter:card" content="summary_large_image"/>

</head>

<body>

<Nav/>

<main>

<section class="hero">

<div class="container">

<div class="eyebrow">DUNIA RAKAN</div>

<h1>{category.title}</h1>

<p class="intro">{category.description}</p>

<div class="meta">{categoryArticles.length} tulisan</div>

</div>

</section>

<section class="articles-section">

<div class="container">

{
categoryArticles.length > 0 ? (

<div class="articles">

{categoryArticles.map((article)=>(

<article class="article">

<div class="number">
{String(article.number).padStart(2,"0")}
</div>

<div class="content">

<div class="edition">
Edition {article.edition}
</div>

<h2>
<a href={article.href}>
{article.title}
</a>
</h2>

<p>{article.description}</p>

<div class="archive">
{article.node} · Arsip {article.archive}
</div>

</div>

<a class="read" href={article.href}>
Baca →
</a>

</article>

))}

</div>

):(

<div class="empty">

<h2>Belum ada tulisan.</h2>

<p>
Dunia ini sedang bertumbuh. Tulisan berikutnya akan muncul di sini.
</p>

</div>

)

}

<div class="actions">

<a href="/tulisan" class="button secondary">
← Kembali ke Perpustakaan
</a>

</div>

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>

:global(*){box-sizing:border-box}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:1120px;
margin:auto;
padding:0 32px;
}

.hero{
padding:90px 0 70px;
border-bottom:1px solid #E5DFD5;
}

.articles-section{
padding:70px 0 100px;
}

.eyebrow{
margin-bottom:18px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1,h2{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
max-width:820px;
font-size:clamp(52px,7vw,82px);
line-height:1;
letter-spacing:-.03em;
}

.intro{
max-width:720px;
margin:24px 0;
color:#514C45;
font-size:18px;
line-height:1.8;
}

.meta{
color:#81776A;
font-size:14px;
letter-spacing:.08em;
text-transform:uppercase;
}

.articles{
border-top:1px solid #E5DFD5;
}

.article{
display:grid;
grid-template-columns:60px minmax(0,1fr) 80px;
gap:24px;
padding:34px 0;
border-bottom:1px solid #E5DFD5;
}

.number{
font-family:Georgia,serif;
color:#8B8174;
}

.edition{
margin-bottom:12px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.14em;
text-transform:uppercase;
}

.content h2{
font-size:clamp(30px,4vw,42px);
line-height:1.12;
margin-bottom:14px;
}

.content h2 a{
color:#201D19;
text-decoration:none;
}

.content h2 a:hover{
color:#7A2635;
}

.content p{
margin:0;
color:#514C45;
font-size:16px;
line-height:1.8;
}

.archive{
margin-top:18px;
color:#81776A;
font-size:12px;
letter-spacing:.08em;
text-transform:uppercase;
}

.read{
align-self:center;
color:#201D19;
text-decoration:none;
}

.read:hover{
color:#7A2635;
}

.empty{
padding:40px;
border:1px dashed #D8D0C5;
text-align:center;
}

.actions{
margin-top:42px;
}

.button{
display:inline-block;
padding:15px 24px;
text-decoration:none;
transition:.2s;
}

.button.secondary{
border:1px solid #D8D0C5;
color:#201D19;
}

.button.secondary:hover{
background:#F1ECE5;
}

@media(max-width:800px){

.container{
padding:0 20px;
}

.hero{
padding:70px 0 50px;
}

.articles-section{
padding:50px 0 80px;
}

.article{
grid-template-columns:32px minmax(0,1fr);
}

.read{
grid-column:2;
margin-top:10px;
}

}

@media(max-width:390px){

.container{
padding:0 18px;
}

.hero{
padding:58px 0 44px;
}

h1{
font-size:38px;
}

.intro{
font-size:16px;
}

.article{
grid-template-columns:24px minmax(0,1fr);
}

}

</style>