---
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { articles, categories } from "../../../data/articles";

const sortedArticles = [...articles].sort((a, b) => b.number - a.number);

const categoriesWithCount = categories.map((category) => ({
  ...category,
  count: articles.filter((a) => a.slug === category.slug).length,
}));
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<link rel="icon" href="/favicon-rakan.png"/>

<title>Tulisan | RAKAN</title>

<meta
name="description"
content="Catatan Rakan tentang tubuh, pikiran, kesehatan, obat, kebiasaan, dan perjalanan manusia memahami dirinya secara utuh."
/>

</head>

<body>

<Nav/>

<main>

<section class="hero">

<div class="container">

<div class="eyebrow">
RUANG TULISAN RAKAN
</div>

<h1>
<span>Memahami kesehatan,</span>
<span><em>manusia,</em></span>
<em>dan kehidupan.</em>
</h1>

<p class="intro">
Catatan tentang tubuh, pikiran, obat, kebiasaan, dan perjalanan manusia memahami dirinya secara utuh.
</p>

</div>

</section>

<section class="categories-section">

<div class="container">

<div class="eyebrow">
JELAJAHI BERDASARKAN TEMA
</div>

<div class="category-grid">

{categoriesWithCount.map((item)=>(

<a
href={`/tulisan/kategori/${item.slug}`}
class="category-card"
>

<div class="count">
{String(item.count).padStart(2,"0")} tulisan
</div>

<h3>{item.title}</h3>

<p>{item.description}</p>

<div class="arrow">
Lihat kategori →
</div>

</a>

))}

</div>

</div>

</section>

<section class="articles-section">

<div class="container">

<div class="articles">

{sortedArticles.map((article)=>(

<article class="article">

<div class="number">
{String(article.number).padStart(2,"0")}
</div>

<div class="article-content">

<a
class="category"
href={`/tulisan/kategori/${article.slug}`}
>
{article.category.toUpperCase()}
</a>

<h2>{article.title}</h2>

<p class="description">
{article.description}
</p>

</div>

<a
class="read"
href={article.href}
>
Baca tulisan →
</a>

</article>

))}

</div>

</div>

</section>

<section class="cta">

<div class="cta-inner">

<div class="eyebrow">
LANJUTKAN PERJALANAN
</div>

<h2>
Membaca adalah awal.
<em>Memahami membutuhkan percakapan.</em>
</h2>

<p>
Jika satu tulisan membuka pertanyaan baru, Anda bisa melanjutkannya melalui buku atau layanan pendampingan.
</p>

<div class="cta-actions">

<a href="/buku" class="button secondary">
Lihat Buku
</a>

<a href="/layanan" class="button">
Lihat Layanan
</a>

</div>

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>
:global(*){box-sizing:border-box;}
:global(html){overflow-x:hidden;scroll-behavior:smooth;}
:global(body){margin:0;overflow-x:hidden;background:#F7F4EE;color:#201D19;font-family:Arial,Helvetica,sans-serif;}

.container{max-width:1180px;margin:auto;padding:0 32px;}

.hero{padding:100px 0 90px;border-bottom:1px solid #E5DFD5;}

.eyebrow{margin-bottom:24px;color:#7A2635;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;}

h1,h2,h3{margin:0;font-family:Georgia,serif;font-weight:400;}

h1 span,h1 em{display:block;}

h1{max-width:860px;font-size:clamp(50px,7vw,84px);line-height:1.02;letter-spacing:-.03em;}

h1 em{font-style:italic;color:#756653;}

.intro{max-width:650px;margin-top:32px;color:#514C45;font-size:17px;line-height:1.8;}

.categories-section{padding:70px 0;border-bottom:1px solid #E5DFD5;}

.category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:34px;}

.category-card{display:block;padding:28px;background:#F7F4EE;border:1px solid #E5DFD5;text-decoration:none;color:inherit;transition:.25s ease;}

.category-card:hover{transform:translateY(-3px);border-color:#7A2635;box-shadow:0 10px 24px rgba(32,29,25,.06);}

.count{margin-bottom:16px;color:#7A2635;font-size:11px;letter-spacing:.08em;text-transform:uppercase;}

.category-card h3{font-size:28px;line-height:1.15;margin-bottom:14px;}

.category-card p{margin:0;color:#514C45;line-height:1.75;font-size:15px;}

.arrow{margin-top:22px;font-size:14px;color:#7A2635;}

.articles-section{padding:80px 0 110px;}

.articles{border-top:1px solid #E5DFD5;}

.article{display:grid;grid-template-columns:60px minmax(0,1fr) 120px;gap:28px;padding:40px 0;border-bottom:1px solid #E5DFD5;}

.number{font-family:Georgia,serif;font-size:17px;color:#8B8174;}

.article-content{min-width:0;}

.category{display:inline-block;margin-bottom:14px;color:#81776A;font-size:10px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;text-decoration:none;}

.category:hover{color:#7A2635;}

.article h2{font-size:clamp(28px,4vw,44px);line-height:1.12;}

.description{max-width:650px;margin-top:16px;color:#514C45;font-size:15px;line-height:1.75;}

.read{align-self:center;text-decoration:none;color:#201D19;font-size:14px;white-space:nowrap;}

.read:hover{color:#7A2635;}

.cta{padding:90px 0;background:#EBE5DC;border-top:1px solid #E5DFD5;}

.cta-inner{max-width:760px;margin:auto;padding:0 32px;}

.cta h2{font-size:clamp(34px,5vw,48px);line-height:1.15;margin:18px 0;}

.cta h2 em{display:block;font-style:italic;color:#756653;}

.cta p{max-width:620px;color:#514C45;font-size:17px;line-height:1.8;}

.cta-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:30px;}

.button{display:inline-block;padding:15px 24px;background:#7A2635;color:white;text-decoration:none;}

.button:hover{background:#201D19;}

.button.secondary{background:transparent;border:1px solid #D8D0C5;color:#201D19;}

.button.secondary:hover{background:#F1ECE5;}

@media(max-width:900px){
.container{padding:0 20px;}
.hero{padding:70px 0;}
h1{font-size:44px;}
.category-grid{grid-template-columns:repeat(2,1fr);}
.category-card h3{font-size:24px;}
.article{grid-template-columns:32px minmax(0,1fr);gap:14px;}
.read{grid-column:2;margin-top:10px;}
.article h2{font-size:26px;}
}

@media(max-width:390px){
.container{padding:0 18px;}
.hero{padding:58px 0;}
h1{font-size:34px;}
.intro{font-size:15px;}
.categories-section{padding:52px 0;}
.category-grid{grid-template-columns:1fr;gap:18px;}
.category-card{padding:22px;}
.category-card h3{font-size:22px;}
.category-card p{font-size:14px;}
.articles-section{padding:52px 0 70px;}
.article{grid-template-columns:24px minmax(0,1fr);gap:10px;padding:26px 0;}
.number{font-size:12px;}
.category{font-size:8px;}
.article h2{font-size:22px;}
.description{font-size:14px;}
.read{font-size:12px;}
.cta{padding:58px 0;}
.cta-inner{padding:0 18px;}
.cta p{font-size:15px;}
}
</style>
