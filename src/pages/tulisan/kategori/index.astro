---
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";

const categories = [
  {
    name: "Tubuh & Kesehatan",
    slug: "tubuh-kesehatan",
    count: "01",
    description: "Obat, tubuh, tidur, nutrisi, dan kebiasaan.",
  },
  {
    name: "Pikiran & Emosi",
    slug: "pikiran-emosi",
    count: "00",
    description: "Stres, emosi, perhatian, dan pengalaman batin.",
  },
  {
    name: "Obat & Farmasi",
    slug: "farmasi",
    count: "00",
    description: "Literasi obat untuk manusia biasa.",
  },
  {
    name: "Kesehatan Holistik",
    slug: "holistik",
    count: "00",
    description: "Melihat manusia lebih utuh.",
  },
  {
    name: "Kehidupan",
    slug: "kehidupan",
    count: "03",
    description: "Makna, relasi, dan perjalanan manusia.",
  },
  {
    name: "Catatan Praktisi",
    slug: "catatan-praktisi",
    count: "00",
    description: "Belajar dari pengalaman nyata di lapangan.",
  },
];
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<link rel="icon" type="image/png" href="/favicon-rakan.png"/>
<link rel="shortcut icon" type="image/png" href="/favicon-rakan.png"/>
<link rel="apple-touch-icon" href="/favicon-rakan.png"/>

<title>Kategori Tulisan | RAKAN</title>

<meta
name="description"
content="Jelajahi tulisan RAKAN berdasarkan tema: tubuh, pikiran, farmasi, kesehatan holistik, kehidupan, dan catatan praktisi."
/>

</head>

<body>

<Nav/>

<main>

<!-- HERO -->

<section class="hero">

<div class="container">

<div class="eyebrow">
KATEGORI TULISAN
</div>

<h1>
Peta percakapan di dalam <em>RAKAN.</em>
</h1>

<p class="intro">
Setiap tulisan berada di dalam satu ruang percakapan.
Mulailah dari tema yang paling dekat dengan pertanyaanmu hari ini.
</p>

</div>

</section>

<!-- GRID -->

<section class="categories">

<div class="container">

<div class="grid">

{categories.map((item)=>(

<a
href={`/tulisan/kategori/${item.slug}`}
class="card"
>

<div class="count">
{item.count} tulisan
</div>

<h2>{item.name}</h2>

<p>{item.description}</p>

<div class="more">
Jelajahi →
</div>

</a>

))}

</div>

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>

:global(*){box-sizing:border-box;}

:global(html){
overflow-x:hidden;
}

:global(body){
margin:0;
overflow-x:hidden;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

/* CONTAINER */

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

/* HERO */

.hero{
padding:100px 0 90px;
border-bottom:1px solid #E5DFD5;
}

.eyebrow{
margin-bottom:24px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1,h2{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
max-width:820px;
font-size:clamp(50px,7vw,82px);
line-height:1.04;
letter-spacing:-.03em;
}

h1 em{
font-style:italic;
color:#756653;
}

.intro{
max-width:650px;
margin-top:32px;
color:#514C45;
font-size:17px;
line-height:1.8;
}

/* GRID */

.categories{
padding:80px 0 100px;
}

.grid{
display:grid;
grid-template-columns:repeat(3,minmax(0,1fr));
gap:24px;
}

.card{
display:block;
padding:28px;
background:#F7F4EE;
border:1px solid #E5DFD5;
text-decoration:none;
color:inherit;
transition:
transform .25s ease,
box-shadow .25s ease,
border-color .25s ease;
}

.card:hover{
transform:translateY(-4px);
border-color:#7A2635;
box-shadow:0 12px 28px rgba(32,29,25,.06);
}

.count{
margin-bottom:16px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.10em;
text-transform:uppercase;
}

.card h2{
font-size:28px;
line-height:1.15;
margin-bottom:14px;
}

.card p{
margin:0;
color:#514C45;
font-size:15px;
line-height:1.75;
}

.more{
margin-top:22px;
color:#7A2635;
font-size:14px;
}

/* TABLET */

@media(max-width:900px){

.container{
padding:0 20px;
}

.hero{
padding:70px 0;
}

h1{
font-size:44px;
}

.grid{
grid-template-columns:repeat(2,1fr);
}

.card h2{
font-size:24px;
}

}

/* iPhone 12 mini */

@media(max-width:390px){

.container{
padding:0 18px;
}

.hero{
padding:58px 0;
}

h1{
font-size:34px;
}

.intro{
font-size:15px;
}

.categories{
padding:52px 0 70px;
}

.grid{
grid-template-columns:1fr;
gap:18px;
}

.card{
padding:22px;
}

.card h2{
font-size:22px;
}

.card p{
font-size:14px;
}

}

</style>