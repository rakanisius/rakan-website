---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const article = {
  title: "",
  description: "",
  category: "",
  slug: "",
  date: "25 September 2026",
  readingTime: "6 menit",
  author: "Abdul Rakan",
  image: "/og/default.jpg",
};
---

<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{article.title} | RAKAN</title>
<meta name="description" content={article.description}/>
</head>

<body>

<Nav/>

<main>

<section class="hero">

<div class="container narrow">

<a href="/tulisan" class="back">
← Kembali ke Tulisan
</a>

<div class="eyebrow">
{article.category}
</div>

<h1>{article.title}</h1>

<p class="intro">
{article.description}
</p>

<div class="meta">

<span>{article.author}</span>

<span>•</span>

<span>{article.date}</span>

<span>•</span>

<span>{article.readingTime}</span>

</div>

</div>

</section>

<section class="article">

<div class="container narrow">

<p class="lead">
Tulis pembuka artikel di sini.
</p>

<h2>Bagian Pertama</h2>

<p>
Mulai menulis.
</p>

<h2>Penutup</h2>

<p>
Tutup dengan satu gagasan yang ingin pembaca bawa pulang.
</p>

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:760px;
margin:auto;
padding:0 20px;
}

.hero{
padding:80px 0 60px;
border-bottom:1px solid #E5DFD5;
}

.back{
display:inline-block;
margin-bottom:24px;
color:#514C45;
text-decoration:none;
}

.eyebrow{
color:#7A2635;
font-size:11px;
letter-spacing:.16em;
text-transform:uppercase;
margin-bottom:18px;
}

h1,h2{
font-family:Georgia,serif;
font-weight:400;
}

h1{
font-size:clamp(36px,6vw,64px);
line-height:1.05;
}

.intro{
font-size:18px;
line-height:1.8;
}

.meta{
display:flex;
gap:10px;
flex-wrap:wrap;
color:#6B655E;
font-size:14px;
margin-top:24px;
}

.article{
padding:60px 0 80px;
}

.article p{
font-size:18px;
line-height:1.9;
margin-bottom:24px;
}

.article h2{
margin:52px 0 18px;
font-size:36px;
}

@media(max-width:390px){

h1{
font-size:34px;
}

.article p{
font-size:16px;
}

.article h2{
font-size:28px;
}

}

</style>
