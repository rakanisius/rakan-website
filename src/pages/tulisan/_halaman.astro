---
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import AuthorCard from "../../components/article/AuthorCard.astro";
import RuangBerikutnya from "../../components/article/RuangBerikutnya.astro";
import { marked } from "marked";

interface Props {
  title: string;
  description: string;
  category: string;
  world: string;
  edition: string;
  node: string;
  archive: string;
  slug: string;
  image: string;
  heroCaption: string;
}

const props = Astro.props;

const markdown = await Astro.slots.render("default");
const html = marked.parse(markdown);
---

<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1"/>

<link rel="icon" href="/brand/favicon.svg"/>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:wght@400;500;600;700&display=swap" rel="stylesheet"/>

<title>{props.title} | RAKAN</title>

<meta name="description" content={props.description}/>

<meta property="og:title" content={props.title}/>
<meta property="og:description" content={props.description}/>
<meta property="og:image" content={props.image}/>

<link rel="canonical" href={`https://rakan.my.id/tulisan/${props.slug}`}/>
</head>

<body>

<Nav/>

<main class="article">

<header class="header">

  <div class="eyebrow">
    Edition {props.edition} · {props.world}
  </div>

  <h1>{props.title}</h1>

  <p class="intro">
    {props.description}
  </p>

  <div class="meta">
    {props.category} · {props.node}
  </div>

</header>

<figure class="hero">

  <img src={props.image} alt={props.title}/>

  <figcaption>{props.heroCaption}</figcaption>

</figure>

<article class="content" set:html={html} />

<AuthorCard node={props.node} archive={props.archive}/>

<RuangBerikutnya/>

<RelatedContent
  currentHref={`/tulisan/${props.slug}`}
  currentCategory={props.category}
/>

</main>

<Footer/>

</body>
</html>

<style>

:global(*) {
  box-sizing:border-box;
}

:global(body) {
  margin:0;
  background:#F7F4EE;
  color:#29251F;
  font-family:"Inter",sans-serif;
}

.article {
  max-width:1120px;
  margin:auto;
  padding:72px 28px 110px;
}

.header {
  max-width:760px;
  margin:auto;
}

.eyebrow {
  color:#7A2635;
  font-size:13px;
  letter-spacing:.18em;
  text-transform:uppercase;
  margin-bottom:18px;
}

h1 {
  font-family:"Source Serif 4",serif;
  font-weight:600;
  font-size:clamp(52px,7vw,82px);
  line-height:.96;
  letter-spacing:-.04em;
  margin:0 0 26px;
}

.intro {
  font-family:"Source Serif 4",serif;
  font-size:clamp(24px,3vw,31px);
  line-height:1.55;
  color:#5B544C;
  margin:0 0 30px;
}

.meta {
  font-size:14px;
  color:#867C70;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.hero {
  max-width:820px;
  margin:44px auto 38px;
}

.hero img {
  display:block;
  width:100%;
  aspect-ratio:16/9;
  object-fit:cover;
  border-radius:18px;
}

.hero figcaption {
  margin-top:12px;
  font-size:13px;
  color:#8B8175;
}

.content {
  max-width:760px;
  margin:-4px auto 0;
}

.content :global(h2) {
  font-family:"Source Serif 4",serif;
  font-size:clamp(34px,4vw,46px);
  font-weight:600;
  line-height:1.18;
  margin:64px 0 22px;
}

.content :global(p) {
  font-family:"Source Serif 4",serif;
  font-size:22px;
  line-height:1.84;
  color:#433F38;
  margin:0 0 26px;
}

.content :global(blockquote) {
  margin:56px 0;
  padding:28px 0;
  border-top:1px solid #D9D1C4;
  border-bottom:1px solid #D9D1C4;
  font-family:"Source Serif 4",serif;
  font-size:30px;
  line-height:1.45;
  font-style:italic;
  color:#2E2924;
}

.content :global(strong) {
  font-weight:700;
  color:#29251F;
}

.content :global(ul),
.content :global(ol) {
  font-family:"Source Serif 4",serif;
  font-size:22px;
  line-height:1.84;
  color:#433F38;
  padding-left:1.5rem;
  margin:0 0 30px;
}

.content :global(li) {
  margin-bottom:10px;
}

.content :global(hr) {
  margin:56px 0;
  border:none;
  border-top:1px solid #DDD4C7;
}

@media (max-width:720px){

  .article{
    padding:56px 20px 84px;
  }

  .hero{
    margin:36px auto 34px;
  }

  .content{
    margin:0 auto;
  }

  .content :global(p),
  .content :global(ul),
  .content :global(ol){
    font-size:19px;
    line-height:1.82;
  }

  .content :global(h2){
    margin:52px 0 18px;
  }

}

</style>
