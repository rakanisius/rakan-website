---
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import KnowledgeNavigator from "../../components/KnowledgeNavigator.astro";

interface Props{
title:string;
description:string;
world:"Tubuh"|"Otak"|"Pikiran"|"Kehidupan";
node:string;
edition:string;
hero:string;
href:string;
}

const{
title,
description,
world,
node,
edition,
hero,
href
}=Astro.props;
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>{title} | RAKAN</title>

<meta name="description" content={description}/>

<link rel="canonical" href={`https://rakan.my.id${href}`}/>

<meta property="og:title" content={`${title} | RAKAN`}/>
<meta property="og:description" content={description}/>
<meta property="og:type" content="article"/>
<meta property="og:image" content={hero}/>

<meta name="twitter:card" content="summary_large_image"/>

<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/>
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/>

</head>

<body>

<Nav/>

<main>

<!-- HERO -->

<section class="hero">

<div class="container narrow">

<div class="eyebrow">
{world.toUpperCase()}
</div>

<h1>{title}</h1>

<p class="intro">
{description}
</p>

<div class="meta">

<div class="meta-item">
<span>Node</span>
<strong>{node}</strong>
</div>

<div class="meta-item">
<span>Edition</span>
<strong>ED-{edition}</strong>
</div>

</div>

</div>

<div class="hero-image">

<img
src={hero}
alt={title}
fetchpriority="high"
/>

</div>

</section>

<!-- ARTICLE -->

<article class="article">

<div class="container narrow">

<slot/>

<KnowledgeNavigator
href={href}
nodeId={node}
editionId={edition}
/>

</div>

</article>

<!-- CTA -->

<section class="cta">

<div class="container narrow">

<div class="eyebrow">
LANJUTKAN PERJALANAN
</div>

<h2>
Setiap artikel adalah satu pintu masuk.
</h2>

<p>
Kalau satu tulisan membuka pertanyaan baru,
Anda bisa melanjutkannya melalui Perpustakaan RAKAN,
Buku,
Layanan,
atau Kolaborasi.
</p>

<div class="actions">

<a href="/tulisan" class="button secondary">
Perpustakaan
</a>

<a href="/buku" class="button secondary">
Lihat Buku
</a>

<a href="/layanan" class="button primary">
Lihat Layanan
</a>

</div>

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>

:global(*){box-sizing:border-box}

:global(html){
scroll-behavior:smooth;
}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

.narrow{
max-width:760px;
}

/* HERO */

.hero{
padding:80px 0 0;
border-bottom:1px solid #E5DFD5;
}

.hero .container{
padding-bottom:54px;
}

.hero-image img{
display:block;
width:100%;
max-height:520px;
object-fit:cover;
}

/* ARTICLE */

.article{
padding:70px 0 90px;
}

/* CTA */

.cta{
padding:95px 0;
background:#EBE5DC;
border-top:1px solid #E5DFD5;
}

/* TYPOGRAPHY */

.eyebrow{
margin-bottom:20px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1,h2,h3{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
font-size:clamp(44px,6vw,72px);
line-height:1.06;
letter-spacing:-.03em;
}

h2{
margin-bottom:24px;
font-size:clamp(34px,5vw,48px);
line-height:1.15;
}

.intro{
margin-top:26px;
color:#514C45;
font-size:19px;
line-height:1.85;
}

.meta{
display:flex;
gap:34px;
flex-wrap:wrap;
margin-top:36px;
padding-top:26px;
border-top:1px solid #E5DFD5;
}

.meta-item{
display:flex;
flex-direction:column;
gap:6px;
}

.meta-item span{
color:#756653;
font-size:11px;
letter-spacing:.12em;
text-transform:uppercase;
}

.meta-item strong{
font-size:16px;
font-weight:600;
color:#201D19;
}

/* ARTICLE CONTENT */

.article :global(h2){
margin-top:54px;
margin-bottom:20px;
font-size:clamp(30px,4vw,40px);
}

.article :global(h3){
margin-top:40px;
margin-bottom:16px;
font-size:28px;
}

.article :global(p){
margin:0 0 24px;
color:#3F3A33;
font-size:18px;
line-height:1.95;
}

.article :global(ul),
.article :global(ol){
margin:0 0 28px 22px;
padding:0;
}

.article :global(li){
margin-bottom:12px;
color:#3F3A33;
line-height:1.9;
}

.article :global(blockquote){
margin:42px 0;
padding-left:22px;
border-left:2px solid #7A2635;
color:#514C45;
font-family:Georgia,serif;
font-size:24px;
font-style:italic;
line-height:1.7;
}

.article :global(strong){
color:#201D19;
}

.article :global(hr){
margin:50px 0;
border:none;
border-top:1px solid #E5DFD5;
}

/* CTA */

.actions{
display:flex;
gap:14px;
flex-wrap:wrap;
margin-top:32px;
}

.button{
display:inline-block;
padding:15px 24px;
text-decoration:none;
transition:.2s;
}

.button.primary{
background:#7A2635;
color:white;
}

.button.primary:hover{
background:#201D19;
}

.button.secondary{
border:1px solid #D8D0C5;
color:#201D19;
}

.button.secondary:hover{
background:#F1ECE5;
}

/* RESPONSIVE */

@media(max-width:900px){

.container{
padding:0 20px;
}

.hero{
padding-top:64px;
}

.article{
padding:54px 0 70px;
}

.cta{
padding:70px 0;
}

.intro{
font-size:17px;
}

.article :global(p){
font-size:17px;
}

.actions{
flex-direction:column;
}

.button{
text-align:center;
}

}

@media(max-width:390px){

.container{
padding:0 18px;
}

.hero{
padding-top:54px;
}

.article{
padding:42px 0 58px;
}

.cta{
padding:58px 0;
}

h1{
font-size:34px;
}

h2{
font-size:28px;
}

.intro{
font-size:16px;
}

.article :global(p){
font-size:16px;
line-height:1.9;
}

.article :global(blockquote){
font-size:20px;
}

.meta{
gap:20px;
}

}
</style>
