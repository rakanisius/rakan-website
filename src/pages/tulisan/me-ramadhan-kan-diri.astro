        border-bottom: 1px solid #dcd5ca;
        font-family: Georgia, serif;
        font-size: clamp(25px, 4vw, 38px);
        line-height: 1.3;
      }

      .question {
        margin: 80px 0;
        padding: 45px 0;
        border-top: 1px solid #dcd5ca;
        border-bottom: 1px solid #dcd5ca;
      }

      .question p {
        margin: 0;
        color: #29251f;
        font-family: Georgia, serif;
        font-size: clamp(24px, 4vw, 34px);
        line-height: 1.45;
      }

      .emphasis {
        margin: 70px 0;
        padding: 35px 0;
        border-top: 1px solid #dcd5ca;
        border-bottom: 1px solid #dcd5ca;
        color: #8c1d2c;
        font-family: Georgia, serif;
        font-size: clamp(27px, 4vw, 39px);
        line-height: 1.35;
        text-align: center;
      }

      .closing {
        margin-top: 100px;
        padding-top: 45px;
