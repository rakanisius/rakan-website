        }

        .intro {
          font-size: 20px;
        }

        .hero {
          margin: 50px 0 70px;
        }

        p {
          font-size: 17px;
          line-height: 1.85;
        }

        .question {
          margin: 60px 0;
          padding: 32px 0;
        }

        .emphasis {
          margin: 55px 0;
