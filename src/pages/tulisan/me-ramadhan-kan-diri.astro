        letter-spacing: -0.04em;
      }

      .intro {
        max-width: 720px;
        margin: 0 0 35px;
        color: #625b52;
        font-family: Georgia, serif;
        font-size: clamp(20px, 3vw, 27px);
        line-height: 1.55;
      }

      .meta {
        color: #81776a;
        font-size: 14px;
      }

      .hero {
        margin: 70px 0 100px;
      }

      .hero img {
        display: block;
