---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const title = "Kolaborasi | Rakan";
const description =
  "Kolaborasi Rakan untuk perusahaan, sekolah, kampus, komunitas, organisasi, dan institusi kesehatan melalui seminar, talkshow, workshop, sharing session, dan program khusus.";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />

    <link rel="icon" type="image/png" href="/favicon-rakan.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon-rakan.png" />
    <link rel="apple-touch-icon" href="/favicon-rakan.png" />
  </head>

  <body>
    <Nav />

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="container">
          <div class="hero-content">
            <p class="eyebrow">KOLABORASI</p>

            <h1>
              Menghadirkan percakapan tentang kesehatan,
              pikiran, dan kehidupan.
            </h1>

            <p class="lead">
              Rakan berkolaborasi dengan perusahaan, sekolah, kampus,
              komunitas, organisasi, dan institusi kesehatan untuk
              menghadirkan ruang belajar, percakapan, dan refleksi
              yang relevan dengan kebutuhan manusia.
            </p>

            <a href="/kolaborasi/form" class="button">
              Ajukan Kolaborasi
            </a>
          </div>
        </div>
      </section>

      <!-- MENGAPA KOLABORASI -->
      <section class="section">
        <div class="container narrow">
          <p class="eyebrow">MENGAPA KOLABORASI</p>

          <h2>
            Setiap ruang memiliki kebutuhan yang berbeda.
          </h2>

          <p>
            Rakan tidak datang dengan satu materi yang dipaksakan
            untuk semua orang. Sebuah ruang belajar di sekolah,
            percakapan di kampus, program wellbeing di perusahaan,
            dan kegiatan komunitas memiliki konteks yang berbeda.
          </p>

          <p>
            Karena itu, kolaborasi dimulai dengan memahami kebutuhan:
            siapa pesertanya, apa tujuan kegiatannya, tema apa yang
            relevan, dan bentuk pengalaman seperti apa yang ingin
            dibangun.
          </p>

          <div class="three-lines">
            <div>
              <span>Layanan</span>
              <p>Individu datang kepada Rakan.</p>
            </div>

            <div>
              <span>Kolaborasi</span>
              <p>Institusi mengundang Rakan.</p>
            </div>

            <div>
              <span>Tulisan &amp; Buku</span>
              <p>Gagasan Rakan menjangkau publik.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- RAKAN -->
      <section class="section">
        <div class="container narrow">
          <p class="eyebrow">RAKAN</p>

          <h2>
            Apoteker · Praktisi Kesehatan Holistik · Penulis
          </h2>

          <p>
            Rakan adalah apoteker, praktisi kesehatan holistik,
            dan penulis yang mengajak manusia memahami kesehatan,
            pikiran, dan kehidupan secara lebih utuh.
          </p>

          <div class="statement">
            <p>
              Apoteker adalah salah satu fondasi Rakan.
            </p>

            <p>
              Kesehatan holistik adalah wilayah pendekatannya.
            </p>

            <p>
              Manusia adalah pusat perhatiannya.
            </p>
          </div>

          <p>
            Dalam kolaborasi, Rakan membawa dua dunia yang sering
            dipisahkan: pengetahuan tentang kesehatan dan pengalaman
            manusia yang menjalaninya.
          </p>
        </div>
      </section>

      <!-- TIGA PILAR -->
      <section class="section">
        <div class="container">
          <p class="eyebrow">WILAYAH PERCAKAPAN</p>

          <h2>
            Tubuh · Pikiran · Kehidupan
          </h2>

          <div class="pillar-grid">
            <article class="pillar">
              <span>01</span>

              <h3>Tubuh</h3>

              <p>
                Kesehatan, tubuh, obat, kebiasaan, tidur,
                nutrisi, aktivitas, dan cara manusia merawat dirinya.
              </p>
            </article>

            <article class="pillar">
              <span>02</span>

              <h3>Pikiran</h3>

              <p>
                Pikiran, emosi, stres, kesadaran diri,
                pengalaman batin, dan hubungan manusia dengan dirinya.
              </p>
            </article>

            <article class="pillar">
              <span>03</span>

              <h3>Kehidupan</h3>

              <p>
                Relasi, perjalanan hidup, tekanan,
                pilihan, makna, dan proses menjadi manusia.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- UNTUK SIAPA -->
      <section class="section">
        <div class="container narrow">
          <p class="eyebrow">UNTUK SIAPA</p>

          <h2>
            Berbagai ruang, berbagai kebutuhan.
          </h2>

          <div class="audience-list">
            <article>
              <span>01</span>

              <div>
                <h3>Perusahaan</h3>

                <p>
                  Program kesehatan, wellbeing, literasi kesehatan,
                  dan pengembangan manusia di lingkungan kerja.
                </p>
              </div>
            </article>

            <article>
              <span>02</span>

              <div>
                <h3>Sekolah</h3>

                <p>
                  Program untuk siswa, guru, orang tua,
                  maupun komunitas sekolah.
                </p>
              </div>
            </article>

            <article>
              <span>03</span>

              <div>
                <h3>Kampus</h3>

                <p>
                  Seminar, talkshow, workshop, dan program
                  pengembangan mahasiswa maupun civitas akademika.
                </p>
              </div>
            </article>

            <article>
              <span>04</span>

              <div>
                <h3>Komunitas &amp; Organisasi</h3>

                <p>
                  Ruang percakapan yang dapat disesuaikan
                  dengan karakter dan kebutuhan komunitas.
                </p>
              </div>
            </article>

            <article>
              <span>05</span>

              <div>
                <h3>Institusi Kesehatan</h3>

                <p>
                  Edukasi kesehatan, literasi obat,
                  dan percakapan tentang manusia dalam kesehatan.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- FORMAT -->
      <section class="section">
        <div class="container narrow">
          <p class="eyebrow">FORMAT</p>

          <h2>
            Bentuk kolaborasi dapat disesuaikan.
          </h2>

          <div class="format-list">
            <article>
              <span>01</span>

              <div>
                <h3>Seminar</h3>
                <p>
                  Materi terstruktur untuk membuka wawasan
                  dan membangun pemahaman bersama.
                </p>
              </div>
            </article>

            <article>
              <span>02</span>

              <div>
                <h3>Talkshow</h3>
                <p>
                  Percakapan yang lebih cair, kontekstual,
                  dan dekat dengan pengalaman peserta.
                </p>
              </div>
            </article>

            <article>
              <span>03</span>

              <div>
                <h3>Workshop</h3>
                <p>
                  Peserta tidak hanya mendengar,
                  tetapi juga melakukan latihan dan refleksi.
                </p>
              </div>
            </article>

            <article>
              <span>04</span>

              <div>
                <h3>Sharing Session</h3>
                <p>
                  Ruang berbagi yang lebih sederhana,
                  personal, dan interaktif.
                </p>
              </div>
            </article>

            <article>
              <span>05</span>

              <div>
                <h3>Class</h3>
                <p>
                  Pembelajaran dengan materi yang lebih terarah
                  dan ruang praktik yang lebih luas.
                </p>
              </div>
            </article>

            <article>
              <span>06</span>

              <div>
                <h3>Custom Program</h3>
                <p>
                  Program yang dirancang berdasarkan kebutuhan,
                  karakter peserta, dan konteks institusi.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- TEMA -->
      <section class="section">
        <div class="container">
          <p class="eyebrow">TEMA</p>

          <h2>
            Beberapa percakapan yang dapat dikembangkan.
          </h2>

          <p class="section-intro">
            Tema berikut merupakan titik awal. Program dapat dikembangkan
            kembali sesuai peserta, tujuan, dan konteks kegiatan.
          </p>

          <div class="theme-group">
            <p class="group-label">SIGNATURE</p>

            <div class="theme-grid">
              <article>
                <span>01</span>
                <h3>Pikiran, Jangan Berisik!</h3>
                <p>
                  Memahami pikiran yang ramai, pengalaman batin,
                  dan ruang untuk berhenti sejenak.
                </p>
                <small>Pikiran · Stres · Kesadaran Diri</small>
              </article>

              <article>
                <span>02</span>
                <h3>Tubuh Tidak Pernah Bekerja Sendirian</h3>
                <p>
                  Melihat hubungan antara tubuh, pikiran,
                  kebiasaan, dan lingkungan.
                </p>
                <small>Tubuh · Pikiran · Kebiasaan</small>
              </article>

              <article>
                <span>03</span>
                <h3>Mengenal Obat, Memahami Tubuh</h3>
                <p>
                  Literasi obat dan kesehatan untuk manusia biasa.
                </p>
                <small>Obat · Tubuh · Literasi Kesehatan</small>
              </article>

              <article>
                <span>04</span>
                <h3>Menjadi Manusia yang Lebih Utuh</h3>
                <p>
                  Percakapan tentang tubuh, pikiran,
                  kehidupan, dan manusia.
                </p>
                <small>Tubuh · Pikiran · Kehidupan</small>
              </article>
            </div>
          </div>

          <div class="theme-group">
            <p class="group-label">CORE</p>

            <div class="theme-list">
              <article>
                <span>05</span>
                <div>
                  <h3>Ketika Pikiran Bertemu Tubuh</h3>
                  <p>
                    Memahami hubungan pengalaman batin
                    dengan pengalaman tubuh.
                  </p>
                </div>
              </article>

              <article>
                <span>06</span>
                <div>
                  <h3>Hidup Tidak Punya Jadwal yang Sama</h3>
                  <p>
                    Tentang perbandingan sosial, tekanan,
                    dan perjalanan hidup.
                  </p>
                </div>
              </article>

              <article>
                <span>07</span>
                <div>
                  <h3>Stres Bukan Hanya Ada di Kepala</h3>
                  <p>
                    Membicarakan stres sebagai pengalaman
                    yang dapat melibatkan banyak sisi kehidupan.
                  </p>
                </div>
              </article>

              <article>
                <span>08</span>
                <div>
                  <h3>Tidur: Ketika Tubuh Meminta Kita Berhenti</h3>
                  <p>
                    Memahami tidur, pemulihan,
                    dan hubungan kita dengan waktu istirahat.
                  </p>
                </div>
              </article>

              <article>
                <span>09</span>
                <div>
                  <h3>Literasi Kesehatan untuk Manusia Biasa</h3>
                  <p>
                    Membantu manusia memahami informasi kesehatan
                    tanpa harus menjadi tenaga kesehatan.
                  </p>
                </div>
              </article>
            </div>
          </div>

          <div class="theme-group">
            <p class="group-label">WORKSHOP</p>

            <div class="single-theme">
              <span>10</span>

              <div>
                <h3>Berhenti Sejenak</h3>

                <p>
                  Workshop reflektif untuk belajar memperhatikan
                  pengalaman diri sebelum kembali merespons kehidupan.
                </p>
              </div>
            </div>
          </div>

          <div class="theme-group">
            <p class="group-label">DEEP TALK</p>

            <div class="single-theme">
              <span>11</span>

              <div>
                <h3>Untuk Apa Kita Menjalani Semua Ini?</h3>

                <p>
                  Percakapan tentang makna, nilai,
                  dan arah kehidupan.
                </p>
              </div>
            </div>
          </div>

          <div class="custom-theme">
            <p class="group-label">CUSTOM</p>

            <h3>
              Tema khusus institusi
            </h3>

            <p>
              Tidak semua kebutuhan harus masuk ke dalam daftar tema.
              Rakan dapat mengembangkan topik khusus berdasarkan
              konteks institusi, karakter peserta, dan tujuan kegiatan.
            </p>
          </div>
        </div>
      </section>

      <!-- YANG DIDAPAT -->
      <section class="section">
        <div class="container narrow">
          <p class="eyebrow">PROSES KOLABORASI</p>

          <h2>
            Bukan hanya datang dan berbicara.
          </h2>

          <p>
            Setiap kolaborasi dimulai dengan memahami kebutuhan
            kegiatan. Setelah itu, tema, format, dan pendekatan
            disesuaikan agar program memiliki konteks yang jelas.
          </p>

          <div class="process-list">
            <article>
              <span>01</span>
              <div>
                <h3>Memahami kebutuhan</h3>
                <p>
                  Siapa peserta, apa tujuan kegiatan,
                  dan konteks apa yang perlu diperhatikan.
                </p>
              </div>
            </article>

            <article>
              <span>02</span>
              <div>
                <h3>Menyesuaikan program</h3>
                <p>
                  Tema, format, durasi, dan kedalaman materi
                  disesuaikan dengan kebutuhan.
                </p>
              </div>
            </article>

            <article>
              <span>03</span>
              <div>
                <h3>Persiapan</h3>
                <p>
                  Materi dan kebutuhan kegiatan dipersiapkan
                  sebelum pelaksanaan.
                </p>
              </div>
            </article>

            <article>
              <span>04</span>
              <div>
                <h3>Pelaksanaan</h3>
                <p>
                  Program disampaikan dengan pendekatan edukatif,
                  reflektif, kontekstual, dan human-centered.
                </p>
              </div>
            </article>

            <article>
              <span>05</span>
              <div>
                <h3>Tindak lanjut</h3>
                <p>
                  Bila diperlukan, bentuk tindak lanjut dapat
                  dibicarakan sesuai kebutuhan institusi.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- PENYESUAIAN -->
      <section class="section">
        <div class="container narrow">
          <p class="eyebrow">PENYESUAIAN</p>

          <h2>
            Setiap program dapat dibentuk sesuai konteks.
          </h2>

          <p>
            Konsep kegiatan dapat mempertimbangkan jumlah peserta,
            durasi, lokasi, karakter peserta, tujuan program,
            tingkat kustomisasi, kebutuhan teknis, dan perjalanan.
          </p>

          <p>
            Karena itu, investasi dan bentuk kerja sama dibicarakan
            setelah kebutuhan kegiatan dipahami.
          </p>
        </div>
      </section>

      <!-- BATAS -->
      <section class="section boundary">
        <div class="container narrow">
          <p class="eyebrow">BATAS PENDEKATAN</p>

          <h2>
            Holistik tidak berarti menggantikan pengobatan.
          </h2>

          <p>
            Pendekatan kesehatan holistik yang digunakan Rakan
            tidak dimaksudkan untuk menggantikan diagnosis,
            pengobatan, atau perawatan medis maupun profesional
            kesehatan lainnya.
          </p>

          <p>
            Kolaborasi tetap ditempatkan dalam batas yang
            bertanggung jawab terhadap kebutuhan dan keselamatan peserta.
          </p>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta">
        <div class="container narrow">
          <p class="eyebrow">AJUKAN KOLABORASI</p>

          <h2>
            Ada tema, kebutuhan, atau ruang
            yang ingin kita bicarakan bersama?
          </h2>

          <p>
            Ceritakan konteks kegiatan Anda.
            Kita dapat membicarakan peserta, tujuan,
            format, tema, dan bentuk kolaborasi
            yang paling sesuai.
          </p>

          <a href="/kontak" class="button">
              Hubungi Saya
            </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(html) {
    background: #f7f4ee;
  }

  :global(body) {
    margin: 0;
    padding: 0;
    background: #f7f4ee;
    color: #201d19;
    font-family: Arial, sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .container {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .narrow {
    max-width: 980px;
  }

  .hero {
    padding: 96px 0 120px;
  }

  .hero-content {
    max-width: 880px;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: #7a2635;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
  }

  h1,
  h2,
  h3 {
    font-family: Georgia, serif;
    font-weight: 400;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: 58px;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  h2 {
    max-width: 820px;
    margin: 0 0 30px;
    font-size: 40px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  h3 {
    margin: 0;
    font-size: 27px;
    line-height: 1.25;
  }

  p {
    margin-top: 0;
  }

  .lead {
    max-width: 720px;
    margin: 32px 0 38px;
    color: #514c45;
    font-size: 18px;
    line-height: 1.8;
  }

  .section-intro {
    max-width: 720px;
    margin: 0 0 45px;
    color: #514c45;
    font-size: 17px;
    line-height: 1.8;
  }

  .button {
    display: inline-block;
    padding: 15px 24px;
    background: #7a2635;
    color: #ffffff;
    text-decoration: none;
    font-family: Arial, sans-serif;
    font-size: 14px;
    line-height: 1.4;
    transition: background 0.2s ease;
  }

  .button:hover {
    background: #201d19;
  }

  .section {
    padding: 88px 0;
    border-top: 1px solid #e5dfd5;
  }

  .section > .container > p:not(.eyebrow) {
    max-width: 760px;
    color: #514c45;
    font-size: 17px;
    line-height: 1.8;
  }

  .three-lines {
    margin-top: 48px;
    border-top: 1px solid #e5dfd5;
  }

  .three-lines > div {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 30px;
    padding: 23px 0;
    border-bottom: 1px solid #e5dfd5;
  }

  .three-lines span {
    color: #7a2635;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .three-lines p {
    margin: 0;
    color: #201d19;
    font-family: Georgia, serif;
    font-size: 22px;
    line-height: 1.4;
  }

  .statement {
    margin: 42px 0 38px;
    padding: 28px 0 18px;
    border-top: 1px solid #e5dfd5;
    border-bottom: 1px solid #e5dfd5;
  }

  .statement p {
    margin: 0 0 10px;
    color: #201d19 !important;
    font-family: Georgia, serif;
    font-size: 23px !important;
    line-height: 1.5 !important;
  }

  .statement p:last-child {
    margin-bottom: 0;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-top: 48px;
  }

  .pillar {
    padding-top: 12px;
    border-top: 2px solid #7a2635;
  }

  .pillar > span {
    display: block;
    margin-bottom: 22px;
    color: #7a2635;
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .pillar h3 {
    margin-bottom: 16px;
  }

  .pillar p {
    margin: 0;
    color: #514c45;
    font-size: 15px;
    line-height: 1.75;
  }

  .audience-list,
  .format-list,
  .process-list,
  .theme-list {
    margin-top: 42px;
    border-top: 1px solid #e5dfd5;
  }

  .audience-list article,
  .format-list article,
  .process-list article {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 26px;
    padding: 28px 0;
    border-bottom: 1px solid #e5dfd5;
  }

  .audience-list article > span,
  .format-list article > span,
  .process-list article > span {
    color: #7a2635;
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .audience-list h3,
  .format-list h3,
  .process-list h3 {
    margin-bottom: 10px;
  }

  .audience-list p,
  .format-list p,
  .process-list p {
    max-width: 650px;
    margin: 0;
    color: #514c45;
    font-size: 15px;
    line-height: 1.75;
  }

  .theme-group {
    margin-top: 58px;
  }

  .group-label {
    margin: 0 0 22px;
    color: #7a2635;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: #e5dfd5;
    border: 1px solid #e5dfd5;
  }

  .theme-grid article {
    min-height: 270px;
    padding: 32px;
    background: #f7f4ee;
  }

  .theme-grid article > span {
    display: block;
    margin-bottom: 24px;
    color: #7a2635;
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .theme-grid h3 {
    margin-bottom: 16px;
  }

  .theme-grid p {
    margin: 0 0 22px;
    color: #514c45;
    font-size: 15px;
    line-height: 1.75;
