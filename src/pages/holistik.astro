---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const title = "Kesehatan Holistik";
const description =
  "Memahami kesehatan sebagai hubungan antara tubuh, pikiran, kebiasaan, lingkungan, dan kehidupan dengan pendekatan yang utuh dan bertanggung jawab.";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title} | Rakan</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/png" href="/favicon-rakan.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon-rakan.png" />
    <link rel="apple-touch-icon" href="/favicon-rakan.png" />
  </head>

  <body>
    <Nav />

    <main>

      <!-- HERO -->

      <section class="hero">
        <div class="container">

          <p class="eyebrow">
            KESEHATAN HOLISTIK
          </p>

          <h1>
            Memahami kesehatan{" "}
            <em>sebagai pengalaman manusia.</em>
          </h1>

          <p class="lead">
            Kesehatan tidak hanya berbicara tentang penyakit.
            Ia juga menyentuh tubuh, pikiran, kebiasaan,
            lingkungan, hubungan, dan kehidupan seseorang.
          </p>

        </div>
      </section>

      <!-- APA ITU -->

      <section class="section">
        <div class="container split">

          <div class="left">

            <p class="eyebrow">
              APA ITU
            </p>

            <h2>
              Melihat manusia lebih utuh.
            </h2>

          </div>

          <div class="right">

            <p>
              Pendekatan holistik mengajak kita melihat manusia sebagai
              satu kesatuan, bukan kumpulan bagian yang berdiri sendiri.
            </p>

            <p>
              Tubuh, pikiran, kebiasaan, lingkungan,
              relasi, dan pengalaman hidup dapat saling memengaruhi,
              meskipun tidak selalu dengan cara yang sederhana.
            </p>

            <p>
              Tujuannya bukan mencari satu penyebab untuk semua hal,
              melainkan memahami konteks yang lebih luas.
            </p>

          </div>

        </div>
      </section>

      <!-- TIGA RUANG -->

      <section class="section">
        <div class="container">

          <p class="eyebrow">
            TIGA RUANG
          </p>

          <h2>
            Tubuh · Pikiran · Kehidupan
          </h2>

          <div class="pillars">

            <article>
              <span>01</span>

              <h3>Tubuh</h3>

              <p>
                Tidur, nutrisi, aktivitas, obat,
                penyakit, dan bagaimana tubuh memberi sinyal.
              </p>
            </article>

            <article>
              <span>02</span>

              <h3>Pikiran</h3>

              <p>
                Emosi, stres, perhatian,
                cara berpikir, dan pengalaman batin.
              </p>
            </article>

            <article>
              <span>03</span>

              <h3>Kehidupan</h3>

              <p>
                Relasi, pekerjaan, keluarga,
                lingkungan, nilai, dan makna hidup.
              </p>
            </article>

          </div>

        </div>
      </section>

      <!-- APA YANG TIDAK -->

      <section class="section boundary">
        <div class="container narrow">

          <p class="eyebrow">
            APA YANG TIDAK BERARTI
          </p>

          <h2>
            Holistik bukan jawaban untuk semua hal.
          </h2>

          <div class="truth-list">

            <article>

              <span>01</span>

              <div>

                <h3>
                  Tidak semua penyakit punya satu penyebab tersembunyi.
                </h3>

                <p>
                  Banyak kondisi kesehatan memiliki penyebab yang kompleks,
                  melibatkan faktor biologis, psikologis, sosial,
                  maupun lingkungan.
                </p>

              </div>

            </article>

            <article>

              <span>02</span>

              <div>

                <h3>
                  Tidak semua pengalaman pribadi menjadi bukti ilmiah.
                </h3>

                <p>
                  Pengalaman seseorang tetap berharga,
                  tetapi tidak selalu dapat digeneralisasi
                  menjadi kebenaran universal.
                </p>

              </div>

            </article>

            <article>

              <span>03</span>

              <div>

                <h3>
                  Tidak semua pendekatan cocok untuk semua orang.
                </h3>

                <p>
                  Setiap manusia memiliki kebutuhan,
                  kondisi, dan konteks yang berbeda.
                </p>

              </div>

            </article>

          </div>

        </div>
      </section>

      <!-- EMPAT LAPIS -->

      <section class="section">
        <div class="container">

          <p class="eyebrow">
            EMPAT LAPIS PEMAHAMAN
          </p>

          <h2>
            Cara saya membedakan informasi kesehatan.
          </h2>

          <div class="layers">

            <article>
              <span>01</span>

              <h3>Bukti ilmiah</h3>

              <p>
                Temuan yang didukung penelitian
                dan menjadi dasar praktik kesehatan.
              </p>
            </article>

            <article>
              <span>02</span>

              <h3>Kemungkinan biologis</h3>

              <p>
                Ada mekanisme yang masuk akal,
                tetapi bukti masih berkembang.
              </p>
            </article>

            <article>
              <span>03</span>

              <h3>Pengalaman pribadi</h3>

              <p>
                Pengalaman seseorang dapat memberi makna,
                tetapi belum tentu berlaku untuk semua orang.
              </p>
            </article>

            <article>
              <span>04</span>

              <h3>Keyakinan</h3>

              <p>
                Nilai dan kepercayaan memiliki tempatnya sendiri,
                tetapi berbeda dari klaim ilmiah.
              </p>
            </article>

          </div>

        </div>
      </section>

      <!-- PENERAPAN -->

      <section class="section">
        <div class="container narrow">

          <p class="eyebrow">
            DALAM PRAKTIK
          </p>

          <h2>
            Bagaimana pendekatan ini digunakan.
          </h2>

          <p>
            Ketika seseorang datang dengan keluhan,
            saya tidak hanya bertanya apa yang sakit.
          </p>

          <p>
            Saya juga tertarik memahami bagaimana tidurnya,
            bagaimana kesehariannya,
            bagaimana pikirannya,
            bagaimana relasinya,
            dan bagaimana hidup sedang berjalan.
          </p>

          <div class="statement">

            <p>
              Tubuh memberi sinyal.
            </p>

            <p>
              Pikiran memberi konteks.
            </p>

            <p>
              Kehidupan memberi cerita.
            </p>

          </div>

        </div>
      </section>

      <!-- RUANG BELAJAR -->

      <section class="section">
        <div class="container">

          <p class="eyebrow">
            LANJUTKAN BELAJAR
          </p>

          <h2>
            Jelajahi ruang lain di RAKAN.
          </h2>

          <div class="spaces">

            <a href="/tulisan" class="space-card">
              <span>01</span>

              <h3>Tulisan</h3>

              <p>
                Catatan tentang tubuh, pikiran, dan kehidupan.
              </p>
            </a>

            <a href="/buku" class="space-card">
              <span>02</span>

              <h3>Buku</h3>

              <p>
                Gagasan yang berkembang menjadi karya panjang.
              </p>
            </a>

            <a href="/layanan" class="space-card">
              <span>03</span>

              <h3>Layanan</h3>

              <p>
                Pendampingan yang disesuaikan dengan kebutuhan.
              </p>
            </a>

            <a href="/kolaborasi" class="space-card">
              <span>04</span>

              <h3>Kolaborasi</h3>

              <p>
                Menghadirkan percakapan untuk institusi,
                sekolah, kampus, dan komunitas.
              </p>
            </a>

          </div>

        </div>
      </section>

      <!-- CTA -->

      <section class="cta">
        <div class="container narrow">

          <p class="eyebrow">
            PENUTUP
          </p>

          <h2>
            Memahami manusia tidak selalu berarti
            menemukan jawaban yang sederhana.
          </h2>

          <p>
            Tetapi semakin luas cara kita melihat manusia,
            semakin bijaksana kita mengambil keputusan
            tentang kesehatan dan kehidupan.
          </p>

          <a href="/tulisan" class="button">
            Baca Tulisan
          </a>

        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
:global(body){
  margin:0;
  background:#F7F4EE;
  color:#201D19;
  font-family:Arial,sans-serif;
}
:global(*){box-sizing:border-box;}
.container{width:100%;max-width:1180px;margin:0 auto;padding:0 32px;}
.narrow{max-width:900px;}
.hero{padding:96px 0 110px;}
.eyebrow{color:#7A2635;font-size:12px;font-weight:600;letter-spacing:.16em;margin-bottom:24px;}
h1,h2,h3{font-family:Georgia,serif;font-weight:400;}
h1{font-size:58px;line-height:1.08;max-width:840px;margin:0;}
h1 em{font-style:italic;}
h2{font-size:40px;line-height:1.2;margin:0 0 28px;}
h3{font-size:26px;margin:0 0 12px;}
.lead{max-width:720px;font-size:18px;line-height:1.8;color:#514C45;margin-top:32px;}
.section{padding:86px 0;border-top:1px solid #E5DFD5;}
.split{display:grid;grid-template-columns:340px 1fr;gap:60px;}
.right p,.narrow p{color:#514C45;line-height:1.8;font-size:17px;}
.pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:48px;}
.pillars article,.layers article{border-top:2px solid #7A2635;padding-top:18px;}
.pillars span,.layers span{color:#7A2635;font-size:12px;letter-spacing:.12em;}
.boundary{background:#F1ECE5;}
.truth-list{margin-top:42px;border-top:1px solid #E5DFD5;}
.truth-list article{display:grid;grid-template-columns:70px 1fr;gap:24px;padding:26px 0;border-bottom:1px solid #E5DFD5;}
.truth-list span{color:#7A2635;font-size:12px;letter-spacing:.12em;}
.truth-list p{margin:0;color:#514C45;line-height:1.8;}
.layers{display:grid;grid-template-columns:repeat(2,1fr);gap:28px;margin-top:48px;}
.statement{margin-top:42px;padding:30px 0;border-top:1px solid #E5DFD5;border-bottom:1px solid #E5DFD5;}
.statement p{font-family:Georgia,serif;color:#201D19;font-size:24px;margin:8px 0;}
.spaces{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#E5DFD5;border:1px solid #E5DFD5;margin-top:48px;}
.space-card{background:#F7F4EE;padding:32px;text-decoration:none;color:inherit;transition:background .2s ease;}
.space-card:hover{background:#F1ECE5;}
.space-card span{color:#7A2635;font-size:12px;letter-spacing:.12em;}
.space-card p{color:#514C45;line-height:1.7;}
.cta{padding:100px 0 120px;background:#EBE5DC;}
.button{display:inline-block;padding:15px 24px;background:#7A2635;color:white;text-decoration:none;margin-top:18px;}
.button:hover{background:#201D19;}
@media(max-width:800px){
.container{padding:0 20px;}
.hero{padding:60px 0 80px;}
h1{font-size:41px;}
h2{font-size:31px;}
.split{grid-template-columns:1fr;gap:30px;}
.pillars,.layers,.spaces{grid-template-columns:1fr;}
.truth-list article{grid-template-columns:48px 1fr;}
.statement p{font-size:20px;}
.cta{padding:80px 0;}
}
</style>