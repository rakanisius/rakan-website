---
import StudioLayout from "../../layouts/StudioLayout.astro";
---

<StudioLayout title="Books">

<div class="hero">

<p class="eyebrow">
RAKAN Studio / Books
</p>

<h1>Books</h1>

<p class="lead">
Rak naskah untuk seluruh proyek buku berikutnya.
</p>

</div>

<section class="overview">

<div class="stat">
<span>Proyek Aktif</span>
<strong>0</strong>
</div>

<div class="stat">
<span>Status</span>
<strong>Kosong</strong>
</div>

<div class="stat">
<span>Siap Dimulai</span>
<strong>∞</strong>
</div>

</section>

<section class="empty-state">

<div class="icon">📚</div>

<h2>Rak masih kosong.</h2>

<p>
Dua proyek utama telah selesai. Halaman ini disiapkan sebagai ruang lahir
untuk buku-buku berikutnya.
</p>

<div class="placeholder">

<div class="line"></div>
<div class="line short"></div>
<div class="line"></div>

</div>

<div class="actions">

<button onclick='navigator.clipboard.writeText("os/templates/book.md")'>
📋 Copy Template Buku
</button>

<button onclick='navigator.clipboard.writeText("src/content/books/")'>
📂 Copy Folder Buku
</button>

</div>

</section>

<section class="principles">

<h3>Prinsip ruang ini</h3>

<ul>

<li>Satu folder untuk satu buku.</li>

<li>Satu bab untuk satu file Markdown.</li>

<li>Frontmatter menjadi sumber metadata.</li>

<li>Progress dihitung otomatis ketika proyek dimulai.</li>

</ul>

</section>

</StudioLayout>

<style>
.hero{
margin-bottom:34px;
}

.eyebrow{
margin:0;
font-size:14px;
letter-spacing:.08em;
text-transform:uppercase;
color:#6B645A;
}

h1{
margin:12px 0;
font-family:Georgia,serif;
font-size:72px;
font-weight:400;
line-height:.95;
}

.lead{
max-width:560px;
font-size:20px;
line-height:1.7;
color:#514C45;
}

.overview{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
margin-bottom:36px;
}

.stat{
background:white;
border:1px solid #DED6CA;
border-radius:20px;
padding:24px;
}

.stat span{
display:block;
font-size:12px;
letter-spacing:.08em;
text-transform:uppercase;
color:#6B645A;
margin-bottom:8px;
}

.stat strong{
font-family:Georgia,serif;
font-size:42px;
font-weight:400;
}

.empty-state{
background:white;
border:1px solid #DED6CA;
border-radius:28px;
padding:48px;
text-align:center;
margin-bottom:36px;
}

.icon{
font-size:46px;
margin-bottom:18px;
}

.empty-state h2{
margin:0;
font-family:Georgia,serif;
font-size:42px;
font-weight:400;
}

.empty-state p{
max-width:560px;
margin:18px auto 32px;
color:#514C45;
line-height:1.8;
}

.placeholder{
max-width:420px;
margin:0 auto 36px;
}

.line{
height:12px;
border-radius:999px;
background:#EFE8DD;
margin:16px 0;
}

.short{
width:70%;
margin-left:auto;
margin-right:auto;
}

.actions{
display:flex;
justify-content:center;
gap:12px;
flex-wrap:wrap;
}

.actions button{
padding:14px 20px;
border:none;
border-radius:12px;
background:#F5F2EC;
cursor:pointer;
font-size:14px;
}

.actions button:hover{
background:#EAE2D5;
}

.principles{
background:white;
border:1px solid #DED6CA;
border-radius:24px;
padding:32px;
}

.principles h3{
margin:0 0 18px;
font-family:Georgia,serif;
font-size:30px;
font-weight:400;
}

.principles ul{
margin:0;
padding-left:20px;
line-height:2;
}

@media(max-width:900px){

.overview{
grid-template-columns:1fr;
}

.empty-state{
padding:36px 24px;
}

h1{
font-size:56px;
}

}
</style>