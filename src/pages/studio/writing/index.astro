---
import StudioLayout from "../../../layouts/StudioLayout.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles");

const drafts = articles
  .sort((a, b) => b.data.tanggal.getTime() - a.data.tanggal.getTime());
---

<StudioLayout title="Menulis">

  <section class="head">

    <div>
      <h2>Draft Artikel</h2>
      <p>Semua artikel yang sedang dikerjakan.</p>
    </div>

    <a class="new-btn" href="/studio/writing/new">
      + Artikel Baru
    </a>

  </section>

  <section class="list">

    {
      drafts.length === 0 ? (

        <div class="empty">
          Belum ada draft.
        </div>

      ) : (

        drafts.map((article) => (

          <a
            class="card"
            href={`/studio/writing/${article.id}`}
          >

            <div class="left">

              <h3>{article.data.title}</h3>

              <div class="meta">

                <span class="badge category">
                  {article.data.kategori}
                </span>

                <span class="badge status">
                  {article.data.status}
                </span>

              </div>

            </div>

            <span class="date">
              {article.data.tanggal.toLocaleDateString("id-ID")}
            </span>

          </a>

        ))

      )
    }

  </section>

</StudioLayout>

<style>
.head{
display:flex;
justify-content:space-between;
align-items:end;
margin-bottom:28px;
gap:20px;
}

.head h2{
margin:0;
font-family:Georgia,serif;
font-size:40px;
font-weight:400;
}

.head p{
margin:8px 0 0;
color:#6B645A;
}

.new-btn{
padding:16px 24px;
border-radius:14px;
background:#7A2635;
color:white;
text-decoration:none;
font-weight:600;
transition:.18s;
}

.new-btn:hover{
background:#5E1D29;
}

.list{
display:grid;
gap:18px;
}

.card{
display:flex;
justify-content:space-between;
align-items:center;

padding:24px 28px;

background:white;
border:1px solid #DED6CA;
border-radius:20px;

text-decoration:none;
color:inherit;

transition:.18s ease;
}

.card:hover{
transform:translateY(-2px);
border-color:#CBBEAD;
box-shadow:0 10px 28px rgba(32,29,25,.08);
}

.left{
min-width:0;
}

.card h3{
margin:0 0 12px;
font-family:Georgia,serif;
font-size:32px;
font-weight:400;
line-height:1.15;
}

.meta{
display:flex;
gap:8px;
flex-wrap:wrap;
}

.badge{
padding:6px 12px;
border-radius:999px;
font-size:13px;
}

.category{
background:#F5F2EC;
color:#514C45;
}

.status{
background:#7A2635;
color:white;
}

.date{
white-space:nowrap;
color:#6B645A;
font-size:15px;
}

.empty{
padding:40px;
background:white;
border:1px solid #DED6CA;
border-radius:20px;
text-align:center;
color:#6B645A;
}

@media(max-width:720px){

.head{
flex-direction:column;
align-items:start;
}

.new-btn{
width:100%;
text-align:center;
}

.card{
flex-direction:column;
align-items:start;
gap:16px;
}

.date{
white-space:normal;
}

.card h3{
font-size:26px;
}

}
</style>