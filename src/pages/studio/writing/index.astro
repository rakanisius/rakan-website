---
import StudioLayout from "../../../layouts/StudioLayout.astro";
import WritingBoard from "../../../components/studio/WritingBoard.astro";
import NewArticleButton from "../../../components/studio/NewArticleButton.astro";
---

<StudioLayout title="Menulis">

  <div class="hero">

    <p class="eyebrow">
      RAKAN Studio / Menulis
    </p>

    <h1>Menulis</h1>

    <p class="lead">
      Menulis dulu. Struktur mengikuti.
    </p>

  </div>

  <div class="actions">
    <NewArticleButton />
  </div>

  <div class="board-wrap">
    <WritingBoard />
  </div>

</StudioLayout>

<style>
.actions {
  margin-bottom: 36px;
}

.board-wrap {
  width: 100%;
}

:global(.board) {
  width: 100%;
}
</style>
