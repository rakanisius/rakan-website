---
import StudioLayout from "../../../layouts/StudioLayout.astro";
---

<StudioLayout
  title="Writing"
  eyebrow="RAKAN Studio / Writing"
  description="Tulis sekali. Struktur Gaskeuun."
>

<div class="workspace">

  <section class="editor">

    <div class="toolbar">
      <button type="button" data-before="# ">H1</button>
      <button type="button" data-before="## ">H2</button>
      <button type="button" data-before="**" data-after="**">B</button>
      <button type="button" data-before="*" data-after="*">I</button>
      <button type="button" data-before="> ">+</button>
      <button type="button" data-before="- ">•</button>

      <div class="spacer"></div>

      <button type="button" id="save" class="save">💾 Simpan Draft</button>
    </div>

    <label>Judul</label>
    <input id="title" placeholder="Judul artikel..." />

    <label>Kategori</label>
    <select id="category">
      <option>Kehidupan</option>
      <option>Tubuh & Kesehatan</option>
      <option>Pikiran & Emosi</option>
      <option>Farmasi</option>
      <option>Holistik</option>
      <option>Catatan Praktisi</option>
    </select>

    <label>Markdown</label>
    <textarea id="body" placeholder="Mulai menulis..."></textarea>

  </section>

  <aside class="side">

    <section class="card">
      <h2>Metadata</h2>

      <div class="meta-row">
        <span>Slug</span>
        <strong id="slug">artikel-baru</strong>
      </div>

      <div class="meta-row">
        <span>Nama File</span>
        <strong id="filename">artikel-baru.md</strong>
      </div>

      <div class="meta-row">
        <span>Estimasi</span>
        <strong id="reading">1 menit</strong>
      </div>
    </section>

    <section class="card preview">
      <h2>Preview</h2>

      <h1 id="preview-title">Judul artikel</h1>

      <div id="badge" class="badge">Kehidupan</div>

      <div id="preview-body" class="article">
        <p>Mulai menulis untuk melihat preview.</p>
      </div>
    </section>

  </aside>

</div>

<script type="module" src="/studio/writing-editor.js"></script>

<style>
.workspace{
display:grid;
grid-template-columns:minmax(0,1fr) 320px;
gap:36px;
}

.editor{
padding:28px;
background:#F1ECE5;
border:1px solid #E5DFD5;
border-radius:24px;
display:flex;
flex-direction:column;
gap:14px;
}

.toolbar{
display:flex;
gap:8px;
flex-wrap:wrap;
align-items:center;
}

.toolbar button{
padding:9px 13px;
background:white;
border:1px solid #D8D0C5;
border-radius:10px;
cursor:pointer;
}

.spacer{flex:1;}

.save{
background:#7A2635!important;
color:white;
border-color:#7A2635!important;
}

label{
margin-top:8px;
font-size:12px;
font-weight:700;
letter-spacing:.14em;
text-transform:uppercase;
color:#756653;
}

input,
select,
textarea{
width:100%;
padding:16px;
font:inherit;
background:#F7F4EE;
border:1px solid #D8D0C5;
border-radius:14px;
}

textarea{
min-height:460px;
resize:vertical;
line-height:1.8;
}

.side{
display:flex;
flex-direction:column;
gap:22px;
}

.card{
padding:28px;
background:#F1ECE5;
border:1px solid #E5DFD5;
border-radius:24px;
}

.card h2{
margin:0 0 18px;
font-family:Georgia,serif;
font-weight:400;
}

.meta-row{
padding:14px 0;
border-bottom:1px solid #DDD3C7;
display:flex;
flex-direction:column;
gap:5px;
}

.meta-row span{
font-size:12px;
letter-spacing:.14em;
text-transform:uppercase;
color:#756653;
}

.badge{
display:inline-block;
padding:8px 14px;
border-radius:999px;
background:#E9E0D6;
margin-bottom:18px;
}

.article{
line-height:1.9;
}

.article h1,
.article h2{
font-family:Georgia,serif;
font-weight:400;
}

.article blockquote{
padding-left:18px;
border-left:3px solid #7A2635;
font-style:italic;
}

@media(max-width:960px){
.workspace{
grid-template-columns:1fr;
}
}
</style>

</StudioLayout>