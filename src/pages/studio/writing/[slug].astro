---
export const prerender = true;

import StudioLayout from "../../../layouts/StudioLayout.astro";
import { articles } from "../../../data/manifest";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

const score = [
  article.title,
  article.category,
  article.world,
  article.edition,
  article.node
].filter(Boolean).length;

const percent = Math.round((score / 5) * 100);

const filePath = `src/pages/tulisan/${article.slug}.astro`;
---

<StudioLayout title={article.title} eyebrow="RAKAN Studio / Writing" description="Preview artikel dari manifest RAKAN.">

<div class="workspace">

<article class="editorial">

<p class="eyebrow">RAKAN Studio / Writing</p>

<h1>{article.title}</h1>

<p class="lead">{article.description}</p>

<div class="meta">

<span class="badge category">{article.category}</span>

<span class="badge world">{article.world}</span>

</div>

<div class="actions">

<button onclick={`navigator.clipboard.writeText("${filePath}")`}>
Lanjut Menulis
</button>

<button onclick={`navigator.clipboard.writeText("${filePath}")`}>
Copy Path
</button>

</div>

<div class="body">

<h2>Metadata Artikel</h2>

<table class="info">
<tr><td>Judul</td><td>{article.title}</td></tr>
<tr><td>World</td><td>{article.world}</td></tr>
<tr><td>Kategori</td><td>{article.category}</td></tr>
<tr><td>Edition</td><td>{article.edition}</td></tr>
<tr><td>Node</td><td>{article.node}</td></tr>
<tr><td>Nomor</td><td>{article.number}</td></tr>
<tr><td>Slug</td><td>{article.slug}</td></tr>
</table>

<p class="note">
Preview Studio sekarang menggunakan <code>src/data/manifest.ts</code>.
Konten artikel asli berada di <code>{filePath}</code>.
</p>

</div>

</article>

<aside class="inspector">

<h3>Editorial Health</h3>

<div class="score">

<div class="ring">{percent}%</div>

<p>Kelengkapan metadata</p>

</div>

<div class="divider"></div>

<div class="item">
<span>World</span>
<strong>{article.world}</strong>
</div>

<div class="item">
<span>Kategori</span>
<strong>{article.category}</strong>
</div>

<div class="item">
<span>Edition</span>
<strong>{article.edition}</strong>
</div>

<div class="item">
<span>Node</span>
<strong>{article.node}</strong>
</div>

<div class="item">
<span>Lokasi File</span>
<strong>{filePath}</strong>
</div>

</aside>

</div>

</StudioLayout>

<style>
.workspace{
display:grid;
grid-template-columns:minmax(0,1fr) 300px;
gap:40px;
align-items:start;
}

.editorial{
max-width:760px;
}

.eyebrow{
font-size:14px;
letter-spacing:.08em;
text-transform:uppercase;
color:#6B645A;
}

.editorial h1{
margin:12px 0;
font-family:Georgia,serif;
font-size:clamp(44px,6vw,72px);
font-weight:400;
line-height:.95;
}

.lead{
margin:0 0 28px;
color:#514C45;
line-height:1.8;
}

.meta{
display:flex;
gap:10px;
margin-bottom:18px;
flex-wrap:wrap;
}

.badge{
padding:8px 14px;
border-radius:999px;
font-size:13px;
}

.category{
background:#F5F2EC;
}

.world{
background:#7A2635;
color:white;
}

.actions{
display:flex;
gap:12px;
flex-wrap:wrap;
margin-bottom:36px;
}

.actions button{
padding:12px 18px;
border:none;
border-radius:12px;
background:#F5F2EC;
cursor:pointer;
}

.actions button:first-child{
background:#7A2635;
color:white;
}

.body{
line-height:1.9;
}

.info{
width:100%;
border-collapse:collapse;
margin-top:18px;
}

.info td{
padding:12px 0;
border-bottom:1px solid #ECE5DA;
vertical-align:top;
}

.info td:first-child{
width:140px;
color:#6B645A;
}

.note{
margin-top:24px;
padding:18px;
background:#F5F2EC;
border-radius:14px;
font-size:14px;
}

.inspector{
position:sticky;
top:30px;
background:white;
border:1px solid #DED6CA;
border-radius:22px;
padding:24px;
}

.inspector h3{
margin:0 0 18px;
font-family:Georgia,serif;
font-weight:400;
font-size:28px;
}

.score{
text-align:center;
}

.ring{
width:110px;
height:110px;
margin:auto;
border-radius:50%;
border:8px solid #7A2635;
display:flex;
align-items:center;
justify-content:center;
font-family:Georgia,serif;
font-size:28px;
}

.divider{
height:1px;
background:#ECE5DA;
margin:24px 0;
}

.item{
padding:14px 0;
border-bottom:1px solid #ECE5DA;
}

.item:last-child{
border-bottom:none;
}

.item span{
display:block;
font-size:12px;
letter-spacing:.08em;
text-transform:uppercase;
color:#6B645A;
margin-bottom:6px;
}

@media(max-width:960px){
.workspace{
grid-template-columns:1fr;
}
.inspector{
position:relative;
top:auto;
}
}
</style>