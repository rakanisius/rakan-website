---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

import {
  nodes,
  editions,
  getWorldNodes,
  getArticlesByNode
} from "../data/knowledge";

const worlds = ["Tubuh","Otak","Pikiran","Kehidupan"] as const;
---

<!doctype html>
<html lang="id">
<head>

<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>Peta RAKAN | Knowledge Map</title>

<meta
name="description"
content="Peta pengetahuan RAKAN yang menghubungkan tubuh, otak, pikiran, kehidupan, Knowledge Nodes, dan Edition."
/>

<link rel="canonical" href="https://rakan.my.id/peta"/>

<meta property="og:title" content="Peta RAKAN"/>
<meta property="og:description" content="Menjelajahi hubungan antarartikel melalui Knowledge Map."/>
<meta property="og:type" content="website"/>
<meta property="og:image" content="/images/og-library.jpg"/>

<meta name="twitter:card" content="summary_large_image"/>

<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/>
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/>

</head>

<body>

<Nav/>

<main>

<section class="hero">

<div class="container narrow">

<div class="eyebrow">
KMS-001
</div>

<h1>
Peta RAKAN
<em>Setiap tulisan memiliki koordinatnya.</em>
</h1>

<p class="intro">
Perpustakaan RAKAN tidak dibangun sebagai kumpulan artikel yang berdiri sendiri.
Setiap tulisan berada di dalam satu dunia, memiliki Knowledge Node,
dan terhubung dengan perjalanan belajar yang lebih besar.
</p>

</div>

</section>

<section class="map-section">

<div class="container">

<div class="eyebrow">
EMPAT DUNIA
</div>

<h2>
Empat pintu masuk menuju perpustakaan.
</h2>

<p class="section-intro">
Klik salah satu dunia untuk melihat node pengetahuan yang membangunnya.
</p>

<div class="map-preview">

<div class="map-center">
RAKAN
</div>

<a href="#tubuh" class="map-node top-left">
Tubuh
</a>

<a href="#otak" class="map-node top-right">
Otak
</a>

<a href="#pikiran" class="map-node bottom-left">
Pikiran
</a>

<a href="#kehidupan" class="map-node bottom-right">
Kehidupan
</a>

</div>

</div>

</section>

{worlds.map((world)=>(

<section
class="world-section"
id={world.toLowerCase()}
>

<div class="container">

<div class="eyebrow">
{world.toUpperCase()}
</div>

<h2>
{world}
</h2>

<div class="node-grid">

{getWorldNodes(world).length>0 ? (

getWorldNodes(world).map((node)=>(

<div class="node-card">

<div class="node-id">
{node.id}
</div>

<h3>{node.title}</h3>

<p>{node.description}</p>

<div class="related">

<div class="related-title">
Artikel
</div>

{getArticlesByNode(node.id).map((article)=>(

<a href={article.href}>
{article.title}
</a>

))}

</div>

</div>

))

):(

<div class="empty">

<h3>Masih kosong.</h3>

<p>
Dunia ini akan berkembang seiring bertambahnya tulisan baru.
</p>

</div>

)}

</div>

</div>

</section>

))}

<section class="edition-section">

<div class="container">

<div class="eyebrow">
EDITIONS
</div>

<h2>
Perjalanan belajar yang saling terhubung.
</h2>

<div class="edition-grid">

{editions.map((edition)=>(

<div class="edition-card">

<div class="edition-id">
ED-{edition.id}
</div>

<h3>{edition.title}</h3>

<p>{edition.description}</p>

<div class="world-tags">

{edition.worlds.map((world)=>(

<span>{world}</span>

))}

</div>

</div>

))}

</div>

</div>

</section>

<section class="stats">

<div class="container">

<div class="eyebrow">
PERPUSTAKAAN SAAT INI
</div>

<h2>
Fondasi yang sedang bertumbuh.
</h2>

<div class="stats-grid">

<div class="stat">

<div class="value">
4
</div>

<div class="label">
Worlds
</div>

</div>

<div class="stat">

<div class="value">
{nodes.length}
</div>

<div class="label">
Knowledge Nodes
</div>

</div>

<div class="stat">

<div class="value">
5
</div>

<div class="label">
Articles
</div>

</div>

<div class="stat">

<div class="value">
{editions.length}
</div>

<div class="label">
Edition
</div>

</div>

</div>

</div>

</section>

<section class="cta">

<div class="container narrow">

<div class="eyebrow">
LANJUTKAN PERJALANAN
</div>

<h2>
Peta hanya menunjukkan arah.
</h2>

<p>
Perjalanan dimulai ketika satu artikel membawa Anda menuju artikel berikutnya.
</p>

<div class="actions">

<a href="/tulisan" class="button primary">
Jelajahi Tulisan
</a>

<a href="/buku" class="button secondary">
Lihat Buku
</a>

</div>

</div>

</section>

</main>

<Footer/>

</body>
</html>

<style>

:global(*){box-sizing:border-box}

:global(body){
margin:0;
background:#F7F4EE;
color:#201D19;
font-family:Arial,Helvetica,sans-serif;
}

.container{
max-width:1180px;
margin:auto;
padding:0 32px;
}

.narrow{
max-width:760px;
}

.hero,
.map-section,
.world-section,
.edition-section{
padding:90px 0;
border-bottom:1px solid #E5DFD5;
}

.stats{
padding:90px 0;
background:#F1ECE5;
}

.cta{
padding:95px 0;
background:#EBE5DC;
}

.eyebrow{
margin-bottom:22px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.16em;
text-transform:uppercase;
}

h1,h2,h3{
margin:0;
font-family:Georgia,serif;
font-weight:400;
}

h1{
font-size:clamp(48px,7vw,82px);
line-height:1.04;
letter-spacing:-.03em;
}

h1 em{
display:block;
font-style:italic;
color:#756653;
}

h2{
margin-bottom:24px;
font-size:clamp(34px,5vw,48px);
line-height:1.15;
}

h3{
margin-bottom:12px;
font-size:28px;
}

.intro,
.section-intro,
p{
color:#514C45;
font-size:17px;
line-height:1.8;
}

/* MAP */

.map-preview{
position:relative;
height:360px;
margin-top:42px;
border:1px solid #E5DFD5;
background:#F7F4EE;
overflow:hidden;
}

.map-preview::before,
.map-preview::after{
content:"";
position:absolute;
background:#D8D0C5;
}

.map-preview::before{
left:50%;
top:72px;
bottom:72px;
width:1px;
transform:translateX(-50%);
}

.map-preview::after{
top:50%;
left:72px;
right:72px;
height:1px;
transform:translateY(-50%);
}

.map-center,
.map-node{
position:absolute;
padding:12px 18px;
border:1px solid #D8D0C5;
background:#F7F4EE;
text-decoration:none;
color:#201D19;
transition:.2s;
}

.map-center{
left:50%;
top:50%;
transform:translate(-50%,-50%);
border-color:#7A2635;
font-family:Georgia,serif;
}

.map-node:hover{
border-color:#7A2635;
transform:translateY(-2px);
}

.top-left{left:60px;top:48px;}
.top-right{right:60px;top:48px;}
.bottom-left{left:60px;bottom:48px;}
.bottom-right{right:60px;bottom:48px;}

/* NODES */

.node-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:26px;
margin-top:38px;
}

.node-card{
padding:30px;
border:1px solid #E5DFD5;
background:#F7F4EE;
}

.node-id{
margin-bottom:16px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.14em;
text-transform:uppercase;
}

.related{
margin-top:26px;
padding-top:22px;
border-top:1px solid #E5DFD5;
}

.related-title{
margin-bottom:12px;
color:#756653;
font-size:11px;
font-weight:600;
letter-spacing:.14em;
text-transform:uppercase;
}

.related a{
display:block;
margin-bottom:10px;
color:#201D19;
text-decoration:none;
}

.related a:hover{
color:#7A2635;
}

.empty{
padding:30px;
border:1px dashed #D8D0C5;
}

/* EDITION */

.edition-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:26px;
margin-top:38px;
}

.edition-card{
padding:30px;
border:1px solid #E5DFD5;
background:#F7F4EE;
}

.edition-id{
margin-bottom:16px;
color:#7A2635;
font-size:11px;
font-weight:600;
letter-spacing:.14em;
text-transform:uppercase;
}

.world-tags{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:22px;
}

.world-tags span{
padding:8px 12px;
border:1px solid #D8D0C5;
font-size:11px;
text-transform:uppercase;
}

/* STATS */

.stats-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:22px;
margin-top:40px;
}

.stat{
padding:30px;
text-align:center;
border:1px solid #E5DFD5;
background:#F7F4EE;
}

.value{
margin-bottom:10px;
font-family:Georgia,serif;
font-size:48px;
color:#7A2635;
}

.label{
color:#756653;
font-size:12px;
letter-spacing:.12em;
text-transform:uppercase;
}

/* CTA */

.actions{
display:flex;
gap:14px;
flex-wrap:wrap;
margin-top:32px;
}

.button{
display:inline-block;
padding:15px 24px;
text-decoration:none;
transition:.2s;
}

.button.primary{
background:#7A2635;
color:white;
}

.button.primary:hover{
background:#201D19;
}

.button.secondary{
border:1px solid #D8D0C5;
color:#201D19;
}

.button.secondary:hover{
background:#F1ECE5;
}

@media(max-width:900px){

.container{
padding:0 20px;
}

.hero,
.map-section,
.world-section,
.edition-section,
.stats,
.cta{
padding:70px 0;
}

.node-grid,
.edition-grid,
.stats-grid{
grid-template-columns:1fr;
}

.map-preview{
height:420px;
}

.map-preview::before{
top:84px;
bottom:84px;
}

.map-preview::after{
left:48px;
right:48px;
}

.top-left{left:20px;top:30px;}
.top-right{right:20px;top:30px;}
.bottom-left{left:20px;bottom:30px;}
.bottom-right{right:20px;bottom:30px;}

}

@media(max-width:390px){

.container{
padding:0 18px;
}

.hero,
.map-section,
.world-section,
.edition-section,
.stats,
.cta{
padding:58px 0;
}

h1{
font-size:34px;
}

h2{
font-size:28px;
}

.intro,
.section-intro,
p{
font-size:15px;
}

.node-card,
.edition-card,
.stat{
padding:22px;
}

}

</style>
