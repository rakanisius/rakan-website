---import Nav from "../components/Nav.astro";import Footer from "../components/Footer.astro";const article = {title: "Judul Artikel",description:"Ringkasan singkat artikel dalam satu kalimat yang akan muncul di Google dan preview.",category: "Kehidupan",slug: "judul-artikel",date: "25 September 2026",readingTime: "6 menit",author: "Abdul Rakan",image: "/og/default.jpg",};<!doctype html><html lang="id"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="icon" href="/favicon-rakan.png"/><title>{article.title} | RAKAN</title><meta name="description" content={article.description}/><link  rel="canonical"  href={`https://rakan.my.id/tulisan/${article.slug}`}/><meta property="og:type" content="article"/><meta property="og:title" content={article.title}/><meta property="og:description" content={article.description}/><meta property="og:url" content={`https://rakan.my.id/tulisan/${article.slug}`}/><meta property="og:image" content={`https://rakan.my.id${article.image}`}/><meta property="og:site_name" content="RAKAN"/><meta property="og:locale" content="id_ID"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={article.title}/><meta name="twitter:description" content={article.description}/><meta name="twitter:image" content={`https://rakan.my.id${article.image}`}/></head><body><Nav/><main><section class="hero"><div class="container narrow"><a href="/tulisan" class="back">← Kembali ke Tulisan</a><div class="eyebrow">{article.category}</div><h1>{article.title}</h1><p class="intro">{article.description}</p><div class="meta"><span>{article.author}</span><span>•</span><span>{article.date}</span><span>•</span><span>{article.readingTime}</span></div></div></section><section class="article"><div class="container narrow"><p class="lead">Tuliskan pembuka yang mengajak pembaca masuk ke dalam percakapan.Hindari langsung memberi kesimpulan.Biarkan pembaca berjalan bersama tulisan.</p><h2>Bagian Pertama</h2><p>Isi paragraf utama di sini.Gunakan bahasa yang tenang, sederhana,dan terasa seperti sedang berbicara dengan satu orang.</p><p>Paragraf kedua tetap menjaga ritme baca yang nyaman.Jangan membuat paragraf terlalu panjang.</p><blockquote>Kalimat yang layak berhenti sejenak.</blockquote><h2>Bagian Kedua</h2><p>Lanjutkan pembahasan.Gunakan contoh bila memang membantu,bukan sekadar memperbanyak kata.</p><ul><li>poin pertama</li><li>poin kedua</li><li>poin ketiga</li></ul><h2>Penutup</h2><p>Akhiri dengan ruang berpikir,bukan sekadar slogan.Biarkan pembaca membawa pulang satu pertanyaan atau satu gagasan.</p></div></section><section class="cta"><div class="container narrow"><div class="eyebrow">LANJUTKAN PERCAKAPAN</div><h2>Masih ingin menjelajah?</h2><p>RAKAN adalah ruang yang terus bertumbuh.Jika satu tulisan terasa dekat,mungkin tulisan berikutnya juga akan menemukanmu.</p><div class="buttons"><a href="/tulisan" class="button">Lihat Tulisan Lain</a><a href="/holistik" class="button secondary">Kesehatan Holistik</a></div></div></section></main><Footer/></body></html><style>:global(*){box-sizing:border-box;}:global(html){overflow-x:hidden;}:global(body){margin:0;overflow-x:hidden;background:#F7F4EE;color:#201D19;font-family:Arial,Helvetica,sans-serif;}.container{max-width:1180px;margin:auto;padding:0 32px;}.narrow{max-width:760px;}/* HERO */.hero{padding:80px 0 60px;border-bottom:1px solid #E5DFD5;}.back{display:inline-block;margin-bottom:30px;color:#514C45;text-decoration:none;font-size:14px;transition:.2s;}.back:hover{color:#201D19;}.eyebrow{margin-bottom:18px;color:#7A2635;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;}h1,h2{margin:0;font-family:Georgia,serif;font-weight:400;}h1{font-size:clamp(42px,6vw,70px);line-height:1.05;letter-spacing:-.03em;}.intro{margin-top:28px;color:#514C45;font-size:19px;line-height:1.85;}.meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px;color:#6B655E;font-size:14px;}/* ARTICLE */.article{padding:70px 0 90px;}.article p{margin:0 0 24px;font-size:18px;line-height:1.95;color:#2A2723;}.lead{font-size:21px;color:#3A352F;}.article h2{margin:60px 0 22px;font-size:40px;line-height:1.15;}.article ul{margin:24px 0;padding-left:24px;}.article li{margin-bottom:12px;font-size:18px;line-height:1.8;}blockquote{margin:40px 0;padding-left:24px;border-left:3px solid #7A2635;font-family:Georgia,serif;font-size:28px;line-height:1.5;color:#514C45;font-style:italic;}/* CTA */.cta{padding:80px 0;background:#F1ECE5;}.cta h2{font-size:clamp(34px,5vw,48px);margin-bottom:20px;}.cta p{color:#514C45;font-size:17px;line-height:1.8;}.buttons{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px;}.button{display:inline-block;padding:14px 22px;background:#7A2635;color:white;text-decoration:none;}.button:hover{background:#201D19;}.secondary{background:transparent;color:#201D19;border:1px solid #201D19;}.secondary:hover{background:#201D19;color:white;}/* TABLET */@media(max-width:900px){.container{padding:0 20px;}.article h2{font-size:34px;}.article p,.article li{font-size:17px;}}/* iPhone 12 mini */@media(max-width:390px){.container{padding:0 18px;}.hero{padding:60px 0 48px;}h1{font-size:34px;}.intro{font-size:17px;}.article{padding:52px 0 70px;}.article p,.article li{font-size:16px;}.article h2{font-size:28px;margin:46px 0 18px;}blockquote{font-size:22px;padding-left:18px;}.buttons{flex-direction:column;}.button{width:100%;text-align:center;}}